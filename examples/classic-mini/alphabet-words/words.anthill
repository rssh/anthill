-- Words over an alphabet: every string of a fixed length over a finite
-- alphabet, and the ones with no letter repeated next to itself.
--
-- Generate-and-test again (see `map-colouring`), but the DOMAIN is a RECURSIVE
-- type. A word is a `List[Letter]`, so "ranges over all words" is "ranges over
-- all lists whose elements range over `Letter`": a one-step case split per
-- constructor, with the fields' domains as new goals. That is the inductive
-- definition of the type's inhabitants, read as a generator — and since WI-743
-- the loader derives it from the sort declarations, so a typed head is the
-- whole of it. `List` and `Letter` are two ordinary sorts; nothing here is
-- written for this program.

namespace classic.alphabet
  import anthill.cli.Main
  import anthill.prelude.Console.{console, println, ConsoleOutput}
  import anthill.prelude.Int64.{to_string}
  import anthill.prelude.List.{length, nil, cons}
  import anthill.prelude.{Int64, String, List, Bool, Error}

  sort Letter
    entity a
    entity b
    entity c
  end

  -- Every three-letter word: 27. The body binds the SPINE first — three cells —
  -- and the domain the typed head carries fills the cells. The order is not a
  -- choice: the generated domain goal goes AFTER the written body, because a
  -- generator ahead of it would enumerate every word of every length before the
  -- `<=>` could prune — still fair, but infinite, so the program would never end
  -- (measured).
  rule word(w: List[T = Letter]) :- w <=> [?, ?, ?]

  -- ...with no letter next to itself: 12.
  rule no_repeat(w: List[T = Letter]) :- w <=> [?x, ?y, ?z], ?x != ?y, ?y != ?z

  -- Every word of every length: the typed head with nothing binding the spine.
  -- An INFINITE relation — fair by length, never exhausted — so `main` does not
  -- drain it; query it with `--max-results`, or `takeN` it. Finiteness is not a
  -- condition on the domain existing; it only decides whether the stream ends.
  rule any_word(w: List[T = Letter]) :- true

  sort Program
    requires anthill.cli.Main

    -- Both relations are finite (the spine is fixed), so `takeN` drains them.
    operation main(args: List[T = String]) -> Int64
      effects {ConsoleOutput, Error}
    =
      let words = word.takeN(100)
      let _ = println(console(), to_string(length(words)))
      let distinct = no_repeat.takeN(100)
      let _ = println(console(), to_string(length(distinct)))
      0
  end
end
