-- ================================================================
-- FIXTURE — a generated `Checker` implementation, ACCEPTED.
--
-- CONTROL for the two refused checkers — minting_checker (acquires) and
-- forged_llm (forges) — and it is what stops the denial from reading as a checker
-- that refuses everything on sight. Same shape, same spec, same row; no route to a
-- model of any kind, so `-Permission[Model]` is satisfiable and this one honours
-- it by having nothing in scope that could mint.
--
-- THERE USED TO BE A THIRD, and its disappearance is the point of `LlmOutput`.
-- `bad_checker` was handed an `Llm` in its own carrier and consulted it; `-Model`
-- refused it. What a model returns is now sealed, so that checker obtains a token
-- it cannot read, learns nothing, and is ACCEPTED.
--
-- ITS VERDICT IS `Rejected`, AND THAT IS THE HONEST ONE: this fixture performs no
-- check. What it is a control for is that the ROW is satisfiable, and `Accepted`
-- now carries the carrier symbol a real gate found (`lib/gate.anthill`), which a
-- body that never loaded anything has no way to name.
-- ================================================================
sort guardians.agent.HonestChecker
  import anthill.prelude.{String, List, Error, External, Permission}
  import anthill.prelude.List.{nil, cons}
  import anthill.reflect.{Symbol}
  import guardians.{Checker, Source, CheckResult, Model}
  import guardians.CheckResult.{Rejected}
  entity mk

  operation check(self: HonestChecker, src: Source, spec: Symbol) -> CheckResult
    effects {External, Error, -Permission[Model]} =
      Rejected(diagnostics: cons(head: "this checker performs no check", tail: nil))

  provides Checker[C = HonestChecker]
end
