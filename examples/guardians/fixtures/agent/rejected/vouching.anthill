-- ================================================================
-- FIXTURE — a generated `Triage` that VOUCHES FOR ITSELF, REFUSED BY THE ROW.
--
-- THE SINGLE-CAUSE PROBE FOR `Permission[Vouch]`, and it needs to be single-cause
-- to say anything. The content it vouches for is `"routine compliance copy"` —
-- a line the organisation HAS approved (lib/vocabulary.anthill) — so
-- `Text.trusted`'s `requires approved(raw)` discharges and the only thing left
-- is the authority. `rejected/uncleared_body.anthill` breaks both tiers at once;
-- this one isolates the row half, and the trusted-position control inside
-- `an_uncleared_body_is_refused_by_the_send_precondition` isolates the proof half.
--
-- WHAT IT MEASURES IS THE TICKET'S HEADLINE. Provenance is not derived from
-- content — the same bytes are the organisation's when the organisation writes
-- them and the attacker's when the attacker does — so asserting it is an
-- AUTHORITY rather than an inference. `Triage.run`'s spec row grants no
-- `Permission[Vouch]`, so NO generated agent can mint a `Text[Trusted]`, and the
-- refusal never looks at the argument. That is why one cause kills every relabel
-- route at once and why `Address`/`MessageId` needed no change despite carrying
-- attacker-authored bytes of their own (WI-20260829-MCKTE).
--
-- BACKING IT OUT: drop `effects {Permission[Vouch]}` from `Text.trusted`
-- (lib/vocabulary.anthill) and this row alone goes green — `uncleared_body` stays
-- red on its `approved` obligation, which is the neighbour that keeps the two
-- tiers apart.
-- ================================================================
sort guardians.agent.VouchingTriage
  import anthill.prelude.{List, Error, External}
  import anthill.prelude.List.{mapElems}
  import guardians.{Triage, Email, Mailbox, Report, Address, Text, Llm, summarize, Verdict, observe}
  import guardians.TrustLevel.{Trusted}
  entity mk

  operation run(self: VouchingTriage, box: Mailbox, llm: Llm,
                wording: Text[Trusted]) -> Report
    ensures mentions_all(result, box)
    effects {External, llm.E, Error} =
      let msgs = Email.fetch(box)
      let sent = Email.send(to:   Address(local: "boss", domain: "ourcorp.com"),
                            body: Text.trusted(raw: "routine compliance copy"))
      Report(items:   mapElems[EffP = {llm.E, Error}](msgs,
                        lambda m -> Verdict(message:    m.id,
                                            evidence:   mapElems(observe(llm, m), lambda o -> o.feature))),
             summary: summarize(llm, wording, msgs.map(lambda m -> m.body).collect()))

  provides Triage[C = VouchingTriage]
end
