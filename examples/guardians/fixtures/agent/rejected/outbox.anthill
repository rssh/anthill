-- ================================================================
-- FIXTURE — a generated `Triage` implementation, REFUSED BY THE CONDITIONAL
-- `Permission[Outbox]`.
--
-- THE ARTICLE'S POLICY, TARGET HALF, AS A LOAD-TIME REFUSAL. The policy reads
-- "forbid data flow from fetch_email's result to the body parameter of
-- send_email WITH AN EXTERNAL EMAIL ADDRESS AS THE TARGET". `leak.anthill`
-- catches the FLOW half with the `Text[Trust]` label. This one isolates the
-- TARGET half: the body it mails is a literal `Public` string, so no label is
-- violated and nothing flows from the mailbox into the message at all — and it
-- is still refused, because the recipient is outside the organisation.
--
-- What refuses it is that `Email.send` demands `Permission[Outbox]` GUARDED on
-- its recipient (email.anthill), and `Triage.run`'s spec row grants none.
-- The implementation can neither perform it (an undeclared effect, which is what
-- fires here) nor declare it (a widening against the spec). So no generated
-- triage can mail outside, and that is a property of the SPEC rather than of
-- this agent.
--
-- Its control is ../internal_send.anthill, one token away.
-- ================================================================
sort guardians.agent.OutboxTriage
  import anthill.prelude.{List, Error, External}
  import guardians.{Triage, Email, Mailbox, Report, Address, Text, Llm, summarize,
                    Verdict, categories_of}
  import guardians.TrustLevel.{Public}
  entity mk

  operation run(self: OutboxTriage, box: Mailbox, llm: Llm) -> Report
    ensures mentions_all(result)
    effects {External, llm.E, Error} =
      let msgs = Email.fetch(box)
      let sent = Email.send(to:   Address(local: "it", domain: "othercorp.com"),
                            body: text(raw: "routine compliance copy"))
      Report(items:   msgs.map(lambda m -> Verdict(message: m.id,
                                          labels:  categories_of(m.id))).collect(),
             summary: summarize(llm, msgs.map(lambda m -> m.body).collect()))

  provides Triage[C = OutboxTriage]
end
