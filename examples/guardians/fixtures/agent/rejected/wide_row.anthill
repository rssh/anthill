-- ================================================================
-- FIXTURE — a generated `Triage` implementation, REFUSED BY THE DECLARED ROW.
--
-- Leaks nothing. Identical to ../good.anthill except for `Filesystem` in the
-- effect row — one token — so a refusal here measures the row and nothing else.
-- Keeping it separate from leak.anthill is what shows the two chains are
-- INDEPENDENT: neither test would catch the other's program.
-- ================================================================
sort guardians.agent.WideRowTriage
  import anthill.prelude.{List, Error, External}
  import guardians.{Triage, Email, Mailbox, Report, Filesystem, Llm, summarize,
                    Verdict, categories_of}
  entity mk

  operation run(self: WideRowTriage, box: Mailbox, llm: Llm) -> Report
    ensures mentions_all(result)
    effects {External, Filesystem, Error} =
      let msgs = Email.fetch(box)
      Report(items:   msgs.map(lambda m -> Verdict(message: m.id,
                                          labels:  categories_of(m.id))).collect(),
             summary: summarize(llm, msgs.map(lambda m -> m.body).collect()))

  provides Triage[C = WideRowTriage]
end
