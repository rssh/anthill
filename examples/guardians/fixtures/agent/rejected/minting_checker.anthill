-- ================================================================
-- FIXTURE — a generated `Checker` implementation, REFUSED BY `-Permission[Model]`.
--
-- ACQUISITION, WHICH IS THE ONE ROUTE TO A MODEL STILL WORTH DENYING. This
-- checker holds no `Llm` and takes none as a parameter — the carrier is bare `mk`,
-- so every audit of "what was this checker handed" comes back empty — and simply
-- MINTS one.
--
-- ITS FORMER TWIN IS GONE. `bad_checker` smuggled an `Llm` into its own carrier
-- and CONSULTED it, and `-Model` refused it. Consulting is now harmless: what
-- `complete` returns is a sealed `LlmOutput`, unreadable by generated code, so a
-- checker that calls a model learns nothing from it and cannot be steered by it.
-- Minting is not consulting, and only minting is still refused — by `Llm.open`'s
-- `Permission[Model]` reaching a row that DENIES it (proposal 064).
--
-- The refusal is on the BODY leg — the declared row is the spec's, verbatim — so
-- it is independent of wide_row.anthill's declared-row leg.
-- ================================================================
sort guardians.agent.MintingChecker
  import anthill.prelude.{String, List, Error, External, Permission}
  import anthill.prelude.List.{nil, cons}
  import anthill.reflect.{Symbol}
  import guardians.{Checker, Source, CheckResult, Model, FakeLlm}
  import guardians.CheckResult.{Rejected}
  entity mk

  operation check(self: MintingChecker, src: Source, spec: Symbol) -> CheckResult
    effects {External, Error, -Permission[Model]} =
      let llm = FakeLlm.open("advice")
      Rejected(diagnostics: cons(head: "minted my own oracle", tail: nil))

  provides Checker[C = MintingChecker]
end
