-- ================================================================
-- FIXTURE — a generated `Triage` implementation, REFUSED BY THREE TIERS IN ONE
-- LOAD.
--
-- THE TIERS ARE INDEPENDENT, AND THIS IS WHERE THAT IS MEASURED. Since
-- WI-20260829-MCKTE they no longer sit on one operation. `Email.send` carries the
-- row tier, `Permission[Outbox]` guarded on the recipient. `Text.trusted`
-- (lib/vocabulary.anthill) carries the other two: `Permission[Vouch]`, deciding WHO
-- may vouch, and `requires approved(raw)`, proved from the KB and deciding WHAT was
-- vouched for. `rejected/outbox.anthill` breaks the row tier alone — an external
-- recipient, mailing the `Text[Trusted]` the task handed it rather than minting one.
-- This file breaks all three at once: an external recipient AND a body it vouches
-- for itself AND content nobody approved, and every refusal must appear in ONE load.
--
-- NO CANDIDATE BREAKS THE PROOF TIER ALONE any more — minting at all breaks the
-- row — so that single-tier control is not a fixture but a TRUSTED-position source
-- inside `an_uncleared_body_is_refused_by_the_send_precondition`, which declares
-- `Permission[Vouch]` and vouches for an unapproved line.
--
-- WHY IT IS A FIXTURE AND NOT A FOOTNOTE. Until WI-20260830-JM7A8 they did not
-- all arrive. An unsatisfied precondition aborted the call's typing before its
-- effect row was built, so the effect was never attributed and the
-- `Permission[Outbox]` line simply vanished — leaving one diagnostic that read as
-- the complete account of what was wrong with the program. A reader who repaired
-- the body would then be told about the recipient, one load later. measured.md C2a
-- is the measurement that found the suppression; this file is what keeps it from
-- coming back, and it now guards a precondition and a row on the SAME call
-- (`Text.trusted`) as well as across two.
-- ================================================================
sort guardians.agent.UnclearedExternalTriage
  import anthill.prelude.{List, Error, External}
  import anthill.prelude.List.{mapElems}
  import guardians.{Triage, Email, Mailbox, Report, Address, Text, Llm, summarize, Verdict, observe}
  import guardians.TrustLevel.{Trusted}
  entity mk

  operation run(self: UnclearedExternalTriage, box: Mailbox, llm: Llm,
                wording: Text[Trusted]) -> Report
    ensures mentions_all(result, box)
    effects {External, llm.E, Error} =
      let msgs = Email.fetch(box)
      let sent = Email.send(to:   Address(local: "it", domain: "othercorp.com"),
                            body: Text.trusted(raw: "here is the mailbox summary"))
      Report(items:   mapElems[EffP = {llm.E, Error}](msgs,
                        lambda m -> Verdict(message:    m.id,
                                            evidence:   mapElems(observe(llm, m), lambda o -> o.feature))),
             summary: summarize(llm, wording, msgs.map(lambda m -> m.body).collect()))

  provides Triage[C = UnclearedExternalTriage]
end
