-- ================================================================
-- FIXTURE — a generated `Triage` implementation, ACCEPTED.
--
-- THE CONTROL FOR rejected/outbox.anthill, and one token away from it: the same
-- program, mailing `boss@ourcorp.com` instead of `it@othercorp.com`.
--
-- It is the reason the refusal over there measures the RECIPIENT rather than
-- mailing at all. `Email.send`'s `Permission[Outbox]` is GUARDED on its target,
-- so at this call the guard's negation is constructively proved — the address is
-- in the organisation — and the label is dropped. The row `{External, Error}`
-- therefore suffices, unchanged from ./good.anthill, and no authority is
-- demanded for mailing a colleague.
--
-- Without this file, "no generated agent may send mail" would satisfy every
-- refusal in the suite, and that is a far weaker and far less useful policy than
-- the one the article states.
-- ================================================================
sort guardians.agent.InternalSendTriage
  import anthill.prelude.{List, Error, External}
  import anthill.prelude.List.{mapElems}
  import guardians.{Triage, Email, Mailbox, Report, Address, Text, Llm, summarize, Verdict, observe}
  import guardians.TrustLevel.{Trusted}
  entity mk

  operation run(self: InternalSendTriage, box: Mailbox, llm: Llm,
                wording: Text[Trusted]) -> Report
    ensures mentions_all(result, box)
    effects {External, llm.E, Error} =
      let msgs = Email.fetch(box)
      let sent = Email.send(to:   Address(local: "boss", domain: "ourcorp.com"),
                            body: wording)
      Report(items:   mapElems[EffP = {llm.E, Error}](msgs,
                        lambda m -> Verdict(message:    m.id,
                                            evidence:   mapElems(observe(llm, m), lambda o -> o.feature))),
             summary: summarize(llm, wording, msgs.map(lambda m -> m.body).collect()))

  provides Triage[C = InternalSendTriage]
end
