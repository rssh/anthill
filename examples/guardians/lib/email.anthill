-- ================================================================
-- guardians.email — the email service, and every email-shaped declaration.
--
-- Mail is one service with one source and one sink, and the interesting property
-- is a relationship between them: the article's policy forbids a flow from the
-- source's result to the sink's `body` when the target is outside the
-- organisation.
-- ================================================================

{< One email as `Email.fetch` returns it. `Trust` is the label its text carries:
   everything a mailbox hands back is `Message[Untrusted]`, and the parameter is
   what carries that fact into every signature the message reaches. >}
enum guardians.Message
  import guardians.{Text, Address, MessageId}
  sort Trust = ?
  entity message(
    id       : MessageId,
    from     : Address,
    reply_to : Address,
    subject  : Text[Trust],
    body     : Text[Trust])
end

-- The authority to mail OUTSIDE the organisation. A capability, not an effect
-- kind — it is only ever the argument of `Permission[…]`. What makes it worth
-- having is that the permission is CONDITIONAL (proposal 048's guarded effects on
-- 064's label): the article's policy names an external target, and a target is a
-- property of one argument at one call, which is exactly what a guard reads.
sort guardians.Outbox
end

namespace guardians
  import anthill.prelude.{String}
  import guardians.{Text}

  entity MessageId(value: String)
  entity Address(local: String, domain: String)
  entity Mailbox(owner: Address)

  -- WHICH ADDRESSES ARE OURS — declared here, asserted nowhere in `lib/`: the
  -- relation is the library's, the rows a deployment's (fixtures/mailbox.anthill).
  -- A bodyless `rule` is proposal 061's DECLARATION, so with no deployment loaded
  -- every address is external — the safe default.
  rule in_org(?a)
  rule external_addr(?a) :- not(in_org(?a))

  -- WHAT AN AGENT MAY PUT IN AN OUTGOING BODY. `Text[Public]` says the body
  -- carries no label that forbids release; it does not say the organisation
  -- meant to send it. This does, and it is a different KIND of statement: the
  -- label is about PROVENANCE and is decided by the typer, this is about
  -- CONTENT and is proved from the KB. lib/observe.anthill closes what the
  -- model may say on the way in; this closes what an agent may say on the way
  -- out, and the two are the same instinct at opposite ends.
  --
  -- IT IS A RELATION, NOT AN ENUM, and the difference is deliberate: an
  -- outgoing body is `Text`, so the closed set is a set of VALUES a deployment
  -- can extend, not a sort a deployment would have to recompile against.
  --
  -- LIBRARY, NOT DEPLOYMENT, and the placement is load-bearing rather than
  -- tidy: `Email.send`'s precondition must be dischargeable with `lib/` alone,
  -- or `the_organisations_identity_is_a_deployment_fact_and_the_default_is_closed`
  -- — which loads the library WITHOUT any deployment — would fail on the
  -- precondition instead of on the missing authority, and stop measuring the
  -- closed default it exists for.
  rule releasable(?t)
  fact releasable(text(raw: "routine compliance copy"))
end

sort guardians.Email
  import anthill.prelude.{List, Unit, Error, External, Permission}
  import guardians.{Text, Message, MessageId, Address, Mailbox, Outbox,
                    external_addr, releasable}
  import guardians.TrustLevel.{Untrusted, Public}

  operation fetch(box: Mailbox) -> List[Message[Untrusted]]
    effects {External, Error}

  -- THE SINK, GATED ON ITS TARGET. `Permission[Outbox]` is demanded only when the
  -- recipient is outside the organisation: the argument is substituted into the
  -- guard, and the label drops when the guard's negation is constructively proved
  -- (§5.5).
  --
  --   Email.send(to: Address(local: "boss",  domain: "ourcorp.com"),   …)  nothing
  --   Email.send(to: Address(local: "it", domain: "othercorp.com"), …)  Permission[Outbox]
  --   Email.send(to: <anything not written inline>, …)                  Permission[Outbox]
  --
  -- THE CONSEQUENCE: `Triage.run`'s spec row grants no `Permission[Outbox]`, so no
  -- generated triage can mail outside the organisation — a property of the SPEC.
  --
  -- BOTH TIERS OF ONE POLICY, SIDE BY SIDE. The row states what AUTHORITY the
  -- call consumes and is decided by the typer; `requires` states an OBLIGATION
  -- the caller must discharge and is proved from the KB at the call site
  -- (§5.4). They fail differently and catch different programs — the row
  -- catches `it@othercorp.com` (rejected/outbox.anthill), the precondition
  -- catches a body the organisation never cleared (rejected/uncleared_body.anthill).
  --
  -- WHY THE PRECONDITION IS ON `body` AND NOT ON `to`, which is where the
  -- obvious `deliverable(to)` would put it. MEASURED: a precondition naming
  -- `to` is unprovable at exactly the two call sites whose recipient the
  -- checker cannot read — rejected/computed_recipient.anthill and
  -- rejected/letbound_recipient.anthill — and its diagnostic PREEMPTS the
  -- effect check there, so both fixtures stop reporting the missing
  -- `Permission[Outbox]` and stop measuring the conditional permission they
  -- exist for. A value precondition and a value-guarded effect over the SAME
  -- argument collide; over different arguments they compose. The preemption is
  -- itself a defect — WI-20260830-JM7A8, measured.md C2a — but the argument
  -- choice here is right either way: a precondition on `to` would duplicate what
  -- the guard already decides.
  {< Send one message. Demands `Permission[Outbox]` only when the recipient is
     outside the organisation, and only ever carries a body the organisation has
     cleared for release. >}
  operation send(to: Address, body: Text[Public]) -> Unit
    requires releasable(body)
    effects {External, Error, (Permission[Outbox] :- external_addr(to))}
end
