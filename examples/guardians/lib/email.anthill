-- ================================================================
-- guardians.email — the email service, and every email-shaped declaration.
--
-- Mail is one service with one source and one sink, and the interesting property
-- is a relationship between them: the article's policy forbids a flow from the
-- source's result to the sink's `body` when the target is outside the
-- organisation.
-- ================================================================

{< One email as `Email.fetch` returns it. `Trust` is the label its text carries:
   everything a mailbox hands back is `Message[Untrusted]`, and the parameter is
   what carries that fact into every signature the message reaches. >}
enum guardians.Message
  import guardians.{Text, Address, MessageId}
  sort Trust = ?
  entity message(
    id       : MessageId,
    from     : Address,
    reply_to : Address,
    subject  : Text[Trust],
    body     : Text[Trust])
end

-- The authority to mail OUTSIDE the organisation. A capability, not an effect
-- kind — it is only ever the argument of `Permission[…]`. What makes it worth
-- having is that the permission is CONDITIONAL (proposal 048's guarded effects on
-- 064's label): the article's policy names an external target, and a target is a
-- property of one argument at one call, which is exactly what a guard reads.
sort guardians.Outbox
end

namespace guardians
  import anthill.prelude.{String}

  entity MessageId(value: String)
  entity Address(local: String, domain: String)
  entity Mailbox(owner: Address)

  -- A bodyless `rule` is proposal 061's DECLARATION; the rows are a deployment's
  -- (fixtures/mailbox.anthill). The block below is the one a body-less declaration
  -- could not carry until WI-20260830-VFAKK — measured.md C12.
  {< Which addresses are the organisation's own. The library DECLARES this relation
     and asserts no row of it: the rows belong to a deployment. With none loaded the
     relation is empty, so every address is external — the safe default, and the one
     `Email.send` reads to decide whether it needs `Permission[Outbox]`. >}
  rule in_org(?a)
  rule external_addr(?a) :- not(in_org(?a))
end

sort guardians.Email
  import anthill.prelude.{List, Unit, Error, External, Permission}
  import guardians.{Text, Message, MessageId, Address, Mailbox, Outbox,
                    external_addr}
  import guardians.TrustLevel.{Untrusted, Trusted}

  operation fetch(box: Mailbox) -> List[Message[Untrusted]]
    effects {External, Error}

  -- THE SINK, GATED ON ITS TARGET. `Permission[Outbox]` is demanded only when the
  -- recipient is outside the organisation: the argument is substituted into the
  -- guard, and the label drops when the guard's negation is constructively proved
  -- (§5.5).
  --
  --   Email.send(to: Address(local: "boss",  domain: "ourcorp.com"),   …)  nothing
  --   Email.send(to: Address(local: "it", domain: "othercorp.com"), …)  Permission[Outbox]
  --   Email.send(to: <anything not written inline>, …)                  Permission[Outbox]
  --
  -- THE CONSEQUENCE: `Triage.run`'s spec row grants no `Permission[Outbox]`, so no
  -- generated triage can mail outside the organisation — a property of the SPEC.
  --
  -- NO PRECONDITION HERE, AND THAT IS THE TICKET'S DOING (WI-20260829-MCKTE).
  -- This operation used to carry `requires releasable(body)` beside the row —
  -- the two contract tiers side by side, one deciding AUTHORITY and one an
  -- OBLIGATION (§5.4). Both tiers survive; they moved to `Text.trusted`, where
  -- the content is a literal and the obligation can actually be discharged. A
  -- body merely LET-BOUND to the cleared line already failed it here — measured —
  -- so the precondition could not survive trusted text being handed to an agent
  -- instead of minted by it.
  --
  -- WHAT `body: Text[Trusted]` NOW CARRIES is the result of both: one cannot exist
  -- unless someone holding `Permission[Vouch]` vouched for content the organisation
  -- had approved. So the sink states one thing and states it
  -- once, and `rejected/uncleared_body.anthill` is refused where the vouching
  -- happens rather than where the mail is sent.
  --
  -- THAT SENTENCE WAS BRIEFLY FALSE, and the exception is worth recording because
  -- the OLD design caught what the new one nearly did not. A label-polymorphic
  -- `join_texts` preserves nothing at `nil`, so `join_texts(nil)` was a
  -- `Text[Trusted]` obtained with neither tier — and `requires releasable(body)`
  -- HERE used to refuse it, while the mint is never reached. Narrowing `join_texts`
  -- to `Untrusted` (lib/llm.anthill) closed it; rejected/empty_join.anthill is the
  -- regression guard, and restoring the polymorphic signature reds it.
  --
  -- THE TWO-TIER READING IS NOT LOST, only relocated: measured.md C2a's property
  -- — that a precondition must not PREEMPT the effect check at one call — is now
  -- measured at the mint, where an unapproved body reports the obligation AND the
  -- missing `Permission[Vouch]` in one load, and `uncleared_external` reports
  -- those two plus `Permission[Outbox]`. WI-20260830-JM7A8 is what keeps them
  -- arriving together.
  {< Send one message. Demands `Permission[Outbox]` only when the recipient is
     outside the organisation. The body is a `Text[Trusted]`, which cannot exist
     unless the organisation vouched for its content — both who vouched
     (`Permission[Vouch]`) and what was vouched for (`approved`). >}
  operation send(to: Address, body: Text[Trusted]) -> Unit
    effects {External, Error, (Permission[Outbox] :- external_addr(to))}
end
