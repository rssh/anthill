-- ================================================================
-- guardians.safety — the typer's verdict, as a queryable row.
--
-- A deployment loads a fleet of generated agents, each checked at load against
-- the spec it claims to implement. Later — at deploy, during an audit — someone
-- asks: which agents here were checked against `guardians.Triage`? Is every
-- deployed one checked? Those are queries, and they need a row: a `ProofWitness`
-- is opaque, so you can verify one you hold but cannot join over all of them.
--
-- NOT YET EMITTED — the override-refinement pass knows the answer on every load
-- and discards the positive case. And it is the row a malicious agent would most
-- like to write about itself, which `gate.anthill` G2 refuses.
-- ================================================================
namespace guardians
  import anthill.prelude.{String}

  -- `carrier` implements `spec`, per the TYPE CHECKER — not `guardians.Checker`,
  -- which is the harness's gate over source text.
  entity TypeChecked(carrier: String, spec: String)
end
