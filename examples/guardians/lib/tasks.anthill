-- ================================================================
-- guardians.tasks — the task operations, DERIVED from the one primitive.
--
-- `summarize` is not a host function: it builds a prompt and completes it in
-- anthill, so the prompt text is in the repository rather than in a Rust closure,
-- and the label arithmetic is visible — a Trusted instruction joined with
-- Untrusted content is an Untrusted prompt, nothing special-cased.
-- ================================================================
namespace guardians
  import anthill.prelude.{List, Error, External}
  import guardians.{Text, Prompt, Llm, Message, Observed,
                    prompt_with, join_texts}
  import guardians.TrustLevel.{Untrusted, Trusted}

  -- The quarantined summarizer: trusted instruction, untrusted content, and the
  -- join decides. MONOMORPHIC AT `Untrusted` because `complete` returns
  -- `Text[Untrusted]` for every prompt, so `-> Text[?t]` is refused (measured:
  -- docs/design/measured.md C10). The input could be widened to `Text[?t]` and is
  -- not — llm.anthill's rule: write no variable where no relationship exists.
  -- ROW-POLYMORPHIC IN THE MODEL. An operation that takes ANY `Llm` has no
  -- business asserting `External`: it performs whatever the carrier it is handed
  -- performs. `llm.E` projects that off the parameter — the `Stream` shape
  -- (`s.E`) — so `summarize` over `FakeLlm` is `{Error}` and over `LiveLlm` is
  -- `{External, Error}`, and only the latter is barred from a `Branch` region.
  -- THE INSTRUCTION IS A PARAMETER, AND IT HAS TO BE. Minting it here made
  -- `summarize` carry `Permission[Vouch]`, and an effect row propagates: every
  -- caller needed the authority to vouch, including `good.anthill`, which sends
  -- nothing and mints nothing — measured. Granting it to `Triage.run` to make that
  -- load would have handed every candidate the power to mint `Text[Trusted]`
  -- directly, voiding the seal. So the mint happens ONCE, above the agent, and
  -- what reaches the agent is the result (WI-20260829-MCKTE).
  operation summarize(llm: Llm, instruction: Text[Trusted],
                      msgs: List[T = Text[Untrusted]])
      -> Text[Untrusted]
    effects {llm.E, Error} =
      let content = join_texts(msgs)
      let p = prompt_with(instruction: instruction, content: content)
      llm.complete(p)

  -- Still host-bound: its job is to PARSE the reply into the closed `Feature`
  -- vocabulary, refusing anything outside it at the boundary. Doing that in
  -- anthill needs string machinery this example lacks, so the check lives in the
  -- host binding — the largest remaining fiction here.
  operation observe(llm: Llm, m: Message[Untrusted])
      -> List[T = Observed]
    effects {llm.E, Error}
end
