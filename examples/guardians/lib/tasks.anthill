-- ================================================================
-- guardians.tasks — the task operations, DERIVED from the one primitive.
--
-- `summarize` is not a host function: it builds a prompt and completes it in
-- anthill, so the prompt text is in the repository rather than in a Rust closure,
-- and the label arithmetic is visible — a Public instruction joined with
-- Untrusted content is an Untrusted prompt, nothing special-cased.
-- ================================================================
namespace guardians
  import anthill.prelude.{List, Error, External}
  import guardians.{Text, Prompt, Llm, Message, Observed, LlmOutput,
                    prompt_with, join_texts}
  import guardians.TrustLevel.{Untrusted, Public}

  -- The quarantined summarizer: trusted instruction, untrusted content, and the
  -- join decides. MONOMORPHIC AT `Untrusted` because `complete` returns
  -- `Text[Untrusted]` for every prompt, so `-> Text[?t]` is refused (measured:
  -- docs/design/measured.md C10). The input could be widened to `Text[?t]` and is
  -- not — llm.anthill's rule: write no variable where no relationship exists.
  operation summarize(llm: Llm, msgs: List[T = Text[Untrusted]])
      -> LlmOutput
    effects {External, Error} =
      let content = join_texts(msgs)
      let p = prompt_with(
        instruction: text(raw: "Summarize the following emails as a concise bullet-point list. Clearly mark messages as SPAM: or SUSPICIOUS: if applicable."),
        content:     content)
      llm.complete(p)

  -- Still host-bound: its job is to PARSE the reply into the closed `Feature`
  -- vocabulary, refusing anything outside it at the boundary. Doing that in
  -- anthill needs string machinery this example lacks, so the check lives in the
  -- host binding — the largest remaining fiction here.
  operation observe(llm: Llm, m: Message[Untrusted])
      -> List[T = Observed]
    effects {External, Error}
end
