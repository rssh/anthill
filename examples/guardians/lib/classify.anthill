-- ================================================================
-- guardians.classify — WHAT COUNTS AS SUSPICIOUS.
--
-- Rules in the KB, not a prompt: versioned, queryable, testable. The model
-- never emits a verdict; it emits `Observed` atoms and the verdict is DERIVED.
--
-- LIBRARY / FIXTURE BOUNDARY. Everything here is solution. This file asserts
-- NO fact about any particular message, and `lib/` loads standalone with no
-- fixture present — enforced by `lib_loads_without_any_fixture`. The two
-- relations below are DECLARED here (so the rules that read them resolve) and
-- POPULATED by whoever supplies data: a deployment from a real mailbox and
-- address book, `fixtures/` from the article's inbox. An earlier draft had
-- this backwards — the corroborators were asserted as ground facts in the
-- fixture, which meant deleting the test data stopped the library loading.
-- ================================================================
namespace guardians
  import anthill.prelude.{String, Bool}
  -- WI-20260825-KD9SW: WRITTEN bare spec-operation names are imported now. A minted
  -- operator (`+`, `<`, …) names its target outright and needs nothing; these call
  -- the same operations by NAME, and the implicit tier that answered them is gone.
  import anthill.prelude.PartialEq.{eq}
  import guardians.{MessageId, Message, Address, Mailbox, Observed, Span, Feature,
                    Category}
  import guardians.Feature.{ForwardingInstruction, SecrecyInstruction,
                            CredentialRequest, PaymentRedirect,
                            UrgencyAppeal, InvestmentPitch, MeetingInvite}
  import guardians.Category.{Suspicious, Ordinary, Other}
  import guardians.TrustLevel.{Untrusted}

  -- ---- the two inputs a deployment supplies ----

  -- What the mailbox holds. In a deployment this is what `Email.fetch` returned.
  entity InMailbox(box: Mailbox, message: Message[Untrusted])

  -- The owner's address book.
  entity KnownContact(address: Address)

  -- ---- what the library derives from them ----

  rule fetched_message(?id)
    :- InMailbox(box: ?,
                 message: message(id: ?id, from: ?, reply_to: ?,
                                  subject: ?, body: ?))

  -- Which features are manipulative. A judgement, but a DECLARED one — written
  -- once, reviewable, and not restated in every prompt.
  fact manipulative(ForwardingInstruction)
  fact manipulative(SecrecyInstruction)
  fact manipulative(CredentialRequest)
  fact manipulative(PaymentRedirect)

  -- A verdict NEVER rests on the model alone. Each corroborator is COMPUTED
  -- from the message with no model in the loop, so an observation that is wrong
  -- or injected cannot carry a verdict by itself.
  rule sender_not_in_contacts(?id)
    :- InMailbox(box: ?,
                 message: message(id: ?id, from: ?a, reply_to: ?,
                                  subject: ?, body: ?)),
       not(KnownContact(address: ?a))

  rule reply_to_differs_from_from(?id)
    :- InMailbox(box: ?,
                 message: message(id: ?id, from: ?a, reply_to: ?r,
                                  subject: ?, body: ?)),
       not(eq(?a, ?r))

  rule corroborated(?m) :- sender_not_in_contacts(?m)
  rule corroborated(?m) :- reply_to_differs_from_from(?m)

  -- THE CLASSIFICATION. Model atom AND declared judgement AND a computed
  -- corroborator — three independent conditions for one verdict.
  --
  -- THE SECOND ARGUMENT IS A `Category`, NOT A STRING (lib/spec.anthill). As
  -- string literals these three clauses agreed by spelling: a fourth written
  -- `"suspicious"` would have loaded clean and derived a category nothing reads.
  rule classified(?m, Suspicious)
    :- observed_feature(?m, ?f), manipulative(?f), corroborated(?m)

  -- `Ordinary` NOW NEEDS AN OBSERVATION AS WELL, and the ADDITION is the point.
  -- It used to read `fetched_message(?m), not(suspicious(?m))`, which called a
  -- message the model never looked at ORDINARY — an all-clear derived from
  -- silence. The third clause below is where those messages go instead.
  --
  -- `fetched_message` STAYS, and dropping it was a real defect for the length of
  -- one review. `observed_message` is fed by `Observed` alone — the model's own
  -- writable vocabulary — so an `Ordinary` clause anchored on it and nothing else
  -- lets a model mint a full all-clear for a message that is not in the mailbox
  -- at all, by observing an id it invented. Measured: with the anchor gone, an
  -- `Observed` atom on `m99` produced `classified(m99, Ordinary)` beside the five
  -- real rows. That is exactly what this file's header forbids — a verdict never
  -- rests on the model alone — and it is the ONE clause where losing the anchor
  -- is dangerous, since `Suspicious` reaches `InMailbox` through `corroborated`
  -- and `Other` names `fetched_message` outright.
  rule classified(?m, Ordinary)
    :- fetched_message(?m), observed_message(?m), not(suspicious(?m))

  -- CANNOT CATEGORIZE, SAID OUT LOUD. Fetched, and no observation to judge it
  -- by. Together the three clauses are TOTAL over `fetched_message`, which is
  -- what `verdict_is_not_silent` (lib/spec.anthill) demands of the report: a
  -- message the model declined to look at still gets a row, and the row says so.
  rule classified(?m, Other)
    :- fetched_message(?m), not(observed_message(?m))

  rule suspicious(?m) :- classified(?m, Suspicious)

  rule observed_message(?m) :- observed_feature(?m, ?)

  -- Bridge from the model's span-anchored atom to the feature alone. Kept
  -- separate so the span can be checked independently of the verdict.
  rule observed_feature(?m, ?f)
    :- Observed(at: Span(message: ?m, start: ?, end: ?, quote: ?), feature: ?f)
end
