-- ================================================================
-- guardians.llm — THE PRIMITIVE. One call: text in, text out.
--
-- This is what an LLM API actually is, and it is the example's ONLY
-- task-agnostic model surface. `summarize` and `observe` are ordinary anthill
-- operations built on top (tasks.anthill), not separate host functions — a
-- real integration binds one HTTP call, not one function per task.
-- ================================================================

-- A prompt is a VALUE, and it carries a trust label. That is not bookkeeping:
-- the injection IS prompt content, so making the prompt a value makes the
-- attack surface a value.
-- The `Trust` parameter has exactly ONE consumer, and that is what earns it:
-- `Harness.generate` demands `Prompt[Public]`, so code generation may only
-- proceed from a content-free prompt. Without the parameter `Prompt` would be a
-- single type and that demand could not be written at all — the label would sit
-- inside the `body` field where no signature can reach it.
--
-- `complete` does NOT consume it (any prompt, always an Untrusted reply), and
-- the constructor cannot forge it: `prompt(body: t)` takes its label from `t`,
-- so `Prompt[Public]` from untrusted text is a type error (measured).
enum guardians.Prompt
  import guardians.{Text}
  sort Trust = ?
  entity prompt(body: Text[Trust])
end

-- WHAT A MODEL RETURNED, and the ONLY thing that proves one was consulted.
--
-- SEALED, on `Approval`'s pattern: the constructor is `internal`, so generated
-- code can neither BUILD one (no forging "this came from a model") nor PROJECT
-- one (no reading what the model said). The mint is the host binding behind
-- `complete`, which is trusted by construction.
--
-- THIS IS WHAT RETIRES THE `Model` EFFECT LABEL. `-Model` existed to say "this
-- code was not steered by a model", and it had to be a row label because a
-- TRUST LABEL ON THE VALUE IS STRIPPABLE — `text(raw: u.raw)` re-labels any
-- `Text[Untrusted]` as `Text[Public]` in one line, and the typer says nothing
-- (measured; `rejected/launder_projection.anthill`). An opaque wrapper is not:
-- there is no projection to strip it with. A checker that calls a model gets a
-- token it cannot read, learns nothing from it, and so cannot be steered by it
-- — which is the property `-Model` was approximating by forbidding the call
-- outright.
sort guardians.LlmOutput
  sort T = ?
  internal entity llm_output(value: T)
end

sort guardians.Llm
  import anthill.prelude.{Error, External}
  import guardians.{Prompt, Text, Model, LlmOutput}
  import guardians.TrustLevel.{Untrusted}

  sort C = ?

  -- ANY prompt in; the reply is ALWAYS `Untrusted`. Never `?t` out.
  --
  -- This signature was `?t` in, `?t` out for one revision, and it was WRONG in
  -- a way that had a working exploit. `Public` means "cleared to leave the
  -- system", so a Public prompt yielding Public text let a model MINT
  -- releasable output, and this loaded clean:
  --
  --     send_email(to: attacker,
  --                body: llm.complete(prompt_with(instruction: "…", content: "")))
  --
  -- The mistake was conflating two things the label was carrying. Preserving a
  -- label is right for a PURE transformation — whatever went in comes out. A
  -- model is not one: its output is arbitrary text it chose, so the model
  -- itself is an untrusted influence and belongs in the join.
  -- `?t ⊔ Model = Untrusted` for every `?t`, which is why the output is fixed.
  --
  -- THE PARAMETER IS BARE, not `Prompt[?t]`, and this is worth a paragraph
  -- because it is a general rule this file learned twice, both times the hard
  -- way.
  --
  --   A TYPE VARIABLE THAT OCCURS ONCE IS A WILDCARD. Spelling it as a
  --   variable claims a relationship that is not there.
  --
  -- `?t` here appeared in the parameter and never in the result, so it
  -- constrained nothing — measured: `Prompt[?t]` and a bare `Prompt` accept a
  -- Public and an Untrusted prompt alike, indistinguishably. What it DID do
  -- was read like `f(x: T[?t]) -> T[?t]`, the shape that means "preserves the
  -- label", to which this operation deliberately does not belong. A reviewer
  -- scanning for label-preserving signatures would have counted this one.
  --
  -- That misreading is not hypothetical. `complete` WAS typed `?t` in, `?t`
  -- out for a revision, and it let a model mint releasable text out of an
  -- empty prompt and mail it away (the exploit is kept as a regression:
  -- fixtures/agent/rejected/minting.anthill). Both defects found in this file
  -- have the same shape — a signature asserting a relationship it does not
  -- perform — so the cheapest defence is to write no variable where no
  -- relationship exists.
  --
  -- Worth a diagnostic eventually: a once-occurring type variable in a
  -- signature is almost always either a mistake or noise, and the typer knows.
  -- Not filed; recorded here.
  operation complete(self: C, p: Prompt) -> LlmOutput[Text[Untrusted]]
    effects {External, Error}
end

-- ================================================================
-- THE CARRIERS ARE CAPABILITY OBJECTS (proposal 064).
--
-- Each constructor is `internal`, which kernel-language.md §8.6 makes the ONLY
-- hide gate: it hides the name from cross-scope resolution AND from field
-- projection, with top-level code outside every declaring scope (WI-977). So
-- `open` is the only way to obtain an `Llm`, and `open` carries
-- `Permission[Model]` — the runtime consultation of an ambient grant, which can
-- refuse.
--
-- WITHOUT `internal` THE EFFECT IS ADVISORY, and that is not a slogan here: it
-- is what these two lines used to be. Before 064 a generated checker could write
-- `fake_llm(fixture: "x")` and hold a model, and the ONLY thing that then caught
-- it was `complete`'s `Model` label at the moment of USE. Now it is caught twice,
-- at two different moments, and `rejected/forged_llm.anthill` measures the first.
--
-- WHY `complete` STILL CARRIES `Model`, when 064 says the label goes on the mint
-- and nowhere else. That rule is about `Permission`, and it holds: `complete`
-- carries no `Permission`, because the check already happened and the `Llm` in
-- its signature is the evidence. `Model` is a DIFFERENT label answering a
-- DIFFERENT question — *did this code consult a model*, not *did it acquire the
-- authority to* — and this example needs both, because a checker can fail either
-- way independently:
--
--   holds an Llm it was handed, calls it   HARMLESS — the reply is `LlmOutput`,
--                                          which it can neither project nor match
--   holds none, mints one                  caught by `-Permission[Model]`(minting_checker)
--   holds none, forges one                 caught by `internal`          (forged_llm)
--
-- Neither label sees the other's program. vocabulary.anthill states the split at
-- the sort; this is where it bites.
-- ================================================================
sort guardians.LiveLlm
  import anthill.prelude.{String, Error, External, Permission}
  import guardians.{Llm, Prompt, Text, Model, FrontierModel, LlmOutput}
  import guardians.TrustLevel.{Untrusted}

  internal entity live_llm(endpoint: String, model: String)

  -- THE MINT, and the sole introduction. The `Permission[Model]` is consumed
  -- here and nowhere downstream.
  operation open(endpoint: String, model: String) -> LiveLlm
    effects {Permission[Model]} = live_llm(endpoint: endpoint, model: model)

  -- A STRONGER DEMAND for the same object. Acquiring a frontier model is
  -- acquiring a model (`FrontierModel <: Model`), so `-Permission[Model]`
  -- forbids this one too — the downward closure that stops a denial being
  -- evaded by naming a narrower capability. Measured:
  -- rejected/frontier_checker.anthill.
  operation open_frontier(endpoint: String) -> LiveLlm
    effects {Permission[FrontierModel]} =
      live_llm(endpoint: endpoint, model: "frontier")

  operation complete(self: LiveLlm, p: Prompt) -> LlmOutput[Text[Untrusted]]
    effects {External, Error}
  provides Llm
end

sort guardians.FakeLlm
  import anthill.prelude.{String, Error, External, Permission}
  import guardians.{Llm, Prompt, Text, Model, LlmOutput}
  import guardians.TrustLevel.{Untrusted}

  internal entity fake_llm(fixture: String)

  -- THE TEST DOUBLE OCCUPIES 064's TOP-RIGHT CELL: `Permission` without
  -- `External`. The same authority path is exercised — the grant is consulted
  -- and may refuse — and nothing leaves the process. That the two axes are
  -- orthogonal is what makes a double possible without a second code path.
  operation open(fixture: String) -> FakeLlm
    effects {Permission[Model]} = fake_llm(fixture: fixture)

  operation complete(self: FakeLlm, p: Prompt) -> LlmOutput[Text[Untrusted]]
    effects {External, Error}
  provides Llm
end

namespace guardians
  import anthill.prelude.{String, List}
  import guardians.{Text, Prompt, LiveLlm, FakeLlm}
  import guardians.TrustLevel.{Public}

  -- THE LATTICE JOIN, and the one place a label is DECIDED.
  --
  -- A trusted instruction plus untrusted content makes an untrusted prompt.
  -- For this two-point lattice the arithmetic is exact: `Public` is bottom, so
  -- `Public ⊔ ?t = ?t` and the variable carries the answer with no ordering
  -- machinery. An n-point lattice would need the general join, which the
  -- label slot cannot express while it stays invariant — though variance IS
  -- declarable (`fact Covariant(sort: Text, param: Trust)` over a provides-chain
  -- of levels), which would give the ordering directly. Measured, and the
  -- correction to an earlier claim: docs/design/measured.md C4.
  operation prompt_with(instruction : Text[Public],
                        content     : Text[?t]) -> Prompt[?t]

  -- Concatenation preserves the label of its parts.
  operation join_texts(parts: List[T = Text[?t]]) -> Text[?t]

  -- ONE host function for the whole model surface, keyed per carrier.
  provides LiveLlm language rust
    artifact "rustland/anthill-core/tests/guardians_test.rs"
    operation_map { complete: "guardians_live_complete" }
  end

  provides FakeLlm language rust
    artifact "rustland/anthill-core/tests/guardians_test.rs"
    operation_map { complete: "guardians_fake_complete" }
  end
end
