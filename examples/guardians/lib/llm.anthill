-- ================================================================
-- guardians.llm — THE PRIMITIVE. One call: text in, text out.
--
-- This is what an LLM API actually is, and it is the example's ONLY
-- task-agnostic model surface. `summarize` and `observe` are ordinary anthill
-- operations built on top (tasks.anthill), not separate host functions — a
-- real integration binds one HTTP call, not one function per task.
-- ================================================================

-- A prompt is a value carrying a trust label
enum guardians.Prompt
  import guardians.{Text}
  sort Trust = ?
  entity prompt(body: Text[Trust])
end

-- The authority to READ a model's answer — a different power from
-- `Permission[Llm]`, the authority to obtain one. A generated row grants neither.
sort guardians.Reveal
end

-- WHAT A MODEL RETURNED, and what retired the `Model` effect label: a trust label
-- on a value is strippable (WI-20260829-MCKTE), an opaque wrapper is not. Not
-- parameterized — a model's answer is always `Text[Untrusted]`, so there is no
-- relationship for a variable to hold.
sort guardians.LlmOutput
  import anthill.prelude.{Permission}
  import guardians.{Text, Reveal}
  import guardians.TrustLevel.{Untrusted}

  internal entity llm_output(value: Text[Untrusted])

  -- GATED ON THE ROW, NOT ON VISIBILITY, and the difference is measured:
  -- `internal` hides the constructor and its projection but NOT a sibling
  -- operation, so a public `text_of` loaded clean for a checker reading
  -- `text_of(llm.complete(p))`. `Permission[Reveal]` is what refuses it
  -- (rejected/steering_checker.anthill). Reading is not declassifying — the
  -- result is `Text[Untrusted]`, which the sink still refuses.
  operation text_of(o: LlmOutput) -> Text[Untrusted]
    effects {Permission[Reveal]} = o.value
end

sort guardians.Llm
  import anthill.prelude.{Error, External}
  import guardians.{Prompt, Text, LlmOutput}
  import guardians.TrustLevel.{Untrusted}

  sort C = ?

  operation complete(self: C, p: Prompt) -> LlmOutput
    effects {External, Error}
end

-- ================================================================
-- THE CARRIERS ARE CAPABILITY OBJECTS (proposal 064).
--
-- Each constructor is `internal`, which kernel-language.md §8.6 makes the ONLY
-- hide gate: it hides the name from cross-scope resolution AND from field
-- projection, with top-level code outside every declaring scope (WI-977). So
-- `open` is the only way to obtain an `Llm`, and `open` carries
-- `Permission[Llm]` — the runtime consultation of an ambient grant, which can
-- refuse.
--
-- WITHOUT `internal` THE EFFECT IS ADVISORY, and that is not a slogan here: it
-- is what these two lines used to be. Before 064 a generated checker could write
-- `fake_llm(fixture: "x")` and hold a model, and construction carried no effect
-- at all, so nothing caught it at the moment of ACQUISITION. `internal` is what
-- makes the mint the only door, and `rejected/forged_llm.anthill` measures it.
--
-- `complete` CARRIES NO `Permission`, which is 064 holding: the label goes on
-- the mint and nowhere else. The check already happened, and the `Llm` in this
-- signature is the evidence of it.
--
-- IT USED TO CARRY A SECOND LABEL, `Model`, answering a DIFFERENT question —
-- *did this code consult a model*, not *did it acquire the authority to*. That
-- question stopped mattering when `complete` started returning a sealed
-- `LlmOutput`: a component that calls a model learns nothing from the call, so
-- of the three ways a checker can reach one, only two are still failures:
--
--   holds an Llm it was handed, calls it   HARMLESS — the reply is `LlmOutput`,
--                                          which it can neither project nor match
--   holds none, mints one                  caught by `-Permission[Llm]` (minting_checker)
--   holds none, forges one                 caught by `internal`         (forged_llm)
-- ================================================================
sort guardians.LiveLlm
  import anthill.prelude.{String, Error, External, Permission}
  import guardians.{Llm, Prompt, Text, LlmOutput}
  import guardians.TrustLevel.{Untrusted}

  internal entity live_llm(endpoint: String, model: String)

  -- THE MINT, and the sole introduction. The `Permission[Llm]` is consumed
  -- here and nowhere downstream.
  operation open(endpoint: String, model: String) -> LiveLlm
    effects {Permission[Llm]} = live_llm(endpoint: endpoint, model: model)

  -- A NARROWER CAPABILITY FOR THE SAME OBJECT, which is what makes it a probe
  -- rather than a gate: `open` above mints the identical `LiveLlm` under the
  -- weaker `Permission[Llm]`, so this demands more and protects nothing. What it
  -- measures is the DOWNWARD CLOSURE — `LiveLlm provides Llm`, so `-Permission[Llm]`
  -- forbids this one too and a denial cannot be evaded by naming a narrower
  -- capability (rejected/frontier_checker.anthill). Note the closure runs one way
  -- only: `-Permission[LiveLlm]` would NOT forbid `open`.
  operation open_frontier(endpoint: String) -> LiveLlm
    effects {Permission[LiveLlm]} =
      live_llm(endpoint: endpoint, model: "frontier")

  operation complete(self: LiveLlm, p: Prompt) -> LlmOutput
    effects {External, Error}
  provides Llm
end

sort guardians.FakeLlm
  import anthill.prelude.{String, Error, External, Permission}
  import guardians.{Llm, Prompt, Text, LlmOutput}
  import guardians.TrustLevel.{Untrusted}

  internal entity fake_llm(fixture: String)

  -- THE TEST DOUBLE OCCUPIES 064's TOP-RIGHT CELL: `Permission` without
  -- `External`. The same authority path is exercised — the grant is consulted
  -- and may refuse — and nothing leaves the process. That the two axes are
  -- orthogonal is what makes a double possible without a second code path.
  operation open(fixture: String) -> FakeLlm
    effects {Permission[Llm]} = fake_llm(fixture: fixture)

  operation complete(self: FakeLlm, p: Prompt) -> LlmOutput
    effects {External, Error}
  provides Llm
end

namespace guardians
  import anthill.prelude.{String, List}
  import guardians.{Text, Prompt, LiveLlm, FakeLlm}
  import guardians.TrustLevel.{Public}

  -- THE LATTICE JOIN, and the one place a label is DECIDED. `Public` is bottom,
  -- so `Public ⊔ ?t = ?t` and the variable carries the answer with no ordering
  -- machinery. An n-point lattice would need the general join; variance IS
  -- declarable and would give it (measured: docs/design/measured.md C4).
  operation prompt_with(instruction : Text[Public],
                        content     : Text[?t]) -> Prompt[?t]

  -- Concatenation preserves the label of its parts.
  operation join_texts(parts: List[T = Text[?t]]) -> Text[?t]

  -- ONE host function for the whole model surface, keyed per carrier.
  provides LiveLlm language rust
    artifact "rustland/anthill-core/tests/guardians_test.rs"
    operation_map { complete: "guardians_live_complete" }
  end

  provides FakeLlm language rust
    artifact "rustland/anthill-core/tests/guardians_test.rs"
    operation_map { complete: "guardians_fake_complete" }
  end
end
