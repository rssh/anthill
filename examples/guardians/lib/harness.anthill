-- ================================================================
-- guardians.harness — THE GENERATION LOOP, as declarations.
--
-- The harness is the only component that touches both the KB-as-data and the
-- model. It renders the task from the trusted declarations, completes it,
-- takes the reply as a candidate program, and checks it. The effect rows say
-- which half is trusted:
--
--   render_task  {Error}                       reads declarations; no model
--   LiveLlm.open {Permission[Llm]}           the ACQUISITION — see llm.anthill
--                                              (on the CARRIERS; `Llm` the spec
--                                               declares no mint, and nothing
--                                               forces a carrier to have one)
--   Llm.complete {External, Error}             the untrusted step
--   check        {External, Error,
--                 -Permission[Llm]}          provably not steerable
--
-- The checker's row is the answer to "who guards the guard". A verifier that
-- could itself be steered by a model is as manipulable as the thing it verifies.
--
-- ONE DENIAL, WHERE THERE USED TO BE TWO. There are two ways to reach a model —
-- being handed one, and acquiring one — and the row used to deny both, with
-- `-Model` for the first. It no longer needs to: `LlmOutput` (llm.anthill) makes
-- what a model RETURNS unreadable, so a checker handed an `Llm` obtains a token
-- it cannot project or match, learns nothing from the call, and cannot be steered
-- by it. Being steered requires reading the answer, and the type now forbids that
-- — so only ACQUISITION is still worth denying, which is `-Permission[Llm]`
-- (proposal 064) and `rejected/minting_checker.anthill`.
-- ================================================================

-- A candidate program. Opaque and unverified: the ONLY thing that can be done
-- with a `Source` is submit it to a `Checker`.
--
-- NOTE WHAT IT IS NOT: `Source` carries no trust LABEL, and that is deliberate.
-- Taint asks "did attacker-controlled data influence this value?" — and for a
-- program generated from a Public prompt the answer is NO. Unverified-ness is a
-- different axis, and it rides on the type being opaque rather than on a label.
-- Labelling generated code `Untrusted` would assert something false.
sort guardians.Source
  import anthill.prelude.{String}
  entity source(text: String)
end

enum guardians.CheckResult
  import anthill.prelude.{String, List}
  import anthill.reflect.{Symbol}
  -- The verdict a proof could cite (docs/design/high-level-api.md §4).
  --
  -- THREE REFERENCES AND A ROW, none of them a constant. `carrier` used to be
  -- `String` and the checker filled it with the literal `"guardians.agent.Generated"`
  -- — a sort no candidate ever declares, so the verdict named nothing and the
  -- checker never learned what it had accepted. It is now the SYMBOL the gate
  -- found: the carrier the candidate declared that provides `spec`.
  --
  -- `budget` is the spec's declared effect row, and it is REPORTED rather than
  -- re-checked (see `gate.anthill`'s header). It is read from the BASE before the
  -- candidate is loaded, because a candidate that redeclares the spec would
  -- otherwise be restating the budget it is being held to.
  entity Accepted(carrier: Symbol, spec: Symbol, budget: List[T = String])
  -- Prose, on purpose: a model repairs from a diagnostic better than from a
  -- structured record, and these are fed straight back as `feedback`.
  entity Rejected(diagnostics: List[T = String])
end

sort guardians.Harness
  import anthill.prelude.{String, List, Error}
  import anthill.reflect.{Symbol}
  import guardians.{Prompt, Source, Text, Llm}
  import guardians.TrustLevel.{Public, Untrusted}

  sort C = ?

  -- Build the generator's prompt FROM THE TRUSTED DECLARATIONS. `Public` is
  -- the claim that generation is blind to content, stated as a type rather
  -- than as prose: no message can reach a prompt built out of declarations.
  --
  -- Reading the KB rather than transcribing it is the point — a hand-written
  -- prompt goes stale against a changed signature SILENTLY, and the model then
  -- codes against an interface the checker will not accept.
  operation render_task(self: C, spec: Symbol, tools: List[T = String],
                        feedback: List[T = String]) -> Prompt[Public]
    effects {Error}

  -- CODE GENERATION MAY ONLY PROCEED FROM A CONTENT-FREE PROMPT, and this
  -- signature is the whole of that claim.
  --
  -- `Prompt[Public]` is not decoration. It is the ONLY consumer of the label
  -- on a prompt, and without it the label would be produced and never read —
  -- `render_task` would return `Prompt[Public]` and nothing would check it.
  -- With it, a generation prompt built from mailbox text is `Prompt[Untrusted]`
  -- and does not type here: an agent whose CODE was written under the influence
  -- of an injected email cannot be produced at all.
  --
  -- That is the difference between generation and every other model call in
  -- this pipeline. `summarize` may read untrusted content — its OUTPUT is
  -- confined. Generation may not, because its output is a PROGRAM, and a
  -- program's confinement is the check, not a label.
  --
  -- The reply is `Untrusted` (a model's output always is), and `Source` carries
  -- no label at all: unverified-ness is a different axis, riding on the type
  -- being opaque with `Checker.check` its only elimination.
  operation generate(self: C, llm: Llm, p: Prompt[Public]) -> Source
    effects {External, Error}
end

sort guardians.Checker
  import anthill.prelude.{String, Error, External, Permission}
  import anthill.reflect.{Symbol}
  import guardians.{Source, CheckResult}

  sort C = ?

  -- Loads the candidate ALONGSIDE the trusted declarations and runs every
  -- check: namespace isolation, types (taint), row conformance against the
  -- spec (capability), and the contract legs. `External` because it touches
  -- the loader and the filesystem; the two denials because the guard must not be
  -- steerable — it neither consults a model nor acquires the authority to, and
  -- the second half is downward-closed, so naming a narrower capability does not
  -- evade it (see the file header, and vocabulary.anthill).
  operation check(self: C, src: Source, spec: Symbol) -> CheckResult
    effects {External, Error, -Permission[Llm]}
end

namespace guardians
  import anthill.prelude.{String, List, Error, External, Permission}
  import anthill.reflect.{Symbol}
  import guardians.{Harness, Checker, Llm, LiveLlm, Source, CheckResult}

  -- ONE ROUND of the loop: render, complete, check. The repair loop is the
  -- caller's — `Rejected`'s diagnostics are exactly what `render_task` takes
  -- as `feedback` on the next round, which is why the signature carries it.
  --
  -- IT TAKES THE `Llm` AND ACQUIRES NOTHING, which is the shape proposal 064 is
  -- about: the check happened before this call, and the `Llm` in the signature is
  -- the evidence. So this row carries `Model` (it consults one, through
  -- `generate`) and no `Permission` at all.
  operation attempt(h: Harness, llm: Llm, chk: Checker,
                    spec: Symbol, tools: List[T = String],
                    feedback: List[T = String]) -> CheckResult
    effects {External, Error} =
      let p = h.render_task(spec, tools, feedback)
      chk.check(h.generate(llm, p), spec)

  -- THE ACQUISITION, and the POSITIVE CONTROL for every `Permission` refusal in
  -- this example. Without it `Permission[Llm]` would appear only in
  -- `fixtures/agent/rejected/`, and a vocabulary that shows up exclusively in
  -- refused programs is indistinguishable from one that refuses everything — the
  -- trap this example's own methodology warns about (docs/design/measured.md, on
  -- controls).
  --
  -- This is where the whole pipeline's model authority enters, ONCE, and the row
  -- says so. `attempt` above is the same round with the capability already in
  -- hand: same `{External, Error}`, no `Permission`. The one line between
  -- them is the entire difference between using authority and obtaining it.
  operation open_round(h: Harness, chk: Checker,
                       endpoint: String, model: String,
                       spec: Symbol, tools: List[T = String],
                       feedback: List[T = String]) -> CheckResult
    effects {Permission[Llm], External, Error} =
      let llm = LiveLlm.open(endpoint, model)
      attempt(h, llm, chk, spec, tools, feedback)
end

-- Carriers.
sort guardians.FileHarness
  import anthill.prelude.{String, List, Error}
  import anthill.reflect.{Symbol}
  import guardians.{Harness, Prompt, Source, Text, Llm}
  import guardians.TrustLevel.{Public, Untrusted}
  entity file_harness
  operation render_task(self: FileHarness, spec: Symbol, tools: List[T = String],
                        feedback: List[T = String]) -> Prompt[Public]
    effects {Error}
  operation generate(self: FileHarness, llm: Llm, p: Prompt[Public]) -> Source
    effects {External, Error}
  provides Harness
end

sort guardians.LoadChecker
  import anthill.prelude.{String, Error, External, Permission}
  import anthill.reflect.{Symbol}
  import guardians.{Checker, Source, CheckResult, Llm}
  entity load_checker
  operation check(self: LoadChecker, src: Source, spec: Symbol) -> CheckResult
    effects {External, Error, -Permission[Llm]}
  provides Checker
end

namespace guardians
  import guardians.{FileHarness, LoadChecker}

  provides FileHarness language rust
    artifact "rustland/anthill-core/tests/guardians_test.rs"
    operation_map {
      render_task: "guardians_render_task",
      generate:    "guardians_generate"
    }
  end

  provides LoadChecker language rust
    artifact "rustland/anthill-core/tests/guardians_test.rs"
    operation_map { check: "guardians_check" }
  end
end
