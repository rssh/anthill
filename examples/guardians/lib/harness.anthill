-- ================================================================
-- guardians.harness — THE GENERATION LOOP, as declarations.
--
-- The only component touching both the KB-as-data and the model: it renders the
-- task from the trusted declarations, completes it, and checks the reply. The
-- effect rows say which half is trusted:
--
--   render_task  {Error}                        reads declarations; no model
--   LiveLlm.open {Permission[Llm]}              the ACQUISITION (on the CARRIERS —
--                                               `Llm` the spec declares no mint)
--   Llm.complete {E, Error}                     the untrusted step. `E` is the
--                                               CARRIER's row, not the spec's:
--                                               `LiveLlm` instantiates it at
--                                               `{External}`, `FakeLlm` at `{}`.
--                                               Welded to `External` here it was a
--                                               claim about every implementation
--                                               that only one could honour.
--   generate     {llm.E, Error}                 whatever model it was handed —
--                                               generation touches no mailbox
--   check        {External, Error,
--                 -Permission[Llm]}             provably not steerable
--
-- The checker's row answers "who guards the guard": a verifier that could itself
-- be steered is as manipulable as the thing it verifies. ONE DENIAL, WHERE THERE
-- USED TO BE TWO — being handed a model is harmless, since its reply is a `Text`
-- whose content nothing can read (vocabulary.anthill), so only ACQUISITION is
-- worth denying explicitly (rejected/minting_checker.anthill; the permitted half
-- is the control at fixtures/agent/consulting_checker.anthill).
-- ================================================================

-- A candidate program: opaque and unverified, and the only thing to do with one
-- is submit it to a `Checker`. It carries NO trust label, deliberately — taint
-- asks whether attacker data influenced a value, and for a program generated from
-- a Trusted prompt the answer is no. Unverified-ness is a different axis, carried
-- by the type being opaque.
--
-- OPAQUE MEANS `internal`, AND IT DID NOT USED TO. Both sentences above are
-- claims about PROVENANCE — that the text came from `generate` — and a public
-- constructor made them advisory in exactly the way proposal 064 found the
-- capability carriers advisory: `source(text: <mailbox bytes>)` mints a
-- candidate program no model ever wrote, and then nothing said about the PROMPT
-- constrains the program. Measured clean before the fix, and
-- `rejected/forged_source.anthill` is the program that measured it
-- (WI-20260829-MCKTE).
--
-- WHAT IT DOES NOT REST ON is `Prompt[Trusted]`. That claim is itself conditional
-- today — `render_task` below takes `feedback: List[T = String]` and returns
-- `Prompt[Trusted]` unconditionally, so mailbox bytes reach a Trusted prompt
-- without touching a `Source` at all (WI-20260829-MCKTE item 3, measured). The
-- two are independent holes on one path, and this seal closes only its own.
--
-- NO ANTHILL INTRODUCTION AT ALL, WHICH IS THE DESIGN AND NOT AN OVERSIGHT.
-- `generate` is the sole introduction and is body-less with a host binding, so
-- unlike `LiveLlm` (paired with `open`) and `Text` (paired with its two doors)
-- this sort has no sibling that mints. A pure-anthill `Harness` carrier is
-- therefore unwritable, which costs this example nothing — every carrier here
-- declares and the host implements — but it is a real narrowing and is why the
-- ACCEPTED control for the refusal is `fixtures/agent/checker.anthill`, which
-- RECEIVES a `Source` and passes it on: opaque, still usable, never mintable.
--
-- THE SEAL IS AGAINST ANTHILL, NOT AGAINST THE HOST. §8.6 gates name resolution,
-- and a host function reaching `guardians.Source.source` through
-- `try_resolve_symbol` + `Value::Entity` bypasses it — `guardians_test.rs` does
-- exactly that at three sites to stand in for the generator. So the property is
-- "no candidate can mint one", not "nothing can". If an embedder host-fn table
-- (WI-1122) is ever exposed to candidates, this seal is void and no test here
-- would notice.
sort guardians.Source
  import anthill.prelude.{String}
  internal entity source(text: String)
end

enum guardians.CheckResult
  import anthill.prelude.{String, List}
  import anthill.reflect.{Symbol}
  -- The verdict a proof could cite (docs/design/high-level-api.md §4).
  --
  -- THREE REFERENCES AND A ROW, none of them a constant. `carrier` used to be
  -- `String` and the checker filled it with the literal `"guardians.agent.Generated"`
  -- — a sort no candidate ever declares, so the verdict named nothing and the
  -- checker never learned what it had accepted. It is now the SYMBOL the gate
  -- found: the carrier the candidate declared that provides `spec`.
  --
  -- `budget` is the spec's declared effect row, and it is REPORTED rather than
  -- re-checked (see `gate.anthill`'s header). It is read from the BASE before the
  -- candidate is loaded, because a candidate that redeclares the spec would
  -- otherwise be restating the budget it is being held to.
  entity Accepted(carrier: Symbol, spec: Symbol, budget: List[T = String])
  -- Prose, on purpose: a model repairs from a diagnostic better than from a
  -- structured record, and these are fed straight back as `feedback`.
  entity Rejected(diagnostics: List[T = String])
end

sort guardians.Harness
  import anthill.prelude.{String, List, Error}
  import anthill.reflect.{Symbol}
  import anthill.prelude.{Permission}
  import guardians.{Prompt, Source, Llm, Vouch}
  import guardians.TrustLevel.{Trusted}

  sort C = ?

  -- Build the generator's prompt FROM THE TRUSTED DECLARATIONS. `Trusted` is
  -- the claim that generation is blind to content, stated as a type rather
  -- than as prose: no message can reach a prompt built out of declarations.
  --
  -- Reading the KB rather than transcribing it is the point — a hand-written
  -- prompt goes stale against a changed signature SILENTLY, and the model then
  -- codes against an interface the checker will not accept.
  operation render_task(self: C, spec: Symbol, tools: List[T = String],
                        feedback: List[T = String]) -> Prompt[Trusted]
    effects {Error, Permission[Vouch]}

  -- CODE GENERATION MAY ONLY PROCEED FROM A CONTENT-FREE PROMPT, and this
  -- signature is the whole of that claim.
  --
  -- `Prompt[Trusted]` is not decoration. It is the ONLY consumer of the label
  -- on a prompt, and without it the label would be produced and never read —
  -- `render_task` would return `Prompt[Trusted]` and nothing would check it.
  -- With it, a generation prompt built from mailbox text is `Prompt[Untrusted]`
  -- and does not type here: an agent whose CODE was written under the influence
  -- of an injected email cannot be produced at all.
  --
  -- THAT LAST SENTENCE IS TRUE OF `tools` AND FALSE OF `feedback`, and it is
  -- written down rather than fixed because the fix is a signature change with a
  -- decision behind it (WI-20260829-MCKTE item 3). `render_task` above returns
  -- `Prompt[Trusted]` UNCONDITIONALLY, so mailbox bytes handed to it as
  -- `feedback: List[T = String]` arrive here Trusted and this signature admits
  -- them — measured, 0 errors. The repair loop is the channel: `Rejected`'s
  -- diagnostics ARE next round's feedback. NOTE THE CHANNEL IS CURRENTLY UNSPELLED
  -- in the example: diagnostics are `List[String]` and no text's content reaches a
  -- `String` any more, so no fixture demonstrates the flow — it is a property of
  -- the SIGNATURES, not of a program here. The repair is to make
  -- `render_task` JOIN its inputs' labels the way `prompt_with` does.
  --
  -- That is the difference between generation and every other model call in
  -- this pipeline. `summarize` may read untrusted content — its OUTPUT is
  -- confined. Generation may not, because its output is a PROGRAM, and a
  -- program's confinement is the check, not a label.
  --
  -- The reply is `Untrusted` (a model's output always is), and `Source` carries
  -- no label at all: unverified-ness is a different axis, riding on the type
  -- being opaque with `Checker.check` its only elimination.
  --
  -- ROW-POLYMORPHIC IN THE MODEL. Generation touches no mailbox, so its only worldly
  -- effect is the model's own — and `External` is a fact about `LiveLlm`, not about
  -- being an `Llm`. Welded to the interface it forced `FakeLlm`, which leaves the
  -- process untouched, to declare it too.
  --
  -- AND THE `Branch` STORY IS THE SECOND HALF OF WHAT THAT BUYS. 054 bars
  -- `Branch × External`, so a SEARCHING generator — try, check, backtrack — is
  -- writable against the fixture and barred against the live model, from ONE row
  -- written once here. Driving it needs the caller's parameter typed at the CONCRETE
  -- carrier (`llm: LiveLlm`), where `llm.E` stops being a variable and becomes
  -- `{External}`; until WI-20260830-APWM3 that spelling was refused by a coverage gap
  -- rather than by 054 — a non-empty projected row was compared as one opaque merge
  -- term — which made the `Branch` label inert. Both halves are measured together in
  -- `a_projected_row_flattens_at_a_concrete_carrier_and_054_still_bars_branch_times_external`
  -- (`rustland/anthill-core/tests/guardians_test.rs`), including that the same row at
  -- `FakeLlm`'s `E = {}` still loads: 054 excludes the CO-OCCURRENCE, not `Branch`.
  operation generate(self: C, llm: Llm, p: Prompt[Trusted]) -> Source
    effects {llm.E, Error}
end

sort guardians.Checker
  import anthill.prelude.{String, Error, External, Permission}
  import anthill.reflect.{Symbol}
  import guardians.{Source, CheckResult}

  sort C = ?

  -- Loads the candidate ALONGSIDE the trusted declarations and runs every check:
  -- namespace isolation, taint, row conformance, contract legs. `External`
  -- because it touches the loader and the filesystem; the denial because the
  -- guard must not acquire a model — and it is downward-closed, so naming a
  -- narrower capability does not evade it.
  operation check(self: C, src: Source, spec: Symbol) -> CheckResult
    effects {External, Error, -Permission[Llm]}
end

namespace guardians
  import anthill.prelude.{String, List, Error, External, Permission}
  import anthill.reflect.{Symbol}
  import guardians.{Harness, Checker, Llm, LiveLlm, Source, CheckResult, Vouch}

  -- ONE ROUND: render, complete, check. The repair loop is the caller's —
  -- `Rejected`'s diagnostics are what `render_task` takes as `feedback` next
  -- round. It TAKES the `Llm` and acquires nothing, which is 064's shape: the
  -- check happened earlier and the `Llm` in the signature is the evidence, so
  -- this row carries no `Permission` at all.
  operation attempt(h: Harness, llm: Llm, chk: Checker,
                    spec: Symbol, tools: List[T = String],
                    feedback: List[T = String]) -> CheckResult
    effects {External, llm.E, Error, Permission[Vouch]} =
      let p = h.render_task(spec, tools, feedback)
      chk.check(h.generate(llm, p), spec)

  -- THE ACQUISITION, and the POSITIVE CONTROL for every `Permission` refusal in
  -- this example. Without it `Permission[Llm]` would appear only in
  -- `fixtures/agent/rejected/`, and a vocabulary that shows up exclusively in
  -- refused programs is indistinguishable from one that refuses everything — the
  -- trap this example's own methodology warns about (docs/design/measured.md, on
  -- controls).
  --
  -- This is where the whole pipeline's model authority enters, ONCE, and the row
  -- says so. `attempt` above is the same round with the capability already in
  -- hand: the same `{External, llm.E, Error}`, no `Permission`. The one line
  -- between them is the entire difference between using authority and obtaining
  -- it. (`External` on both is the CHECKER's, not the model's — `check` declares
  -- it; the model's share is the `llm.E` beside it.)
  operation open_round(h: Harness, chk: Checker,
                       endpoint: String, model: String,
                       spec: Symbol, tools: List[T = String],
                       feedback: List[T = String]) -> CheckResult
    effects {Permission[Llm], Permission[Vouch], External, Error} =
      let llm = LiveLlm.open(endpoint, model)
      attempt(h, llm, chk, spec, tools, feedback)
end

-- Carriers.
sort guardians.FileHarness
  import anthill.prelude.{String, List, Error}
  import anthill.reflect.{Symbol}
  import anthill.prelude.{Permission}
  import guardians.{Harness, Prompt, Source, Llm, Vouch}
  import guardians.TrustLevel.{Trusted}
  entity file_harness
  operation render_task(self: FileHarness, spec: Symbol, tools: List[T = String],
                        feedback: List[T = String]) -> Prompt[Trusted]
    effects {Error, Permission[Vouch]}
  operation generate(self: FileHarness, llm: Llm, p: Prompt[Trusted]) -> Source
    effects {llm.E, Error}
  provides Harness
end

sort guardians.LoadChecker
  import anthill.prelude.{String, Error, External, Permission}
  import anthill.reflect.{Symbol}
  import guardians.{Checker, Source, CheckResult, Llm}
  entity load_checker
  operation check(self: LoadChecker, src: Source, spec: Symbol) -> CheckResult
    effects {External, Error, -Permission[Llm]}
  provides Checker
end

namespace guardians
  import guardians.{FileHarness, LoadChecker}

  provides FileHarness language rust
    artifact "rustland/anthill-core/tests/guardians_test.rs"
    operation_map {
      render_task: "guardians_render_task",
      generate:    "guardians_generate"
    }
  end

  provides LoadChecker language rust
    artifact "rustland/anthill-core/tests/guardians_test.rs"
    operation_map { check: "guardians_check" }
  end
end
