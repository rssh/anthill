-- ================================================================
-- guardians.observe — the ONLY vocabulary the model may write at run time.
--
-- This enum is the entire expressive power of the untrusted channel. No
-- constructor here names an address, a tool, or an action, so no injected
-- sentence can be reflected back as one. That is Meijer's code/data
-- separation enforced by the SORT rather than by a JSON convention.
--
-- `Other` IS WHAT "I LOOKED AND NOTHING HERE FITS" IS SPELLED AS, and it is the
-- reason `SecurityCategory.Unexamined` can mean silence and nothing else. It
-- COSTS SOMETHING, and the cost is written down rather than discovered: an
-- `Observed` needs a span, ANY real quote discharges one, so a model can reach
-- `NotSuspicious` for a message it barely read. Accepted, because the security
-- half does not rest on it — `Suspicious` still needs a manipulative feature AND
-- a corroborator computed from the mailbox with no model in the loop — while the
-- alternative, folding "bland" into "unexamined", flags every plain message and
-- teaches a reader to ignore the one signal that matters.
--
-- THE VOCABULARY IS SECURITY-ONLY, and `InvestmentPitch`/`MeetingInvite` came out
-- when `Other` went in: a non-manipulative feature reaches no category of its own,
-- so its whole contribution was `observed_message(?m)` — which is exactly what
-- `Other` contributes. They were `Other` under another name. `UrgencyAppeal` STAYS
-- because it is what keeps `manipulative/1` a real declaration: with nothing
-- security-relevant-but-insufficient in the enum, that table degenerates into
-- "everything except `Other`" and stops carrying a judgement. Content belongs in
-- the prose summary, which already carries it.
-- ================================================================

enum guardians.Feature
  entity CredentialRequest
  entity PaymentRedirect
  entity ForwardingInstruction     -- "send this elsewhere"
  entity SecrecyInstruction        -- "do not tell the user"
  entity UrgencyAppeal             -- security-relevant, NOT sufficient alone
  entity Other                     -- examined; none of the above applies
end

namespace guardians
  import anthill.prelude.{String, Int64}
  import guardians.{MessageId, Feature}

  -- A span into the RAW bytes of one message. `quote` is redundant ON
  -- PURPOSE: the kernel can slice the message and compare, so an
  -- observation pointing at text that is not there is MALFORMED, not
  -- merely wrong.
  entity Span(message: MessageId, start: Int64, end: Int64, quote: String)

  -- What the model is allowed to say: it attributes a feature to a
  -- message and points at the text. It cannot say "this is spam", and
  -- it cannot say anything about a message other than the one the span
  -- names.
  entity Observed(at: Span, feature: Feature)
end
