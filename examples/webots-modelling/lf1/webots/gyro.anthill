-- webots::Gyro — angular velocity sensor (rad/s on each body axis).
--
-- C++ surface:
--   void enable(int samplingPeriod);
--   void disable();
--   int  getSamplingPeriod() const;
--   const double *getValues() const;   // -> Vec3 (angular vel x/y/z)

sort anthill.examples.lf1.webots.Gyro
  import anthill.prelude.{Int64, Unit, Modify, Modifiable}
  import anthill.geometry.{Vec3}
  -- A device handle is a mutable resource: its operations write `Modify[self]`,
  -- and a `Modify` fires only on a modifiable type (proposal 037 Rule 8).
  provides Modifiable[T = Self]

  operation enable(self: Gyro, sampling_period: Int64) -> Unit
    effects Modify[self]

  operation disable(self: Gyro) -> Unit
    effects Modify[self]

  operation get_sampling_period(self: Gyro) -> Int64

  -- Angular velocity in body frame, rad/s on (roll, pitch, yaw).
  operation get_values(self: Gyro) -> Vec3
end
