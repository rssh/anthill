fact WorkItem(id: "WI-046", description: some(value: "026.1 Q2: TermView abstraction. Add trait TermView { head, arg, named } impl for Value and (&KB, TermId). Add kb.match_view<V: TermView>(pattern: TermId, target: V) beside match_term. Generalize SubstTree::query_resolved and resolve.rs unifier to consume impl TermView on binding side; candidate rule heads stay TermId. Acceptance: all kb tests still green; match_term becomes thin wrapper. Proposal 026.1 Q2 + §TermView abstraction."), context: none, acceptance: [ToolPasses(tool: "cargo-test", params: none)], depends_on: some(value: ["WI-045"]), generates: none, requires_capability: none, status: Verified(at: "2026-04-22T19:14:01Z"))
