fact WorkItem(id: "WI-029", description: some(value: "De Bruijn variable representation: DeBruijn(u32) for bound vars in stored terms, Global(VarId) for instantiated vars during resolution. Enables canonical hash-consing, per-query caching, and proper quantifier scoping. See Proposal 024. Prerequisite for WI-027 (forall in rule bodies)."), context: none, acceptance: [ToolPasses(tool: "cargo-test", params: none)], depends_on: some(value: nil), generates: none, requires_capability: none, status: Verified(at: "2026-03-30T18:50:28Z"))
