fact WorkItem(id: "WI-587", description: some(value: "Codegen: prune unreferenced imports in signature-only output, replacing the per-file suppress_imports flag (WI-553 follow-up). suppress_imports was added for stream.rs because the spec's body/rule imports do not resolve on the host and are never referenced in the signature-only trait. Principled fix: emit a 'use' only for names referenced in the generated output, also removing the prelude::stream shim's hand-provided 'use Pair'. anthill-core/src/codegen/rust.rs."), context: none, acceptance: [ToolPasses(tool: "cargo-test", params: none)], depends_on: some(value: nil), generates: none, requires_capability: none, status: Open)
