fact WorkItem(id: "WI-022", description: some(value: "Auto-extract trigger sorts from guard term: walk LogicalQuery tree, find pattern_query atoms, extract functor, look up sort. Simplifies add_guard API."), context: none, acceptance: [ToolPasses(tool: "cargo-test", params: none)], depends_on: some(value: nil), generates: none, requires_capability: none, status: Delivered(agent: "claude", at: "2026-05-03T17:22:40Z"))

fact Feedback(workitem: "WI-022", author: "user", content: "Implemented. add_guard(guard_term: TermId) signature dropped trigger_sorts param; new extract_trigger_sorts walks the LogicalQuery tree (kb/mod.rs:457-525) and feeds guards_by_sort. pattern_query(term: Foo(...)) → constructor_parent_sort(Foo); sort_query(sort_name: 'S') → S. Compound forms (conjunction/disjunction/negation/guarded/projected/limited/quantifiers) recurse. Made LogicalQuerySymbols::resolve pub(crate) (kb/execute.rs:125). Added guard_trigger_sorts public accessor for verification. Tests in tests/guard_trigger_test.rs cover pattern_query and conjunction cases.", at: "2026-05-03T17:22:40Z")
