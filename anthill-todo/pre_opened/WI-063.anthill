fact WorkItem(id: "WI-063", description: some(value: "EvalConfig: add value_weight_cap. Sum per-Value weight (scalars=1, Str ~= len/16, Entity/Tuple = 2 + children) across frame locals + closure arena. Catches memory-blowup programs where stack stays shallow but values grow (e.g., recursive cons-ing of big strings). Not needed for typical CLI / test usage; useful when embedding anthill in a host (untrusted input) or for spec-level budget contracts. Tag as 'embedding prerequisite'."), context: none, acceptance: [ToolPasses(tool: "cargo-test", params: none)], depends_on: some(value: ["WI-062"]), generates: none, requires_capability: none, status: PreOpened)
