-- Ring: algebraic spec for a ring (additive group + multiplicative monoid)
sort Ring
  sort T = ?

  operation add(a: T, b: T) -> T
  operation mul(a: T, b: T) -> T
  operation neg(a: T) -> T
  operation zero() -> T
  operation one() -> T

  -- Additive identity
  rule ?a + zero <=> ?a
  rule zero + ?a <=> ?a

  -- Additive inverse
  rule ?a + neg(?a) <=> zero

  -- Multiplicative identity
  rule ?a * one <=> ?a
  rule one * ?a <=> ?a

  -- Commutativity of addition
  rule ?a + ?b <=> ?b + ?a

  -- Distributivity
  rule (?a + ?b) * ?c <=> ?a * ?c + ?b * ?c
  rule ?a * (?b + ?c) <=> ?a * ?b + ?a * ?c
end

-- Int64 satisfies Ring. Written as a SECONDARY ENTRY (059 R2) at the carrier's
-- own address: a provision names its provider by WHERE it is written, and
-- WI-20260917-S8JYF retired the namespace-level `fact Ring[Int64]` spelling that
-- derived the carrier from a binding (058 §4).
namespace anthill.prelude.Int64
  provides Ring[T = Int64]
end
