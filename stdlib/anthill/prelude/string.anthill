-- String: abstract spec for the built-in string sort.
-- Spec satisfaction facts (Eq[String], Ord[String]) live in the per-language
-- binding files (e.g. rustland/anthill-stl/anthill/string.anthill) — see proposal 038.
sort anthill.prelude.String
  import anthill.prelude.{Eq, Ord, Int64}
  import anthill.prelude.Additive.{sub}
  -- WI-20260825-KD9SW: a WRITTEN name in a LAW or CONSTRAINT HEAD needs the import.
  import anthill.prelude.PartialEq.{eq}

  -- WI-876: `String`'s ORDERING (lexicographic by code unit), declared here and
  -- backed by the host in `rustland/anthill-stl/anthill/string.anthill`'s
  -- `operation_map`. See `int64.anthill`'s note for why a host-backed operation
  -- must still be DECLARED on its carrier.
  operation {
    compare(a: String, b: String) -> Int64  -- -1 | 0 | 1
    gt(a: String, b: String) -> Bool        -- >
    gte(a: String, b: String) -> Bool       -- >=
    lt(a: String, b: String) -> Bool        -- <
    lte(a: String, b: String) -> Bool       -- <=
    max(a: String, b: String) -> String     -- the greater
    min(a: String, b: String) -> String     -- the lesser
  }

  -- THE INDEX UNIT IS THE UNICODE SCALAR (code point), for every operation here that
  -- counts or addresses positions: `length`, `substring` and `indexOf` are one scale,
  -- never bytes and never grapheme clusters. WI-884 settled it by driving the
  -- alternative: the host primitive behind `indexOf` answers in BYTES, and
  -- `indexOf("éb", "b")` is 2 there where the character index is 1 — so a byte answer
  -- would make `substring(s, indexOf(s, sub), …)` cut the wrong span on any string
  -- with a multi-byte prefix. The round trip
  -- `substring(s, indexOf(s, sub), indexOf(s, sub) + length(sub)) = sub` is what pins
  -- the three together, and is driven as a test.
  --
  -- THE EMPTY STRING OCCURS AT EVERY BOUNDARY. That is not new here — three of this
  -- sort's laws below already say it (`contains(?s, "")`, `startsWith(?s, "")`,
  -- `endsWith(?s, "")` are all `true`) — but WI-884 is where it had to be carried
  -- into the operations that RETURN something, and the per-operation comments say
  -- what each one does with it rather than leaving the degenerate case to be
  -- discovered.
  --
  -- WI-884: `contains`, `indexOf`, `replace`, `trim`, `split` and `isEmpty` are
  -- HOST-BACKED, named in `rustland/anthill-stl/anthill/string.anthill`'s
  -- `operation_map`. All six were declared and backed by NOTHING — they died
  -- `OperationBodyMissing` on a program that loaded clean, WI-881's defect one sort
  -- over. `isEmpty` is host-backed for a reason the others are not: it is DEFINABLE
  -- here (`length(s) = 0`, the law below), but only at O(n) — see the binding block,
  -- which owns the cost argument because it is the HOST's.
  operation {
    concat(a: String, b: String) -> String
    length(s: String) -> Int64                     -- Unicode scalars, not bytes
    isEmpty(s: String) -> Bool
    contains(s: String, sub: String) -> Bool       -- true for sub = ""
    startsWith(s: String, prefix: String) -> Bool
    endsWith(s: String, suffix: String) -> Bool
    -- The half-open character range [start, end). Out-of-range indices CLAMP to the
    -- string's bounds and a reversed range gives "" — so it is total, and a second
    -- backend has to reproduce that rather than trap.
    substring(s: String, start: Int64, end: Int64) -> String
    -- The CHARACTER index of the first occurrence, -1 if not found; 0 for sub = "".
    indexOf(s: String, sub: String) -> Int64
    -- EVERY non-overlapping occurrence, scanned left to right — `replace("aaa", "aa",
    -- "b")` is "ba", not "ab". A first-only replace is expressible from this one with
    -- `indexOf` and `substring`; the reverse is not. `old = ""` interleaves `new` at
    -- every boundary, ends included.
    replace(s: String, old: String, new: String) -> String
    -- Leading and trailing UNICODE whitespace (the White_Space property), not the
    -- ASCII subset — the same scale `length` and `toUpper`/`toLower` already use.
    trim(s: String) -> String
    toUpper(s: String) -> String
    toLower(s: String) -> String
    -- Every piece between consecutive separators, with no limit and nothing dropped.
    -- Keeping the EMPTY pieces is what makes it invertible: rejoining the result with
    -- `sep` reproduces `s` for every input, including `split("", ",")` = [""],
    -- `split(",a,", ",")` = ["", "a", ""] and `split("abc", "")` = ["","a","b","c",""].
    split(s: String, sep: String) -> List[T = String]
    repeat(s: String, n: Int64) -> String          -- n copies of s; n <= 0 → ""
  }

  -- WI-1121: the two primitives an identifier MINTED FROM CONTENT needs. Both are
  -- host-backed for the same reason the six above are — one classifies CHARACTERS
  -- and the other needs integer bit arithmetic over bytes, and this sort declares
  -- neither capability.
  --
  -- THEY ARE A PAIR, and the pairing is the point: `slug` renders content for a
  -- HUMAN and `digestBase32` renders it for a MACHINE, so a name built from both
  -- is readable AND distinguishing without either half having to be both.
  operation {
    -- Prose reduced to `[a-z0-9-]`, cut to `cap` characters at a word boundary:
    -- lowercase, keep `[a-z0-9]`, collapse every other run to a single `-`, cut at
    -- the last `-` at or before `cap` (or at `cap` exactly when the head holds no
    -- `-`, so one long word truncates rather than vanishing), drop a trailing `-`.
    --
    -- TOTAL, AND "" IS A LEGAL ANSWER — a string written entirely in a non-Latin
    -- script or entirely in punctuation keeps nothing. A caller must therefore
    -- treat the result as decoration and never as an identity: `cap <= 0` is ""
    -- too, by the same rule rather than as a special case.
    slug(s: String, cap: Int64) -> String
    -- A deterministic digest of `s` as `cap` Crockford base32 characters
    -- (`0123456789ABCDEFGHJKMNPQRSTVWXYZ` — 0-9 and A-Z without I, L, O, U), 5
    -- bits each, UPPERCASE. 1 <= cap <= 12; anything else is refused rather than
    -- clamped, because a clamp would hand back fewer bits than the caller asked
    -- for while looking like the width they wrote.
    --
    -- NOT A CHECKSUM, NOT CRYPTOGRAPHIC, and callers must not build one out of
    -- it. What it promises is exactly two things: equal inputs give equal outputs,
    -- and unequal inputs spread evenly. A PREFIX of a wider digest is the narrower
    -- digest of the same input, so a caller that widens `cap` later does not
    -- invalidate what it already minted.
    digestBase32(s: String, cap: Int64) -> String
  }

  -- padRight: s padded with trailing spaces to `width`; unchanged when
  -- already that wide. The deficit is computed once and filled with one
  -- repeat + one concat — O(width), replacing the quadratic
  -- one-space-per-recursion shape callers used to hand-roll.
  -- WI-876: `Int64.gt` explicitly — `d` is an `Int64`, and since this sort now
  -- declares its OWN `gt` (over `String`), an unqualified `gt` here would resolve to
  -- that one and be a type error. Qualifying names the carrier the operands have.
  operation padRight(s: String, width: Int64) -> String =
    let d = sub(width, length(s))
    if Int64.gt(d, 0) then concat(s, repeat(" ", d)) else s

  -- Laws. ALL SIX ARE SPECIFICATION and none is tagged: a `[simp]` equation is
  -- EXECUTABLE (it inlines LHS→RHS, so a body-less operation runs) while an untagged
  -- one only states what is true — WI-881 settled that on `float.anthill`.

  -- `isEmpty`'s law is the only TOTAL one — a string has zero code points exactly when
  -- it is empty — so it COULD be the implementation, and WI-884 tagged it. Reverted
  -- (WI-885) on two grounds. CHANNEL: a definition anthill can express belongs in a
  -- BODY, from which the equational, relational and proof views are DERIVED (WI-580,
  -- WI-669) — `[simp]` is 043's directional-rewrite attribute, and it cannot back a
  -- DISPATCHED call at all, since no requirement dictionary can hold a rewrite rule.
  -- COST: this one wants no body either, because routing through `length` is O(n)
  -- where the host answers emptiness in O(1) — the argument is host-specific and
  -- lives on the mapping, in `rustland/anthill-stl/anthill/string.anthill`. Untagged,
  -- the law also stops `eq(length(s), 0)` inlining into every proof and codegen
  -- output where the author wrote `isEmpty(s)`.
  rule isEmpty(?s) <=> eq(length(?s), 0)

  -- The other five are each true and each PARTIAL — a single case of an operation
  -- whose other cases the host answers, so none of them could back its operation even
  -- tagged. `contains(?s, "")` says what `contains` does with the empty pattern, not
  -- what `contains` is.
  rule concat("", ?s) <=> ?s
  rule concat(?s, "") <=> ?s
  rule startsWith(?s, "") <=> true
  rule endsWith(?s, "") <=> true
  rule contains(?s, "") <=> true
end
