-- Int64: abstract spec for the built-in integer sort.
-- Spec satisfaction facts (Eq[Int64], Ord[Int64], Numeric[Int64]) live in
-- the per-language binding files (e.g. rustland/anthill-stl/anthill/boundedint.anthill)
-- — see proposal 038.
sort anthill.prelude.Int64
  import anthill.prelude.{Eq, Ord, Numeric}
  import anthill.prelude.Additive.{add, sub}
  -- WI-894: `ite` is a RULE-INTRODUCED functor on `Bool`, reached by an explicit
  -- import rather than by a global name — see the note in `ordered.anthill`.
  import anthill.prelude.Bool.{ite}
  -- WI-20260825-KD9SW: a WRITTEN bare `eq`/`neq` (an effect guard, a law) names the
  -- operation by import now; a minted `=`/`!=` carries its own address and needs nothing.
  import anthill.prelude.PartialEq.{eq, neq}

  -- WI-876: `Int64`'s ORDERING, declared here and backed by the host in
  -- `rustland/anthill-stl/anthill/int64.anthill`'s `operation_map`. Body-less
  -- because the implementation is the host artifact's — the `LogicalStream.
  -- splitFirst` shape, and what `check_provider_operations` already exempts a host
  -- carrier for.
  --
  -- WHY DECLARED AT ALL, when `fact Ord[T = Int64]` alone used to do: the host
  -- implementation had nowhere to be KEYED, so it was registered on the SPEC op
  -- (`anthill.prelude.Ord.compare`) — where that one host-scalar implementation
  -- served every carrier that never wrote its own, including structural ones it
  -- cannot compare. An operation must EXIST on the carrier for a per-carrier
  -- registration to attach to; these declarations are that.
  --
  -- `gt`/`gte`/`lt`/`lte` are host-backed as well as `compare`, not left to
  -- `PartialOrd`'s `compare`-based default: that keeps the scalar comparison ONE
  -- host call, and it gives the default body a floor to bottom out on (it reads
  -- `Int64.gt` on `compare`'s result).
  operation {
    compare(a: Int64, b: Int64) -> Int64   -- -1 | 0 | 1
    gt(a: Int64, b: Int64) -> Bool         -- >
    gte(a: Int64, b: Int64) -> Bool        -- >=
    lt(a: Int64, b: Int64) -> Bool         -- <
    lte(a: Int64, b: Int64) -> Bool        -- <=
    max(a: Int64, b: Int64) -> Int64       -- the greater
    min(a: Int64, b: Int64) -> Int64       -- the lesser
  }

  -- Bounds: Int64 is finite (platform-dependent, e.g. i64)
  --
  -- WI-884: host-backed, named in `rustland/anthill-stl/anthill/int64.anthill`'s
  -- `operation_map`. Until then these were the only two of this sort's eighteen
  -- declared operations backed by NOTHING — both died `OperationBodyMissing` on a
  -- program that loaded clean, the shape WI-881 found twenty-four times over on
  -- `Float`, and invisible for the same reason (a host carrier is exempt from the
  -- load-time backing check wholesale; WI-880 narrows that).
  --
  -- A HOST MAPPING AND NOT AN EQUATION, though `minValue() <=> ...` would be exact
  -- for a fixed carrier: a `[simp]` head is an APPLICATION, so it rewrites
  -- `minValue()` and not the BARE `minValue` that `in_bounds` just below writes.
  -- MEASURED on `Float.tau`, which is why the three float constants are host-backed
  -- too. Nullary operations want dispatch, not inlining.
  operation minValue() -> Int64
  operation maxValue() -> Int64

  -- Every Int64 is within bounds
  constraint in_bounds: gte(?n, minValue), lte(?n, maxValue)

  -- Operations beyond what Numeric provides
  operation {
    abs(a: Int64) -> Int64                  -- |a|
    neg(a: Int64) -> Int64                  -- -a
    mod(a: Int64, b: Int64) -> Int64 effects { Error[DivisionByZero] :- eq(b, 0) }      -- a mod b (always non-negative); partial: b ≠ 0
    rem(a: Int64, b: Int64) -> Int64 effects { Error[DivisionByZero] :- eq(b, 0) }      -- a rem b (sign follows dividend); partial: b ≠ 0
    div(a: Int64, b: Int64) -> Int64 effects { Error[DivisionByZero] :- eq(b, 0) }      -- truncated integer division; also `/` infix; partial: b ≠ 0
    divExact(a: Int64, b: Int64) -> Int64 effects { Error[DivisionByZero] :- eq(b, 0) } -- integer division (truncated); alias of div; partial: b ≠ 0
    sign(a: Int64) -> Int64                 -- -1, 0, or 1
    to_float(n: Int64) -> Float           -- exact for |n| < 2^53; rounds otherwise
    to_string(n: Int64) -> String         -- decimal representation, no padding
  }

  -- Laws
  rule neg(?a) <=> sub(0, ?a)
  rule abs(?a) <=> max(?a, neg(?a))
  rule sign(?a) <=> ite(gt(?a, 0), 1, ite(lt(?a, 0), neg(1), 0))
  rule divExact(?a, ?b) <=> div(?a, ?b)

  -- Constraints: invariant :- guard
  constraint div_nonzero_primary: neq(?b, 0) :- div(?_, ?b)
  constraint div_nonzero: neq(?b, 0) :- divExact(?_, ?b)
  constraint rem_nonzero: neq(?b, 0) :- rem(?_, ?b)
  constraint mod_positive: gt(?b, 0) :- mod(?_, ?b)

  -- Bounded well-founded induction over a half-open interval [lo, hi).
  -- Proposal 025 §Auto-generated induction rules. Used by the Z3
  -- induction tactic (WI-101) to discharge ∀k. lo ≤ k < hi → P(k)
  -- obligations — the lf1 reachability lift's intended driver.
  rule induction(?P, ?lo, ?hi)
    :- ?P(?lo),
       (forall(?n),
          gte(?n, ?lo), lt(?n, ?hi), ?P(?n)
          -: ?P(add(?n, 1)))
end
