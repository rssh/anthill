-- BigInt: abstract spec for arbitrary-precision integer operations.
-- Used for ZK field elements, cryptographic constants, and values exceeding i64.
-- Literals that overflow i64 are automatically parsed as BigInt.
-- Spec satisfaction facts (Eq[BigInt], Ord[BigInt], Numeric[BigInt]) live
-- in the per-language binding files (e.g. rustland/anthill-stl/anthill/bigint.anthill)
-- — see proposal 038.
sort anthill.prelude.BigInt
  import anthill.prelude.{Eq, Ord, Numeric}
  -- WI-20260825-KD9SW: a WRITTEN bare `eq`/`neq` (an effect guard, a law) names the
  -- operation by import now; a minted `=`/`!=` carries its own address and needs nothing.
  import anthill.prelude.PartialEq.{eq}

  -- WI-876: `BigInt`'s ORDERING, declared here and backed by the host in
  -- `rustland/anthill-stl/anthill/bigint.anthill`'s `operation_map`. See
  -- `int64.anthill`'s note for why a host-backed operation must still be DECLARED
  -- on its carrier.
  operation {
    compare(a: BigInt, b: BigInt) -> Int64  -- -1 | 0 | 1
    gt(a: BigInt, b: BigInt) -> Bool        -- >
    gte(a: BigInt, b: BigInt) -> Bool       -- >=
    lt(a: BigInt, b: BigInt) -> Bool        -- <
    lte(a: BigInt, b: BigInt) -> Bool       -- <=
    max(a: BigInt, b: BigInt) -> BigInt     -- the greater
    min(a: BigInt, b: BigInt) -> BigInt     -- the lesser
  }

  -- WI-20260824-VT8CF: `BigInt`'s DIVISION WITH REMAINDER, the surface that makes
  -- `provides EuclideanDomain[T = BigInt]` true. Until this ticket it did not exist —
  -- this sort declared eighteen ordering and conversion operations and no division at
  -- all — so a minted `/` or `%` over BigInt operands had nothing to reach, while the
  -- RESOLVER computed both (the BigInt slots of `BuiltinTag::Div` / `Mod`). Host-backed,
  -- named in `rustland/anthill-stl/anthill/bigint.anthill`'s `operation_map`.
  --
  -- ONLY THE ZERO DIVISOR IS PARTIAL: `BigInt` is unbounded, so there is no
  -- `Int64.div`-style overflow arm. The guarded effect is the one `Int64` writes.
  operation {
    div(a: BigInt, b: BigInt) -> BigInt effects { Error[DivisionByZero] :- eq(b, 0) }  -- truncated quotient; partial: b ≠ 0
    mod(a: BigInt, b: BigInt) -> BigInt effects { Error[DivisionByZero] :- eq(b, 0) }  -- Euclidean remainder, never negative; partial: b ≠ 0
    rem(a: BigInt, b: BigInt) -> BigInt effects { Error[DivisionByZero] :- eq(b, 0) }  -- truncated remainder, sign follows the dividend; partial: b ≠ 0
  }

  -- WI-880: `BigInt`'s ARITHMETIC, host-backed and named in this carrier's
  -- `operation_map` like everything else it declares. UNBOUNDED — these are the third
  -- column of the overflow table that is the argument for keying the family per
  -- carrier: `Int64`'s raise, `Float`'s saturate, and these cannot overflow, so one
  -- registration on `Additive.add` was three operations under one name.
  --
  -- `neg` IS DECLARED HERE and was not before. It had no carrier-keyed implementation
  -- at all — `numeric_neg` on the spec op covered `BigInt` by testing the operand —
  -- so with that registration gone it needs its own, and a carrier that provides
  -- `Additive` owes a `neg` (the load check demands it; `arithmetic.anthill` carries
  -- the measurement).
  --
  -- The bare `sub` in `induction` below now means `BigInt.sub`, which is why the
  -- `import anthill.prelude.Additive.{sub}` this sort carried is gone: these
  -- declarations would have shadowed it.
  operation {
    add(a: BigInt, b: BigInt) -> BigInt   -- +, unbounded
    sub(a: BigInt, b: BigInt) -> BigInt   -- - (binary), unbounded
    mul(a: BigInt, b: BigInt) -> BigInt   -- *, unbounded
    neg(a: BigInt) -> BigInt              -- - (prefix), unbounded
  }

  -- Conversion operations
  operation to_bigint(n: Int64) -> BigInt
  operation to_int(n: BigInt) -> Option[Int64]
  -- BigInt → Float. Lossy for values beyond f64's precision (~2^53) —
  -- rounds to nearest representable Float, may saturate to Infinity.
  -- Total function: all inputs produce a defined Float (possibly Inf).
  operation to_float(n: BigInt) -> Float

  -- Strong induction on non-negative BigInt. Proposal 025 §Auto-generated
  -- induction rules. ?P holds for all n ≥ 0 if it holds at 0 and is
  -- preserved by the predecessor IH at every positive n.
  --
  -- WI-1056: the bounds are written `to_bigint(0)` / `to_bigint(1)` because a
  -- small integer literal is an `Int64` — only one that OVERFLOWS i64 parses as
  -- a `BigInt` (see this file's header), and there is no implicit widening. With
  -- the literals written bare this rule was ill-typed at every one of the three
  -- sites: `?n` is a `BigInt` (`gt`'s own parameter says so), so `sub(?n, 1)`
  -- passed an `Int64` where `BigInt` is declared. Only that one was ever
  -- REPORTED — `sub` is `Numeric.sub`, a body-less spec op, and WI-1043 made a
  -- rule-body call on one a call site; `gt` is BigInt's own member and `?P` is a
  -- predicate variable, so neither is type-checked yet (the general rule-body
  -- check is WI-1058). All three are corrected together, since a
  -- schema that is coherent only where something happens to look is not coherent.
  rule induction(?P)
    :- ?P(to_bigint(0)),
       (forall(?n),
          gt(?n, to_bigint(0)), ?P(sub(?n, to_bigint(1)))
          -: ?P(?n))
end
