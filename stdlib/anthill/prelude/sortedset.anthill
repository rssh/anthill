-- SortedSet: a set kept in the order of a comparator the TYPE names (proposal 058
-- §5.3, WI-844). The prelude's `Set` is an unordered spec whose equality is
-- membership; this is a concrete structure — a weight-balanced tree — whose element
-- order is part of what it IS, which is why its ordering slot is NAMED.
--
-- ── WHAT THE NAME BUYS (058 §4.7) ────────────────────────────────────────────────
--
-- `requires O: Ord[T]` is a NAMED requirement slot, and a named slot IS a type
-- parameter. So the chosen comparator is part of the type:
--
--   SortedSet[T = String, O = ByLength]  and  SortedSet[T = String, O = Alphabetical]
--
-- are two DIFFERENT types, and merging one into the other is a type error before it
-- is a wrong answer. Had the slot been left anonymous (`requires Ord[T]`, the
-- spelling `Map`/`Set` use for their `Eq`) it would be a CONSTRAINT — solved at each
-- dispatch, recorded nowhere — and two sets ordered differently would share one type.
-- That is right for `Map`'s `Eq` (two `Map[K = Int64]`s must not differ by which `Eq`
-- satisfied them) and wrong here. The author picks by naming it.
--
-- Choose the comparator at the CONSTRUCTION site, with the ordinary call bracket:
--
--   let a = SortedSet.empty[T = String, O = ByLength]()
--   let b = SortedSet.empty[T = String, O = Alphabetical]()
--   SortedSet.insert(a, "zz")            -- no bracket: `a`'s TYPE already says which
--   SortedSet.union(a, b)                -- type error, naming both orderings
--
-- ── THE SCOPE OF THE GUARANTEE: PER-SIGNATURE, NOT GLOBAL ────────────────────────
--
-- Omitting `O` in TYPE position means ANY, deliberately — it is how "I work for any
-- order" is written, and it is what lets a signature outlive a comparator choice:
--
--   operation tag(s: SortedSet[T = String]) -> Int64      -- takes BOTH of the above
--
-- So the merge safety above holds exactly where `O` is WRITTEN. A boundary that omits
-- it erases the distinction at that boundary; two sets that disagree can meet there.
-- This is not a hole to be closed later — `report[T, O](s: SortedSet[T = T, O = O])`
-- (the abstract, universally-polymorphic form) is how a consumer stays order-agnostic
-- AND keeps the distinction, and it is the form to prefer when the body dispatches
-- through the order at all.
--
-- AND OMITTING IT IS ONLY FREE FOR A BODY THAT NEVER DISPATCHES THROUGH THE SLOT
-- (WI-1094). One that does is REFUSED at that call, because there is nothing sound to
-- give it: the argument's order was chosen at its construction site and no dictionary
-- travels with a value, so anything supplied here answers for the SIGNATURE and not for
-- the value. Measured, in both directions it could go wrong — constructing a provider
-- reads a `Descending` set back ascending, and so does forwarding an ANONYMOUS
-- `requires Ord[T]` the consumer happens to declare. The repair is to name the slot and
-- write it: `first(s: SortedSet[T = E, O = OE])` on a sort declaring `requires
-- OE: Ord[E]`. The refusal does not depend on how many `Ord` providers are in scope.
--
-- ── WHAT IS NOT HERE ─────────────────────────────────────────────────────────────
--
-- A comparator chosen at RUN TIME does not exist as a concept (058 §7.1): every
-- witness is a sort declared in the program text, and a dictionary can only be copied
-- from one already chosen during typing. "Runtime choice" means which statically
-- pinned branch executed — ordinary universal polymorphism, the `report[T, O]` form
-- above. A HETEROGENEOUS collection of differently-ordered sets
-- (`List[T = SortedSet[T = String, O = ?]]`) is the general existential question,
-- neither needed nor foreclosed here. NOT WI-402, which is delivered and covers the
-- RETURN position only (`ensures Spec[C]`, a dictionary flowing out of an operation);
-- an existential in a TYPE-ARGUMENT position has no ticket.
--
-- ── ONE CAVEAT, AND IT IS NOT THIS FILE'S (WI-857) ───────────────────────────────
--
-- NAME a comparator. Leaving `O` out entirely — `SortedSet.empty[T = Int64]()` —
-- loads, and tier 2 resolves it to the carrier's own `Ord[Int64]` provider, but
-- then dies at eval with an arity mismatch. That is a pre-existing defect in how a
-- requirement dictionary is built from a CARRIER-KEYED provider (the producer walks
-- the provider's `requires` chain, the consumer names the frame from the SPEC's), and
-- it needs none of this file: a bare `sort H { sort T = ?  requires Eq[T] … }` fails
-- the same way. A comparator WITNESS sidesteps it, and naming one is the intended
-- spelling anyway.
--
-- (WI-857 fixed that arity mismatch, and WI-1094 changed what the omission MEANS at a
-- CONSTRUCTION site: `SortedSet.empty[T = Int64]()` now runs the §3.2 ladder and BINDS
-- `O` in the resulting type, so `s: SortedSet[T = Int64, O = Int64]` and every call
-- after it reads that back. Naming a comparator is still the spelling to prefer when
-- you mean a particular one — inference takes the carrier's own provision, which is
-- rarely what a program declaring a rival wants.)
--
-- ── EQUALITY ─────────────────────────────────────────────────────────────────────
--
-- Equality is EXTENSIONAL (WI-456): `provides PartialEq` / `Eq` at `SortedSet[T = T, O =
-- O]`, and `eq` compares the two sets' elements IN ORDER through the ELEMENT's own
-- `PartialEq` — so a set whose elements are themselves compared semantically compares
-- that way all the way down. STRUCTURE IS NOT THE ANSWER and `===` must not be used for
-- it: a weight-balanced tree's SHAPE depends on the order its elements arrived in, so
-- `{1, 2, 3}` built two ways is one set in two shapes. (The list this replaced was
-- canonical under an `Ord`, and structural equality was right for it; that is the one
-- property the tree gives up, and providing `eq` is what pays for it.)
--
-- How much that equality can see depends on `O` (WI-1109).
--
-- WHERE `O`'s KERNEL IS `Eq` — an `Ord` comparator — equal in order is equal as sets of
-- ELEMENTS: two sets with the same members are `=`.
--
-- WHERE IT IS COARSER — any `WeakOrd` that is not an `Ord`, which is what the slot
-- permits and what a key-based comparator is — THIS SET STORES EQUIVALENCE CLASSES, and
-- one member of each class SURVIVES. Which one is observable: MEASURED under a
-- by-length comparator, `{"zz","aa","b"}` has TWO elements, and
--
--     union({"zz"}, {"aa"}) = ["zz"]     union({"aa"}, {"zz"}) = ["aa"]
--
-- — and `eq` sees the survivor, so those two are NOT `=`. THE RULE, and it is contract
-- rather than discovery: `insert` keeps the INCUMBENT and `union` keeps the LEFT
-- operand's representative, so `union` is NOT commutative under a coarse kernel. A
-- consumer that needs a set of ELEMENTS rather than of classes writes `requires O:
-- Ord[T]` and gets it checked.
--
-- Nothing is claimed about comparing across two `O`s — they are different types.
--
-- ── AND NO `provides Set` EITHER, deliberately ───────────────────────────────────
--
-- `Set` (`set.anthill`) demands `member` / `subset` / `intersection` / `difference`,
-- which this type does not have. The `empty`/`insert`/`union`/`eq` overlap is surface.
--
-- ── THE GENERIC COLLECTION SURFACE (WI-456) ──────────────────────────────────────
--
-- `Iterable` / `FiniteCollection` / `PersistentCollection` ARE provided, and each head
-- writes the ordering: `C = SortedSet[T = T, O = O]`. That is what makes a call through
-- the spec keep the set's comparator —
--
--   PersistentCollection.insert(a, "zz")    -- `a: SortedSet[T = String, O = ByLength]`
--
-- — because the provision match binds `O` from `a`'s type, and the sub-goal for
-- `requires O: WeakOrd[T]` is then pinned to it rather than searched. Before WI-456 that
-- search tied among every `WeakOrd[String]` in scope, so the call was refused in exactly
-- the programs this type exists for: the ones holding two orderings.
--
-- A SPEC'S DEFAULT BODY REACHES THIS SORT'S MEMBERS THROUGH ITS PROVISION'S DICTIONARY
-- (WI-20260921-R10KC). This paragraph used to say the opposite — that such a body reached
-- `collect` / `iterator` by VALUE, that a value carries no `O`, and that an operation here
-- which COMPARES must therefore stay reachable only through a TYPED call, being otherwise
-- REFUSED (`NamedSlotNotCarried`). That was true, and it was a defect rather than a
-- constraint: the dictionary was BUILT at the call site and then dropped before the frame
-- that reads it. A default body now receives it and resolves a body-less sibling by
-- PROJECTION out of it, so the slot is read rather than searched, and an operation here
-- that compares is reachable through either route.
--
-- WHAT STILL IS NOT REACHABLE, and the boundary is narrow: a route with NO STATIC TYPE to
-- build a dictionary from. An EXISTENTIAL RETURN opened to a rigid skolem names no
-- provider, so the read is refused as before; a HOST `interp.call` is served by
-- value-direction, which answers from the ARGUMENTS; and the SLD bridge keeps the tie a
-- verdict and residualizes. `wi_r10kc_spec_default_body_dictionary_test` drives each.
--
-- (The value-carried dictionary this note used to defer to is not what closed it. Nothing
-- here needs one: `tip` stays nullary, `bin` stays the set with no root wrapper, `eq` here
-- stays extensional, and the discrimination tree still indexes structure. The remaining
-- half of that question — whether a signature that OMITS the slot may be handed the
-- argument's own dictionary, so `O` and `s.O` mean one thing — is WI-20260921-EE0EP.)
enum anthill.prelude.SortedSet
  import anthill.prelude.{WeakOrd, PartialEq, Eq, List, Int64, Bool, Stream, Iterable,
                          FiniteCollection, PersistentCollection}
  import anthill.prelude.List.{nil, cons}
  import anthill.prelude.PartialOrd.{lt, gt, lte}
  import anthill.prelude.Additive.{add}
  import anthill.prelude.Multiplicative.{mul}

  sort T = ?                                   -- element type
  requires O: WeakOrd[T]                       -- NAMED ⇒ a parameter of the type

  -- Walked in ascending order under `O`: the materialized item list is the Stream.
  -- `iterator` / `collect` MATERIALIZE, where the list this replaced returned its stored
  -- list: O(n) and n conses, paid by every spec default that reads through them. The two
  -- questions a tree answers without walking — `size` and `isEmpty` — are overridden
  -- below (WI-444) so those defaults do not pay it.
  provides Iterable[C = SortedSet[T = T, O = O], Element = T, E = {}]
  operation iterator(s: SortedSet[T = T, O = O]) -> Stream[T = T, E = {}] = toList(s)

  operation isEmpty(s: SortedSet[T = T, O = O]) -> Bool =
    match s
      case tip() -> true
      case bin(_, _, _, _) -> false

  provides FiniteCollection[C = SortedSet[T = T, O = O], Element = T, E = {}]
  operation collect(s: SortedSet[T = T, O = O]) -> List[T = T] = toList(s)

  -- `empty` / `insert` below are the provision's operations.
  provides PersistentCollection[C = SortedSet[T = T, O = O], Element = T]

  -- EXTENSIONAL, because the tree is not canonical — see EQUALITY above.
  --
  -- WRITTEN IN THE PROVISION (proposal 066), exactly as `Pair`'s `eq` is: `eq` and its
  -- worker read `PartialEq[T]`, so they sit in the block whose condition supplies it. An
  -- operation written outside every block sees no condition at all, and would have taken
  -- the ELEMENT's `PartialEq` through the ORDERING's chain instead — `requires O:
  -- WeakOrd[T]` carries `Eq[T]` (ordered.anthill), so the condition below cannot fail and
  -- the misplacement would have resolved silently.
  --
  -- SIZE FIRST, which is what makes an unequal comparison free: the trees carry their
  -- counts, so two sets of different size are decided without materializing either.
  provides PartialEq[T = SortedSet[T = T, O = O]] :- PartialEq[T] where
    operation eq(a: SortedSet[T = T, O = O], b: SortedSet[T = T, O = O]) -> Bool =
      if PartialEq.eq(size(a), size(b)) then sameElements(toList(a), toList(b)) else false

  end

  provides Eq[T = SortedSet[T = T, O = O]] :- Eq[T]

  -- A WEIGHT-BALANCED tree (Adams; the `Data.Set` parameters δ = 3, ratio = 2, which
  -- Hirai & Yamamoto proved are the one integer pair that keeps this `balance` sound).
  -- `n` is the node's element count, so `size` is O(1) and every rebalancing decision
  -- reads it. Ascending under `O` in order, no two elements in one class — the invariant
  -- every producer below maintains.
  --
  -- THE CONSTRUCTORS ARE REACHABLE AND `n` IS NOT DERIVED: §8.6 leaks an enum's
  -- constructors, so `bin(n: 99, elem: 1, left: tip(), right: tip())` is writable from
  -- outside and makes `size` lie and every balance decision read a false weight. The list
  -- this replaced was forgeable the same way (an unsorted `items`), and deriving `n`
  -- instead of storing it would cost `size` and each balance test their O(1).
  --
  -- THE GATE EXISTS — an earlier version of this comment said it did not, and that was
  -- STALE. `internal entity` is the language's only hide gate (§8.6, WI-20260914-Z73FX),
  -- and it is MEASURED to close exactly this: marking the two constructors `internal`
  -- refuses `bin(n: 99, …)` from a sibling sort at LOAD, while the sort's own operations
  -- keep matching on them. What is missing is the DECISION, not the mechanism, and it is
  -- not free: it is visible in the surface, since it also forbids an outside `match` on a
  -- set's shape, which is the same reach a `case bin(…)` in a consumer relies on.
  entity tip
  entity bin(n: Int64, elem: T, left: SortedSet[T = T, O = O], right: SortedSet[T = T, O = O])

  operation empty() -> SortedSet[T = T, O = O] = tip()

  operation size(s: SortedSet[T = T, O = O]) -> Int64 =
    match s
      case tip() -> 0
      case bin(n, _, _, _) -> n

  -- O(log n). A new element in an existing CLASS under `O` leaves the INCUMBENT (see
  -- EQUALITY above); the set's members are unchanged, though the spine back to the root
  -- is rebuilt — `Data.Set` skips that with a pointer-equality check this has no way to
  -- write.
  operation insert(s: SortedSet[T = T, O = O], x: T) -> SortedSet[T = T, O = O] =
    match s
      case tip() -> node(x, tip(), tip())
      case bin(_, y, l, r) ->
        let c = WeakOrd.compare(x, y)
        if lt(c, 0) then balance(y, insert(l, x), r)
        else if gt(c, 0) then balance(y, l, insert(r, x))
        else s

  -- Divide and conquer (Adams' `union`): split `b` around `a`'s root and rejoin. `a`'s
  -- root survives and `b`'s element in its class is dropped by the split, which is what
  -- makes `union` LEFT-BIASED (see EQUALITY above). O(m·log(n/m + 1)) for m ≤ n, TIMES A
  -- CONSTANT 2 this spelling pays and Adams' does not: `below` and `above` are two walks
  -- of `b` where one `split` returning both halves would do. Closing it wants a `Pair`
  -- of sets threaded through the recursion, which is a change to make with its own
  -- measurement rather than inside this one.
  operation union(a: SortedSet[T = T, O = O],
                  b: SortedSet[T = T, O = O]) -> SortedSet[T = T, O = O] =
    match a
      case tip() -> b
      case bin(_, x, l, r) ->
        match b
          case tip() -> a
          case bin(_, _, _, _) -> link(x, union(l, below(b, x)), union(r, above(b, x)))

  operation toList(s: SortedSet[T = T, O = O]) -> List[T = T] = toListOnto(s, nil())

  -- ── the implementation ──────────────────────────────────────────────────────────
  --
  -- Members rather than locals because Anthill has no local recursive binding, and
  -- `internal` because they are the implementation and not the interface — the modifier
  -- `list.anthill`'s own workers (`reverseOnto`, `mapElemsOnto`) carry for the same
  -- reason. Every one takes a `SortedSet[T = T, O = O]` or is called only from inside the
  -- sort, so each inherits the enclosing frame's `O` dictionary.

  -- `eq`'s worker, and it carries its own evidence: a `where` block holds the SPEC's own
  -- members (proposal 066), and `sameElements` is none of `PartialEq`'s — so the element
  -- comparator reaches it through an OP-SCOPED `requires`, filled at the call `eq` makes
  -- from that provision's condition.
  --
  -- Equal LENGTH by `eq`'s size guard, so running out of `xs` means running out of both.
  internal operation sameElements(xs: List[T = T], ys: List[T = T]) -> Bool
      requires PartialEq[T] =
    match xs
      case nil() -> true
      case cons(x, xt) ->
        match ys
          case nil() -> false
          case cons(y, yt) -> if PartialEq.eq(x, y) then sameElements(xt, yt) else false

  internal operation toListOnto(s: SortedSet[T = T, O = O], acc: List[T = T]) -> List[T = T] =
    match s
      case tip() -> acc
      case bin(_, x, l, r) -> toListOnto(l, cons(head: x, tail: toListOnto(r, acc)))

  -- A node over two subtrees already balanced against each other.
  internal operation node(x: T, l: SortedSet[T = T, O = O],
                          r: SortedSet[T = T, O = O]) -> SortedSet[T = T, O = O] =
    bin(n: add(add(size(l), size(r)), 1), elem: x, left: l, right: r)

  -- Restore the weight invariant after ONE side changed by one element (an `insert`), or
  -- by `link`'s one step. δ = 3: a side more than three times the other rotates.
  internal operation balance(x: T, l: SortedSet[T = T, O = O],
                             r: SortedSet[T = T, O = O]) -> SortedSet[T = T, O = O] =
    let sl = size(l)
    let sr = size(r)
    if lte(add(sl, sr), 1) then node(x, l, r)
    else if gt(sr, mul(3, sl)) then rotateLeft(x, l, r)
    else if gt(sl, mul(3, sr)) then rotateRight(x, l, r)
    else node(x, l, r)

  -- ratio = 2: the heavy side's INNER subtree decides between a single and a double
  -- rotation. The `tip()` arms are unreachable — `balance` rotates toward a side only
  -- when it outweighs the other more than threefold, so that side, and for the double
  -- rotation its inner subtree, is non-empty. They are written as the single rotation of
  -- the same node (the OUTER one rebuilds it unrotated), and a rotation moves nodes
  -- without reordering them: reached anyway, they would change the tree's BALANCE and
  -- never its contents or their order. That is why they are not a refusal — there is no
  -- wrong answer to guard against, and raising here would put an `Error` row on every
  -- operation of this sort.
  internal operation rotateLeft(x: T, l: SortedSet[T = T, O = O],
                                r: SortedSet[T = T, O = O]) -> SortedSet[T = T, O = O] =
    match r
      case tip() -> node(x, l, r)
      case bin(_, y, ly, ry) ->
        if lt(size(ly), mul(2, size(ry))) then node(y, node(x, l, ly), ry)
        else
          match ly
            case tip() -> node(y, node(x, l, ly), ry)
            case bin(_, z, lz, rz) -> node(z, node(x, l, lz), node(y, rz, ry))

  internal operation rotateRight(x: T, l: SortedSet[T = T, O = O],
                                 r: SortedSet[T = T, O = O]) -> SortedSet[T = T, O = O] =
    match l
      case tip() -> node(x, l, r)
      case bin(_, y, ly, ry) ->
        if lt(size(ry), mul(2, size(ly))) then node(y, ly, node(x, ry, r))
        else
          match ry
            case tip() -> node(y, ly, node(x, ry, r))
            case bin(_, z, lz, rz) -> node(z, node(y, ly, lz), node(x, rz, r))

  -- Join `l < x < r` of ANY relative sizes: descend the heavier side until the two are
  -- within δ of each other, then rebalance on the way back up.
  internal operation link(x: T, l: SortedSet[T = T, O = O],
                          r: SortedSet[T = T, O = O]) -> SortedSet[T = T, O = O] =
    match l
      case tip() -> insertMin(x, r)
      case bin(sl, y, ly, ry) ->
        match r
          case tip() -> insertMax(x, l)
          case bin(sr, z, lz, rz) ->
            if lt(mul(3, sl), sr) then balance(z, link(x, l, lz), rz)
            else if lt(mul(3, sr), sl) then balance(y, ly, link(x, ry, r))
            else node(x, l, r)

  -- `x` below every element of `s` / above every element — no comparison needed.
  internal operation insertMin(x: T, s: SortedSet[T = T, O = O]) -> SortedSet[T = T, O = O] =
    match s
      case tip() -> node(x, tip(), tip())
      case bin(_, y, l, r) -> balance(y, insertMin(x, l), r)

  internal operation insertMax(x: T, s: SortedSet[T = T, O = O]) -> SortedSet[T = T, O = O] =
    match s
      case tip() -> node(x, tip(), tip())
      case bin(_, y, l, r) -> balance(y, l, insertMax(x, r))

  -- The elements of `s` strictly below / strictly above `x` under `O`. An element in
  -- `x`'s own class is in NEITHER — which is how `union` drops `b`'s representative.
  internal operation below(s: SortedSet[T = T, O = O], x: T) -> SortedSet[T = T, O = O] =
    match s
      case tip() -> s
      case bin(_, y, l, r) ->
        let c = WeakOrd.compare(x, y)
        if lt(c, 0) then below(l, x)
        else if gt(c, 0) then link(y, l, below(r, x))
        else l

  internal operation above(s: SortedSet[T = T, O = O], x: T) -> SortedSet[T = T, O = O] =
    match s
      case tip() -> s
      case bin(_, y, l, r) ->
        let c = WeakOrd.compare(x, y)
        if lt(c, 0) then link(y, above(l, x), r)
        else if gt(c, 0) then above(r, x)
        else r
end
