-- Map: abstract key-value association (requires Eq on keys)
sort anthill.prelude.Map
  import anthill.prelude.{Option, List, Pair, Bool, Int64, Eq, PartialEq, Iterable, FiniteCollection, Stream}
  -- WI-20260825-KD9SW: a WRITTEN bare `eq`/`neq` (an effect guard, a law) names the
  -- operation by import now; a minted `=`/`!=` carries its own address and needs nothing.
  import anthill.prelude.PartialEq.{neq}
  -- WI-909: the constructors left the implicit tier, so a bare `some` / `none` takes a
  -- member import. Importing the SORT does not bring its members into scope (§8.6),
  -- and a constructor in a HEAD ARGUMENT has no loud check — see the driven case at
  -- `stdlib/anthill/reflect/typing.anthill`.
  import anthill.prelude.Option.{some, none}

  sort K = ?
  sort V = ?
  -- WI-835: this clause is ENFORCED at every written `Map[K = …]` — binding `K` to a
  -- carrier that provides `NonEq` (IEEE `Float`, or a Float-containing composite via
  -- WI-664) is a LOAD error naming the sort, `K`, the carrier and `Eq`. Use
  -- `TotalFloat` for float keys. It is a NEGATIVE check (a witnessed `NonEq`, not a
  -- missing `Eq`): WI-616's universal structural default would make the positive
  -- reading vacuous, and no `Eq` fact is derived for a lawful all-`Eq` composite.
  -- NOT total: the check reads `K`'s OWN provisions, so a key whose unlawfulness is
  -- in its ARGUMENT (`Map[K = List[T = Float]]`) still loads — WI-664's parametric-
  -- container propagation follow-up.
  requires Eq[T = K]

  -- WI-616 / WI-650 / WI-644: Map is a NON-STRUCTURAL Eq carrier — map equality is
  -- same-domain + `Eq`-equal values at every key over the symbolic `put`/`empty`
  -- algebra (put-ORDER of distinct keys is irrelevant; a later `put` of the same key
  -- SHADOWS the earlier one) — a semantics no cheap terminating set of relational SLD
  -- rules computes. The earlier version carried an O(n²) `map_eq`/`binds`/`strip_is`
  -- apparatus (the Set precedent); WI-650 dropped it in favor of the WI-625 host bridge
  -- (a hashed, host-bodied `eq`), the right home for it.
  --
  -- WI-644 / proposal 004: Map's extensional equality is lawful, so Map provides the
  -- total marker `Eq` AND its `PartialEq` base (`Eq requires PartialEq`); both resolve
  -- to the single own `eq` below.
  --
  -- The provisions DECLARE the instance and LOAD: the spec op `PartialEq.eq` is a
  -- resolver builtin, so the provider-operations check (WI-343) counts the provision
  -- backed. The bodyless `operation eq(a: Map, b: Map)` below is the WI-350/WI-444
  -- short-name override slot the bridge will fill. Until then that override has NO
  -- backing (no rules, no runnable body), so a `=`/`eq` over two `Map`s would SILENTLY
  -- misdecide at resolution (`sem_eq_dispatch` sub-resolves the empty override,
  -- exhausts, and returns "not equal"). `BuiltinResult` has no error channel, so the
  -- typer names it loudly instead: `check_eq_override_backing` (typing.rs, WI-650)
  -- rejects a rule/op body comparing two Maps with `=`/`eq` at LOAD with `Eq[Map]
  -- declared but unimplemented`. The stdlib never compares maps, so it stays clean;
  -- only user code does. The sibling `neq(map, map)` misdecide is the SAME hazard and
  -- is caught the same way — `check_eq_override_backing` matches `PartialEq.neq` too
  -- (post-WI-644 the `eq`/`neq` ops live on `PartialEq`), and both operands of a `neq`
  -- over two Maps are stamped `Map` by the same WI-603 inference `eq` uses (WI-651
  -- confirmed neq does NOT escape; its own key comparison `neq(?k, ?k2)` below is
  -- correctly typed `K`, not `Map`, and not flagged). Structural comparison is `===`.
  provides PartialEq[T = Map]
  provides Eq[T = Map]
  operation eq(a: Map, b: Map) -> Bool

  -- WI-495: a Map is a GENUINE non-Stream Iterable — it can be walked (produces
  -- a Stream of its entries) but is NOT itself a Stream (it has no `splitFirst`
  -- primitive; a hash/tree map is not a linear sequence). So unlike List /
  -- MappedStream / FilteredStream — which provide Stream and derive Iterable
  -- transitively with an IDENTITY iterator — Map declares `provides Iterable`
  -- EXPLICITLY, with a NON-identity `iterator` that materializes the entries as
  -- a List (which provides Stream, so it is admissible as the produced Stream).
  -- This is exactly the carrier the Iterable≠Stream split exists for (proposal
  -- library/002: "Iterable PRODUCES an iterator, Iteration/Stream IS one").
  provides Iterable[C = Map, Element = Pair[A = K, B = V], E = {}]
  operation iterator(m: Map) -> Stream[T = Pair[A = K, B = V], E = {}] = entries(m)

  -- Map provides FiniteCollection (WI-585): a Map is finite, so it can be fully
  -- consumed. `collect` materializes the entries as a List (which is the
  -- finiteness primitive's List form); `size`/`foldLeft`/`foldRight` come from
  -- the FiniteCollection defaults — except `size`, which Map supplies itself: see the
  -- `size` note below.
  provides FiniteCollection[C = Map, Element = Pair[A = K, B = V], E = {}]
  operation collect(m: Map) -> List[T = Pair[A = K, B = V]] = entries(m)

  -- WI-599: the `finiteIterator` finite cursor is GONE. The thin finite
  -- combinators wrap the bare carrier directly (Map.map / Map.filter, inherited
  -- from FiniteCollection, are `mapped(m, f)` / `filtered(m, p)`), so no
  -- `finiteIterator` indirection is needed — a Map provides Iterable, the
  -- combinator source-field type, and provides FiniteCollection, which is what the
  -- combinator's finiteness witness requires of the source (WI-590).

  -- Construction
  operation empty() -> Map @[host_implemented]
  operation put(m: Map, key: K, value: V) -> Map @[host_implemented]

  -- Lookup
  operation get(m: Map, key: K) -> Option[V] @[host_implemented]
  operation contains(m: Map, key: K) -> Bool @[host_implemented]

  -- Removal
  operation remove(m: Map, key: K) -> Map @[host_implemented]

  -- Projections
  operation keys(m: Map) -> List[T = K] @[host_implemented]
  operation values(m: Map) -> List[T = V] @[host_implemented]
  operation entries(m: Map) -> List[T = Pair[A = K, B = V]] @[host_implemented]
  -- Map's OWN O(1) size. Note (WI-444): now that Map provides FiniteCollection,
  -- the inherited `FiniteCollection.size` default (an O(N) `List.length(collect(m))`
  -- walk) shares this short name. The carrier override (WI-444) takes an own op the
  -- interpreter can RUN (`op_is_interpretable`), and since WI-20260922-BRT4Y this one is
  -- a declared host operation with a rust `operation_map` entry — it was registered by
  -- hardcoded name before, invisible to that gate, so the spec-op call ran the default
  -- walk. MEASURED after the move: `FiniteCollection.size(m)` and `Map.size(m)` both run
  -- this host `size`. Same answer either way; the difference is O(1) against O(N).
  operation size(m: Map) -> Int64 @[host_implemented]

  -- Laws (algebraic specification). The genuinely-reducing laws are tagged @[simp] so
  -- the type-directed rewriter fires them once the redex's carrier is known to provide
  -- Map (WI-596; the sort-level `requires Eq[T = K]` rides on that provides fact).
  --
  -- WI-20260820-8RJK8: the `get(put(m,k2,v),k)` law is tagged TOO, and its `:- neq(k, k2)`
  -- guard is now what it always read as — a CONDITIONAL rewrite, the guard proved at the
  -- redex after the left-hand side matches. It was left untagged before because every
  -- firing site demanded an empty body, which made it dead beside the `<=>` siblings it is
  -- written under. It reduces (`get(put(m, …), k)` → `get(m, k)` strips one `put`), so
  -- orienting it terminates. Its firing still needs a carrier that provides Map, exactly
  -- as its siblings do.
  -- The nullary constructors below are written `none()` / `empty()`: while the tag was
  -- a bare `[simp]`, `<=> none [simp]` parsed as the instantiation `none[simp]`.
  -- `@[` begins no instantiation (WI-20260915-G9EA9), so the bare RHS is equally safe.
  rule get(empty, ?) <=> none() @[simp]
  rule get(put(?m, ?k, ?v), ?k) <=> some(?v) @[simp]
  rule get(put(?m, ?k2, ?v), ?k) = get(?m, ?k)
    :- neq(?k, ?k2)   @[simp]

  rule contains(?m, ?k) <=> neq(get(?m, ?k), none) @[simp]

  rule remove(empty, ?) <=> empty() @[simp]
  rule get(remove(?m, ?k), ?k) <=> none() @[simp]

  rule size(empty) <=> 0 @[simp]
end
