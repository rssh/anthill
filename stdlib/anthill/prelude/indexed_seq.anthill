-- IndexedSeq: bounded random-access into a sequential container.
-- Carrier = the container; Element = what `nth` returns inside Option.
-- Cost is implementation-defined: List's `nth` is O(N), Vec's is O(1).
-- A future RandomAccess sub-spec can refine this with the O(1)
-- guarantee when consumers need it.
sort anthill.prelude.IndexedSeq
  import anthill.prelude.{Int64, Option}
  import anthill.prelude.Option.{none}
  import anthill.prelude.PartialOrd.{lt, gte}

  sort C = ?
  sort T = ?
  sort Effect = ?

  operation {
    length(xs: C) -> Int64
    nth(xs: C, i: Int64) -> Option[T]
  }

  -- Out-of-bounds indices yield none. Both bounds are stated; the
  -- upper bound uses `length` (also part of IndexedSeq).
  -- Implementations are free to match these rules directly or treat
  -- them as a contract on top of their own clauses.
  --
  -- WI-20260820-8RJK8: both are `[simp]`, so they now FIRE as conditional rewrites —
  -- the guard is proved at the redex and decides. They qualify because the right-hand
  -- side is a constant, so orienting them terminates trivially. `nth_oob_lo`'s
  -- `lt(?i, 0)` is an ordinary builtin over the index and discharges on any concrete
  -- one; it is driven to a value in `wi_8rjk8_guarded_equation_fires_test`.
  -- `nth_oob_hi` needs `length(?xs)` to RUN, which on a bare spec-op term needs the
  -- carrier's dictionary — WI-567's wall — and MEASURED, it does not discharge there
  -- (`nth(nil, 0)` is left standing, asserted in that same test). It is tagged anyway
  -- because the two are one statement of the same contract and an undischargeable guard
  -- DECLINES rather than misfiring; no context that discharges it has been driven.
  rule {
    nth_oob_lo: nth(?_, ?i)   = none :- lt(?i, 0)   [simp]
    nth_oob_hi: nth(?xs, ?i)  = none :- gte(?i, length(?xs))   [simp]
  }
end
