-- Bool: abstract spec for the built-in boolean sort.
-- Spec satisfaction fact (Eq[Bool]) lives in the per-language binding files
-- (e.g. rustland/anthill-stl/anthill/bool.anthill) — see proposal 038.
sort anthill.prelude.Bool
  import anthill.prelude.{Eq}

  -- Every operation declared here is backed by a host builtin. `ite` is NOT declared
  -- as one — see its own rule block below.
  operation {
    and(a: Bool, b: Bool) -> Bool
    or(a: Bool, b: Bool) -> Bool
    not(a: Bool) -> Bool
  }

  -- Laws: Boolean algebra
  rule {
    -- identity
    and_true:   and(true, ?a) = ?a
    or_false:   or(false, ?a) = ?a
    -- annihilation
    and_false:  and(false, ?_) = false
    or_true:    or(true, ?_) = true
    -- complement
    not_true:   not(true) = false
    not_false:  not(false) = true
    -- double negation
    not_not:    not(not(?a)) = ?a
    -- commutativity
    and_comm:   and(?a, ?b) = and(?b, ?a)
    or_comm:    or(?a, ?b) = or(?b, ?a)
    -- de Morgan
    demorgan_and: not(and(?a, ?b)) = or(not(?a), not(?b))
    demorgan_or:  not(or(?a, ?b)) = and(not(?a), not(?b))
  }

  -- if-then-else. `ite` IS NOT AN OPERATION, and cannot be one AT THIS SIGNATURE:
  -- `then` and `else` are VALUES of type `?A`, and a call evaluates its arguments, so
  -- both branches would be computed. An operation form would have to take THUNKS —
  -- `ite(cond: Bool, then: () -> A, else: () -> A) -> A` — which is a DIFFERENT
  -- operation with different call sites, not this one. So no operation is the only
  -- correct form: as a rewrite the untaken branch is discarded structurally and never
  -- evaluated, and these two rules are `ite`'s whole definition — they introduce the
  -- functor. `if`/`then`/`else` is the operation-body form.
  --
  -- They fire on a literal condition. That is the whole reach and it is enough: the
  -- functor's other consumer is smt-gen's `(ite c t e)`, which wants the condition left
  -- symbolic and no reduction at all.
  rule {
    ite_true:   ite(true, ?t, ?_) = ?t [simp]
    ite_false:  ite(false, ?_, ?e) = ?e [simp]
  }
end
