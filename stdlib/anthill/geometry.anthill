-- Geometry: shared spatial value types.
--
-- Today: Vec3, EulerAngles. Quaternion + 3D rotation operations are
-- the eventual landing target for WI-081; they will join this
-- namespace when authored.
--
-- ── Snapshot semantics for codegen consumers ─────────────────────────
-- These value types are *snapshots*. When a C++ binding returns a
-- pointer into vendor-managed memory (e.g. webots's
-- `const double *` from `Robot::getDevice(...)->getValues()`), the
-- generated wrapper copies into a fresh Vec3 at call time so the
-- anthill-side struct outlives the next step / sensor read.
namespace anthill.geometry
  import anthill.prelude.{Float}
  -- Vec3 does NOT currently provide the VectorSpace spec. It is one
  -- mathematically — the relational rules below are exactly a vector
  -- space's operations — but the spec's members are FUNCTIONAL
  -- (`vec_add(a, b) -> V`) and nothing here backs them, so the claim
  -- was withdrawn rather than certified (WI-931). WI-935 restores it.
  -- See the note above `entity Vec3` for the collision that blocks the
  -- obvious fix.

  -- 3-vector for spatial quantities (position, velocity, direction,
  -- angular velocity in body frame). Field names are world / body
  -- axes.
  --
  -- NO `vec_add` / `vec_sub` / `vec_scale` / `vec_zero` OPERATIONS ON `Vec3`,
  -- and the reason is a MEASURED name collision, not a missing implementation
  -- (WI-931 → WI-935).
  --
  -- Giving `Vec3` those four members is what would back `fact VectorSpace[Vec3,
  -- Float]` — a rule is not backing (WI-818), so the relational clauses below
  -- cannot. They were written, and they worked; what they also did was SILENTLY
  -- re-target the imported short name. MEASURED, on a rule body doing
  -- `import anthill.geometry.{vec_add}` and calling `vec_add(a, b, ?c)`: ONE
  -- solution before, ZERO after — the bare name binds to the new `Vec3.vec_add/2`
  -- instead of the relational `anthill.geometry.vec_add/3`, and nothing reports
  -- it. (The fully qualified `anthill.geometry.vec_add` still resolves, so the
  -- rules themselves are intact; it is the short name that moves.) Trading a
  -- working relational surface for an unused provision is the wrong way round,
  -- so the provision is withdrawn instead — see the host-closure file.
  entity Vec3(x: Float, y: Float, z: Float)

  -- Orientation as Euler angles, radians. Field order matches the
  -- webots InertialUnit convention (roll, pitch, yaw). Distinguishing
  -- this from Vec3 prevents spatial-vs-orientation reads from being
  -- aliased through identical component names.
  entity EulerAngles(roll: Float, pitch: Float, yaw: Float)

  -- ================================================================
  -- Vec3 vector operations
  -- ================================================================
  --
  -- The RELATIONAL spelling, for Z3. Result var is last positional arg
  -- per smt-gen convention; bodies are fully ground arithmetic on Float
  -- components — Z3 LRA evaluates them when the consumer supplies Vec3
  -- destructure. The algebraic laws below are written against THIS arity,
  -- which is why it stays.
  --
  -- It is NOT what satisfies `fact VectorSpace[Vec3, Float]`: a rule is not
  -- backing (WI-818), and these are `vec_add/3` where the spec declares
  -- `vec_add(a, b) -> V`. The runnable half is the operation bodies on
  -- `sort Vec3` above (WI-931), and the two must agree — they are the same
  -- per-component arithmetic written twice, once for each consumer.
  --
  -- The lift to a generic VectorSpace[V, S] spec happened (WI-138,
  -- anthill.prelude.algebra); what has not is rewriting these laws against
  -- the abstract V so proof-side reasoning stops pinning the per-component
  -- shape.

  -- Vector addition: c = a + b (componentwise).
  rule vec_add(?a, ?b, ?c)
    :- ?a = Vec3(x: ?ax, y: ?ay, z: ?az),
       ?b = Vec3(x: ?bx, y: ?by, z: ?bz),
       ?c = Vec3(x: ?ax + ?bx, y: ?ay + ?by, z: ?az + ?bz)

  -- Vector subtraction: c = a - b (componentwise).
  rule vec_sub(?a, ?b, ?c)
    :- ?a = Vec3(x: ?ax, y: ?ay, z: ?az),
       ?b = Vec3(x: ?bx, y: ?by, z: ?bz),
       ?c = Vec3(x: ?ax - ?bx, y: ?ay - ?by, z: ?az - ?bz)

  -- Scalar multiplication: w = c * v.
  rule vec_scale(?c, ?v, ?w)
    :- ?v = Vec3(x: ?vx, y: ?vy, z: ?vz),
       ?w = Vec3(x: ?c * ?vx, y: ?c * ?vy, z: ?c * ?vz)

  -- Additive identity. Used as `vec_zero(?z)` to bind `?z` to the
  -- zero vector — the relational form lets it appear in rule bodies
  -- without needing a function-call shape.
  rule vec_zero(?z)
    :- ?z = Vec3(x: 0.0, y: 0.0, z: 0.0)

  -- ================================================================
  -- Algebraic laws
  -- ================================================================
  --
  -- Each law is a citable rule with explicit `-:` conclusion. They
  -- discharge trivially through Z3's per-component Float arithmetic
  -- (LRA — no nonlinear terms in commutativity/associativity/etc.;
  -- distributivity has a single multiplication per component, still
  -- in QF_NRA-friendly form).

  -- Commutativity of vector addition: a + b = b + a.
  rule vec_add_comm:
    vec_add(?a, ?b, ?c1),
    vec_add(?b, ?a, ?c2)
    -: ?c1 = ?c2

  -- Associativity of vector addition: (a + b) + c = a + (b + c).
  rule vec_add_assoc:
    vec_add(?a, ?b, ?ab),
    vec_add(?ab, ?c, ?lhs),
    vec_add(?b, ?c, ?bc),
    vec_add(?a, ?bc, ?rhs)
    -: ?lhs = ?rhs

  -- Additive identity: a + zero = a.
  rule vec_add_identity:
    vec_zero(?z),
    vec_add(?a, ?z, ?result)
    -: ?result = ?a

  -- Subtraction is addition of negation: a - b = a + (-1)·b.
  rule vec_sub_def:
    vec_sub(?a, ?b, ?lhs),
    vec_scale(-1.0, ?b, ?neg_b),
    vec_add(?a, ?neg_b, ?rhs)
    -: ?lhs = ?rhs

  -- Distributivity of scalar over vector sum: c·(a + b) = c·a + c·b.
  rule vec_scale_distrib_v:
    vec_add(?a, ?b, ?ab),
    vec_scale(?c, ?ab, ?lhs),
    vec_scale(?c, ?a, ?ca),
    vec_scale(?c, ?b, ?cb),
    vec_add(?ca, ?cb, ?rhs)
    -: ?lhs = ?rhs

  -- Distributivity of scalar sum over vector: (c + d)·v = c·v + d·v.
  rule vec_scale_distrib_s:
    ?cd = ?c + ?d,
    vec_scale(?cd, ?v, ?lhs),
    vec_scale(?c, ?v, ?cv),
    vec_scale(?d, ?v, ?dv),
    vec_add(?cv, ?dv, ?rhs)
    -: ?lhs = ?rhs

  -- Associativity of scalar multiplication: c·(d·v) = (c·d)·v.
  rule vec_scale_assoc:
    vec_scale(?d, ?v, ?dv),
    vec_scale(?c, ?dv, ?lhs),
    ?cd = ?c * ?d,
    vec_scale(?cd, ?v, ?rhs)
    -: ?lhs = ?rhs

  -- Scalar identity: 1·v = v.
  rule vec_scale_identity:
    vec_scale(1.0, ?v, ?result)
    -: ?result = ?v
end
