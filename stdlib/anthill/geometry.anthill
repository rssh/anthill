-- Geometry: shared spatial value types.
--
-- Today: Vec3, EulerAngles. Quaternion + 3D rotation operations are
-- the eventual landing target for WI-081; they will join this
-- namespace when authored.
--
-- ── Snapshot semantics for codegen consumers ─────────────────────────
-- These value types are *snapshots*. When a C++ binding returns a
-- pointer into vendor-managed memory (e.g. webots's
-- `const double *` from `Robot::getDevice(...)->getValues()`), the
-- generated wrapper copies into a fresh Vec3 at call time so the
-- anthill-side struct outlives the next step / sensor read.
namespace anthill.geometry
  import anthill.prelude.{Float}

  -- 3-vector for spatial quantities (position, velocity, direction,
  -- angular velocity in body frame). Field names are world / body
  -- axes.
  --
  -- `sort Vec3` with an eponymous constructor: the sort and the entity
  -- are ONE symbol (§6.3, WI-926). The four members below are the
  -- functional implementations of `anthill.prelude.algebra.VectorSpace`
  -- at `[V = Vec3, F = Float]`; the satisfaction fact lives in the
  -- binding layer, because `VectorSpace requires Ring[F]` and
  -- `fact Ring[Float]` is a per-language binding fact.
  --
  -- There is no separate relational spelling, and there was one until
  -- WI-935. It was a hand-written stand-in for a reading the PROVER
  -- derives: for a proof obligation, WI-669 builds
  -- `vec_add(?a, ?b, ?result) :- ?result = <body>` under the op's own
  -- functor, which is the form lf1 already calls
  -- (`desired_position(?leader, ?off, ?target)`). A hand-written twin
  -- suppresses that derivation — the seam only synthesizes for a
  -- rule-less op — so the two spellings were never peers.
  --
  -- Callable BOTH ways, and the relational form is derived rather than
  -- written: `vec_add(?a, ?b, ?c)` binds `?c` to the computed vector
  -- (WI-938 — a rule-less bodied op's arity+1 goal routes to
  -- `unify(op(args), ?r)`), and `?c = vec_add(?a, ?b)` evaluates
  -- through the SLD→eval bridge. A hand-written clause of the same
  -- functor would SUPPRESS the derived view (design §3.3 precedence),
  -- which is why the pre-WI-935 relational twins are gone rather than
  -- kept alongside.

  sort Vec3
    entity Vec3(x: Float, y: Float, z: Float)

    -- Vector addition, componentwise.
    operation vec_add(a: Vec3, b: Vec3) -> Vec3 =
      Vec3(x: a.x + b.x, y: a.y + b.y, z: a.z + b.z)

    -- Vector subtraction, componentwise.
    operation vec_sub(a: Vec3, b: Vec3) -> Vec3 =
      Vec3(x: a.x - b.x, y: a.y - b.y, z: a.z - b.z)

    -- Scalar multiplication.
    operation vec_scale(c: Float, v: Vec3) -> Vec3 =
      Vec3(x: c * v.x, y: c * v.y, z: c * v.z)

    -- Additive identity.
    operation vec_zero() -> Vec3 =
      Vec3(x: 0.0, y: 0.0, z: 0.0)
  end

  -- Orientation as Euler angles, radians. Field order matches the
  -- webots InertialUnit convention (roll, pitch, yaw). Distinguishing
  -- this from Vec3 prevents spatial-vs-orientation reads from being
  -- aliased through identical component names.
  entity EulerAngles(roll: Float, pitch: Float, yaw: Float)
end
