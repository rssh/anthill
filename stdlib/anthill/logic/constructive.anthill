-- Logic.Constructive — intuitionistic axioms, DECLARED: a rule with no body
-- declares its predicate and asserts nothing (proposal 061, kernel-language.md
-- §5.3). That is what these lines always meant — "they exist as named symbols
-- so a `proof ... :- modus_ponens, …` hint block can reference them" — and until
-- 061 the language had no form for it, so each read as a FACT whose variable head
-- matched any pair of propositions. The resolver pass that handles `-:` (nested
-- implication) will give them their schema reading; a declaration is what they
-- are in the meantime, and it asserts nothing false while waiting.
namespace anthill.logic.Constructive
  import anthill.logic.Minimal.{Minimal}

  sort Constructive
    requires anthill.logic.Minimal.Minimal

    rule identity(?p)
    rule modus_ponens(?p, ?q)
    rule conjunction_intro(?p, ?q)
    rule conjunction_elim_l(?p, ?q)
    rule conjunction_elim_r(?p, ?q)
    rule disjunction_intro_l(?p, ?q)
    rule disjunction_intro_r(?p, ?q)
    rule ex_falso(?p)
  end
end
