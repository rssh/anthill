-- Default Scala/std language mapping profile and execution platforms.
--
-- Defines how anthill effects and prelude types map to Scala 3 syntax.
-- Codegen reads this from the KB; changing it changes generated code
-- without touching the codegen implementation.
--
-- Mirrors stdlib/anthill/realization/rust_std.anthill. The Scala
-- counterpart documentation is docs/scala-forward-mapping.md, with
-- the architectural split in docs/proposals/034-scala-mapping-split.md.
namespace anthill.realization.scala_std
  import anthill.realization.{LanguageMapping, EffectMapping, ReceiverRule,
                              TypeMapping, ReceiverForm, TraitReturnForm}
  import anthill.realization.platform.{ExecutionPlatform, execution_platform}
  import anthill.prelude.Option.{some, none}

  -- ================================================================
  -- Default profile: pure-functional, non-monadic
  -- ================================================================
  --
  -- `scala_std` keeps generated Scala free of third-party EFFECT deps (it still
  -- needs the emitted `anthill.prelude` for anthill's own sorts — WI-1021,
  -- docs/scala-forward-mapping.md §2.1a): `Modify` returns
  -- updated state by value, `Error` returns `Either[E, R]`. No IO/ZIO
  -- machinery — alternative profiles (scala_cats_effect / scala_zio)
  -- swap that in.
  fact LanguageMapping(
    language: "scala",
    profile: some("std"),

    -- Scala version the emitted project targets — the `scalaVersion` scala-gen writes
    -- into the generated `build.sbt`. Lives here rather than in the emitter because
    -- this file is what governs Scala emission; changing the target is a profile
    -- decision, not a code change. Kept in step with scaland's own `build.sbt`
    -- (`scala3Version`) today, but they are separate questions: this is what generated
    -- code is COMPILED AS, that is what scaland itself is BUILT WITH.
    language_version: some("3.8.4"),

    -- Effect → host syntax (semantic: what the effect means)
    effect_map: [
      -- Modify X: take X by value, return updated X. Scala-idiomatic
      -- immutable update — the Scala mirror of rust's `&mut self`,
      -- which can't be expressed in pure Scala without a Ref/State
      -- effect (those land in scala_cats_effect / scala_zio profiles).
      EffectMapping(effect: "Modify", receiver: ByValue),
      -- Error / Error(E): wrap return in Either[E, R].
      EffectMapping(effect: "Error",  receiver: ResultWrap)
    ],

    -- Receiver rules. Scala has no &mut/by-ref distinction at the call
    -- site, so the rule list is shorter than Rust's. The "self-typed
    -- return" optimization rust uses (move-by-value to avoid clone)
    -- has no analog in Scala — JVM references are cheap.
    receiver_map: [],

    -- SCALARS ONLY (WI-1021). A `type_map` entry says the anthill sort's VALUES
    -- ARE the host type's values, and that is true exactly where anthill cannot
    -- BUILD one: `Int64` declares no `entity` and nothing but a literal makes one,
    -- so `Long` is the carrier and nothing else could be. (`Long`, not `Int`:
    -- anthill's Int64 is 64-bit — rust_std says `i64`, cpp_std `int64_t` — and
    -- Scala's `Int` is 32-bit, so every value above 2^31-1 would truncate.)
    --
    -- Every other prelude sort is denoted by the type codegen EMITS for it —
    -- `anthill.prelude.List`, not `scala.List` — because it either has anthill
    -- constructors (`List`'s nil/cons, `Option`'s none/some, `Pair`'s pair) or is
    -- representation-defined with the carrier chosen by a provider (`Set`, `Map`,
    -- `Stream`). Measured before those entries were removed: pair.anthill emitted
    -- `enum Pair[A, B]` and list.anthill, in the same output tree, emitted
    -- `Option[Tuple2[T, List[T]]]` — one anthill name denoting two unrelated Scala
    -- types, the host one structural where anthill's `Pair` has named fields, its
    -- own `eq`, and four conditioned `provides` clauses no `Tuple2` can carry.
    -- `Stream` was the same defect showing as arity: it carries an effect row and
    -- `LazyList` takes one parameter. See docs/scala-forward-mapping.md §2.1a.
    --
    -- `Duration` and `Timestamp` went with them: primitives.anthill declares both
    -- as sorts WITH constructors and Bootstrap emits them, so a host entry would
    -- silently pick host-over-nominal for a sort that has its own values.
    type_map: [
      TypeMapping(anthill_type: "Int64",   host_type: "Long"),
      TypeMapping(anthill_type: "BigInt",  host_type: "BigInt"),
      TypeMapping(anthill_type: "Float",   host_type: "Double"),
      TypeMapping(anthill_type: "Bool",    host_type: "Boolean"),
      TypeMapping(anthill_type: "String",  host_type: "String"),
      TypeMapping(anthill_type: "Unit",    host_type: "Unit"),
      TypeMapping(anthill_type: "Nothing", host_type: "Nothing")
    ],

    -- Return abstract sorts via the trait's type parameter — Scala 3
    -- handles this with normal generics. No `impl Trait` analog needed.
    trait_return: ImplTrait
  )

  -- ================================================================
  -- Execution platforms
  -- ================================================================
  --
  -- Scala targets JVM (default), Scala.js (browser/node), and Scala
  -- Native (LLVM). Profile selection at codegen time picks the target.

  fact execution_platform(
    name: "scala-jvm-linux-x86",
    properties: [("os", "linux"), ("cpu", "x86_64"),
                 ("runtime", "jvm"), ("std", "yes"), ("heap", "yes"),
                 ("threads", "yes")]
  )

  fact execution_platform(
    name: "scala-jvm-macos-arm64",
    properties: [("os", "macos"), ("cpu", "aarch64"),
                 ("runtime", "jvm"), ("std", "yes"), ("heap", "yes"),
                 ("threads", "yes")]
  )

  fact execution_platform(
    name: "scala-js-node",
    properties: [("os", "node"), ("cpu", "wasm-or-js"),
                 ("runtime", "scalajs"), ("std", "partial"),
                 ("heap", "yes"), ("threads", "no")]
  )

  fact execution_platform(
    name: "scala-native-linux-x86",
    properties: [("os", "linux"), ("cpu", "x86_64"),
                 ("runtime", "scala-native"), ("std", "yes"),
                 ("heap", "yes"), ("threads", "yes")]
  )
end
