-- SQL: queryable database persistence backend
--
-- Generic SQL store parameterized by dialect. PostgreSQL, MySQL, SQLite,
-- DuckDB etc. are dialects, not separate store types.
namespace anthill.persistence.sql
  import anthill.reflect.{Term}
  import anthill.prelude.{List}

  -- ── NO STORE PROVISIONS, BECAUSE NO REALIZATION SUPPLIES ONE (WI-931) ─────
  --
  -- This file declared `fact NonMonotonicStore[SqlStore]` and a carrier-less
  -- `fact QueryableStore` (which the loader records as no provision at all —
  -- WI-933). Both are gone: NO host implements a SQL backend. rustland's
  -- `persistence/` has `FileStore` and `IndexedFileStore` and nothing else, so
  -- `retract` / `update` / `retrieve` on a `SqlStore` value reach no mirror, and
  -- a satisfaction fact standing here certified operations that die at the call
  -- — the unsoundness `check_provider_operations` exists to refuse (WI-363 /
  -- WI-818). What survives is what is actually true: the SHAPE of a SQL store
  -- and of its query bindings, which is what a backend would be written against.
  --
  -- This is ENFORCED, not merely observed: re-adding the provision is refused at
  -- load, because a host mapping on a SPEC op backs the operation and never a
  -- carrier (`op_backed`, WI-876 defect A). Pinned by
  -- `reinstating_the_sql_store_provision_is_refused`.
  --
  -- Whichever host closure grows a SQL backend declares the provisions there,
  -- the way `rustland/anthill-stl/anthill/persistence.anthill` does for the two
  -- file backends. That is proposal 038's rule and it is not a rust-specific one.
  --
  -- A SHAPE WITH NO REALIZATION IS AN EXAMPLE, NOT A STANDARD LIBRARY, and this
  -- file is slated to leave `stdlib/` for `examples/` — WI-934, which owns the
  -- three consumers that point at this path (the `anthill-stl` build script's
  -- codegen entry, `anthill-core/examples/gen_store.rs`, and
  -- `docs/rust-forward-mapping.md`, where `SqlStore` is the worked example).
  enum SqlDialect {
    entity Postgresql
    entity Mysql
    entity Sqlite
    entity Duckdb
  }

  entity SqlStore(
    connection : String,
    schema     : String,
    dialect    : SqlDialect
  )

  -- ================================================================
  -- Query bindings: how to translate patterns to SQL
  -- ================================================================

  -- A QueryBinding maps a fact sort to a table with explicit SQL.
  -- The SQL uses Quoted terms (kernel spec §4.2) -- formal in SQL,
  -- embedded in the anthill.
  --
  -- SQL is written manually per-binding for now. Dialect-aware
  -- generation from columns + dialect can be added later.
  entity QueryBinding(
    sort_pattern : Term,                      -- which facts this binding handles
    table        : String,
    columns      : List[T = ColumnDef],
    retrieve_sql : Term,                      -- Quoted("sql", "...") pattern -> SELECT
    persist_sql  : Term,                      -- Quoted("sql", "...") fact -> INSERT/UPSERT
    retract_sql  : Term                       -- Quoted("sql", "...") id -> DELETE
  )

  entity ColumnDef(
    name     : String,                        -- column name in SQL
    field    : String,                        -- field name in anthill entity
    sql_type : String                         -- dialect-specific type (e.g., "text", "numeric")
  )
end
