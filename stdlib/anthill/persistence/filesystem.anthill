-- Filesystem: file-based persistence backend
namespace anthill.persistence.filesystem
  import anthill.reflect.{Term}
  import anthill.prelude.Meta.{Meta}
  import anthill.prelude.{Modifiable}

  -- ── NO STORE PROVISIONS IN THIS FILE (WI-931) ─────────────────────────────
  --
  -- `fact NonMonotonicStore[FileStore]` and its two `IndexedFileStore` peers
  -- moved to `rustland/anthill-stl/anthill/persistence.anthill`, the host closure
  -- where the operations they promise are backed. The rule is `geometry.anthill`'s
  -- and it is proposal 038's: a satisfaction fact may only be declared where the
  -- spec's operations have an implementation. `anthill.persistence`'s are host
  -- primitives, so in a stdlib-only load NOTHING backs `retract` — the claim was
  -- unsound standing here, which is what `check_provider_operations` reports the
  -- moment §6.3's free-standing carriers become visible to it (WI-928).
  --
  -- `Modifiable` stays: it is a marker with no operations to back.
  --
  -- `BulkStore` IS GONE ENTIRELY (WI-932) — spec, Rust trait and both impls.
  -- The rationale lives once, in `store.anthill`'s header.
  --
  -- THE BACKENDS RE-DECLARE NOTHING. The storage operations are COMMON
  -- operations over a store's state — one host function each, taking the store as
  -- its first argument and resolving THAT VALUE to its registered mirror — so
  -- they are declared once, on the specs in `store.anthill`, and realized once,
  -- in `rustland/anthill-stl/anthill/persistence.anthill`. What is genuinely
  -- per-backend is only WHICH BACKENDS A HOST REALIZES, and that is a one-line
  -- binding block in the host closure, not six copied signatures here.
  entity FileStore(root: String, convention: FileConvention)
  fact Modifiable[T = FileStore]

  -- IndexedFileStore: FileStore plus a per-rule source map (for
  -- span-based retract) and a primary-key `id` index (for fast
  -- retrieve). Indexes are populated by the host as it loads the tree
  -- (`record_source` / `index_by_id`); there is no store-side bulk read.
  entity IndexedFileStore(root: String, convention: FileConvention)
  fact Modifiable[T = IndexedFileStore]

  -- ================================================================
  -- File conventions: how facts map to files
  -- ================================================================

  -- WI-830 — THESE ARE THE CONVENTIONS THE HOST ACTUALLY IMPLEMENTS. They had
  -- drifted two ways from the Rust `FileConvention` they name: this enum declared
  -- `stage0` and `by_namespace`, which no backend implements, while `ByDomain` and
  -- `SingleFile` were implemented and undeclarable. Only `flat` overlapped. The
  -- drift went unnoticed because nothing in any `.anthill` file ever USED a
  -- variant — the host constructed them by bare-interning the Rust spelling — and
  -- it became load-bearing the moment a project had to WRITE its store binding
  -- (`ExtentBinding`, store.anthill): anthill-todo's own layout was not spellable.
  enum FileConvention {
    entity flat                               -- every fact in one facts.anthill
    entity by_domain                          -- one file per domain: <domain>.anthill
    entity single_file(file: String)          -- every fact in one NAMED file under
                                              -- the root; anthill-todo's layout,
                                              -- where runtime writes land in the
                                              -- same workitems.anthill the loader
                                              -- reads
  }

  namespace Factory
    operation create(conventions: FileConvention, root: String) -> FileStore
  end

  operation file_path(fact: Term, meta: Meta, conv: FileConvention) -> String

  -- Status-dependent renaming (stage0 convention):
  -- Draft    -> .anthill.draft
  -- Rejected -> .anthill.rejected
  -- other    -> .anthill
  operation suffix(status: Term, conv: FileConvention) -> String
end
