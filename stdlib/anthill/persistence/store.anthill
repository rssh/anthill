-- Persistence: abstract storage algebra (proposal 007 §2 — trait/policy model)
--
-- Capability comes in two kinds, two mechanisms:
--   * PROVISION — a trait carrying an operation. `retract` / `retrieve` are not
--     on every store, so having one = providing its trait. An append-only
--     backend simply does not provide `NonMonotonicStore` and has no `retract`
--     at all.
--   * POLICY — a per-predicate value over universal ops. `persist` is on every
--     Store, but whether it (and `retract`) is permitted for a functor is that
--     functor's `monotonicity` (proposal 053), answered by `monotonicity`.
--
-- The sorts:
--   Store              — base: persist, flush, monotonicity (all backends)
--   NonMonotonicStore  — adds retract (mutation capability; e.g. filesystem, SQL)
--   QueryableStore     — adds retrieve (pattern-based query; e.g. SQL)
--
-- NO `BulkStore` (WI-932). 007 §2 declared a fourth trait whose sole member was
-- `pull(store) -> List[Term]` — "load all into memory". It was deleted, not left
-- standing as an unbacked spec: no host ever implemented an anthill-callable
-- `pull` (it was in neither eval registry), so nothing could provide the trait
-- and nothing could call it. Reading a tree of `.anthill` files is the CALLER's
-- job — `anthill-todo`'s cold start scans, parses and loads, then seeds
-- `IndexedFileStore::record_source` — and the Rust `BulkStore` trait that once
-- backed nothing but its own tests went with it. A future backend that wants
-- bulk rehydration re-declares it against a real implementation; that is the
-- mirror role sketched in `docs/proposals/future/extent-sources.md`, which is
-- direction and not a commitment (057, the implementable slice, has no `pull`).
namespace anthill.persistence
  import anthill.reflect.{Term, FactRef, StoredRef, Symbol, Monotonicity}
  import anthill.prelude.{List, Stream, Option}
  import anthill.prelude.Meta.{Meta}

  -- ================================================================
  -- Store: base storage backend
  -- ================================================================

  sort Store {
    -- Persist a fact to its backing store. Permitted iff the fact's functor
    -- is not `constant` (proposal 053).
    operation persist(store: Store, fact: Term, meta: Meta) -> StoredRef[T = Term]
      effects {Modify[store], Error}

    -- Flush KB delta (new/changed/retracted facts) back to store
    operation flush(store: Store, delta: List[T = Term]) -> Bool
      effects {Modify[store], Error}

    -- Write POLICY (proposal 053) of a functor this store owns: which write
    -- operations are permitted for it — constant (none), monotone (persist
    -- only), non_monotone (persist + retract). A QUERY: the system reads it to
    -- plan (persist iff != constant, retract iff non_monotone), NEVER by
    -- attempting a write and catching the failure.
    operation monotonicity(store: Store, functor: Symbol) -> Monotonicity
  }

  -- Given a fact, which store owns it?
  operation route(fact: Term) -> Store

  -- ================================================================
  -- NonMonotonicStore: mutation capability (proposal 053 / 007 §2)
  -- ================================================================

  -- Mutation is a capability: only a NonMonotonicStore carries `retract`. A
  -- store that does not provide this trait cannot be asked to retract at all,
  -- so its `monotonicity` answers can only be `monotone` or `constant` —
  -- `non_monotone` implies this trait (the consistency is structural, not a
  -- separate capability bound).
  sort NonMonotonicStore {
    provides Store                                -- NonMonotonicStore is-a Store

    -- Remove a fact from its backing store. Permitted iff the functor is
    -- `non_monotone` (proposal 053). A backend that cannot honor a declared
    -- non_monotone retract fails loudly at the write via the Error effect,
    -- not a static load check.
    operation retract(store: NonMonotonicStore, reference: FactRef) -> Bool
      effects {Modify[store], Error}

    -- Atomically replace the row named by `reference`. A successful update
    -- returns the replacement's fresh reference; failure leaves the old row
    -- observable. It is not exposed as retract-then-persist.
    operation update(store: NonMonotonicStore, reference: FactRef, new: Term)
      -> Option[T = StoredRef[T = Term]]
      effects {Modify[store], Error}
  }

  -- ================================================================
  -- QueryableStore: pattern-based retrieval
  -- ================================================================

  sort QueryableStore {
    provides Store                                -- QueryableStore is-a Store

    -- Retrieve facts matching a pattern (delegates to backend query).
    -- Streamed rather than materialized so a queryable backend can yield
    -- 1M rows without forcing them all into memory at once. Concrete
    -- backends surface rows via `StreamSource::External` (proposal 026.1
    -- Q4 + 007 §11) so each row enters σ as `Value::Entity` without
    -- `TermStore` allocation. A caller that genuinely wants a fully
    -- materialized list must drain this bare (maybe-infinite) `Stream`
    -- with a BOUNDED `takeN(retrieve(...), n)` — the unbounded eager
    -- `collect` moved to `FiniteCollection` (proposal library/003, Phase C /
    -- WI-589) and does NOT apply to a plain query `Stream`, which carries no
    -- finiteness guarantee.
    operation retrieve(store: QueryableStore, pattern: Term) -> Stream[Term, Error]
      effects Error
  }

end
