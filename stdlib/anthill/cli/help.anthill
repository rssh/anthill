-- CLI help renderer. Produces a --help string from an OperationSpec.
-- Format:
--   <description>
--
--   USAGE: <name> [POSITIONALS...] [FLAGS...]
--
--   ARGS:
--     <name>          <description>
--
--   FLAGS:
--     --<name>        <description>
namespace anthill.cli.help
  import anthill.prelude.{List, Option, String, Bool}
  import anthill.prelude.List.{nil, cons}
  import anthill.prelude.String.{concat, padRight}
  import anthill.cli.spec.{OperationSpec, ParamSpec, ParamKind}
  import anthill.cli.spec.ParamKind.{positional, flag, repeated, bool_flag}

  -- The COMPACT form: what a command ACCEPTS, with no description prose and no
  -- section headers, ending in a newline. This is what an ARGUMENT ERROR prints:
  -- the reader already knows which command they meant and got one token wrong, so
  -- what helps is the list of tokens that would have worked, not the full page.
  -- `format_help` stays the full page. Both render from the same `ParamSpec` list,
  -- so neither can drift from the registry, or from each other.
  --
  --   usage: <name> <pos> [--flag VALUE] [--bool]
  --     pos            <description>
  --     --flag         <description>
  operation format_usage(s: OperationSpec) -> String =
    match s
      case OperationSpec(name, _, params, _) ->
        cat3("usage: ", name,
             cat3(usage_summary(params), "\n",
                  concat(render_args(params), render_flags(params))))

  -- Top-level renderer.
  operation format_help(s: OperationSpec) -> String =
    match s
      case OperationSpec(name, desc, params, _) ->
        cat3(desc, "\n\nUSAGE: ",
             cat3(name, usage_summary(params),
                  cat3("\n\nARGS:\n", render_args(params),
                       concat("\nFLAGS:\n", render_flags(params)))))

  -- " <pos1> [<pos2>] --required VALUE [--flag VALUE] [--repeated VALUE]..."
  operation usage_summary(params: List[ParamSpec]) -> String =
    match params
      case nil() -> ""
      case cons(p, rest) ->
        match p
          case ParamSpec(name, kind, required, _) ->
            concat(concat(" ", param_token(name, kind, required)),
                   usage_summary(rest))

  -- HOW A PARAMETER IS SPELLED, in one place, so a usage line and a diagnostic
  -- naming the same parameter cannot disagree — which they did: a missing
  -- `insert --before` was reported as `missing required argument <before>`, a
  -- POSITIONAL spelling the parser refuses when followed.
  --
  -- `required` decides the brackets and nothing else. It was ignored entirely
  -- until here, so a REQUIRED flag rendered as optional — invisible while nothing
  -- printed `usage_summary`, and printed by `format_usage` in the one context
  -- where the distinction is the whole message: directly under `missing required
  -- argument`, naming the very param the brackets called optional.
  operation param_token(name: String, kind: ParamKind, required: Bool) -> String =
    if required then bare_token(name, kind)
    else cat3("[", bare_token(name, kind), "]")

  -- The spelling without the optionality brackets. `repeated`'s `...` belongs to
  -- the token, not to the brackets: `[--tag VALUE]...` reads as "zero or more",
  -- and `--tag VALUE...` as "one or more", which is what required/optional mean
  -- for a repeatable param.
  operation bare_token(name: String, kind: ParamKind) -> String =
    match kind
      case positional() -> cat3("<", name, ">")
      case flag()       -> cat3("--", name, " VALUE")
      case repeated()   -> cat3("--", name, " VALUE...")
      case bool_flag()  -> concat("--", name)

  -- ARGS: section: positional params only.
  operation render_args(params: List[T = ParamSpec]) -> String =
    match params
      case nil() -> ""
      case cons(p, rest) ->
        match p
          case ParamSpec(name, kind, _, desc) ->
            match kind
              case positional() ->
                concat(cat3("  ", padRight(name, NAME_COLUMN), concat(desc, "\n")),
                       render_args(rest))
              case _ -> render_args(rest)

  -- FLAGS: section: non-positional params.
  operation render_flags(params: List[T = ParamSpec]) -> String =
    match params
      case nil() -> ""
      case cons(p, rest) ->
        match p
          case ParamSpec(name, kind, _, desc) ->
            match kind
              case positional() -> render_flags(rest)
              case _ ->
                concat(cat3("  ", padRight(concat("--", name), NAME_COLUMN),
                            concat(desc, "\n")),
                       render_flags(rest))

  -- Width of the name column shared by the ARGS and FLAGS rows, so a positional
  -- and a flag of the same command line their descriptions up against each other.
  -- Wide enough for the longest rendered name in the anthill-todo registry —
  -- `--description`, 13 characters — plus the two spaces that separate it from
  -- its description. `padRight` leaves a longer name unchanged, which costs that
  -- one row its alignment and nothing else.
  const NAME_COLUMN: Int64 = 15

  -- 3-arg concat helper.
  operation cat3(a: String, b: String, c: String) -> String =
    concat(a, concat(b, c))
end
