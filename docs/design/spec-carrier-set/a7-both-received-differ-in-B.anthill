namespace carrier_set.a7
  import anthill.cli.Main
  import anthill.prelude.Console.{console, println, ConsoleOutput}
  import anthill.prelude.Int64.{to_string}
  import anthill.prelude.{Int64, String, List, Bool, Error}

  sort Color
    entity red
  end
  sort Tag
    entity tg
  end
  sort Rel
    sort A = ?
    sort B = ?
    operation relate(a: A, b: B) -> Int64
  end
  sort W
    provides Rel[A = Int64, B = Tag]
    operation relate(a: Int64, b: Tag) -> Int64 = 1
  end
  sort V
    provides Rel[A = Int64, B = Color]
    operation relate(a: Int64, b: Color) -> Int64 = 2
  end

  sort Program
    requires anthill.cli.Main
    operation main(args: List[T = String]) -> Int64
      effects {ConsoleOutput, Error}
    =
      let _ = println(console(), to_string(Rel.relate(5, red)))
      0
  end
end
