namespace carrier_set.f1
  import anthill.cli.Main
  import anthill.prelude.Console.{console, println, ConsoleOutput}
  import anthill.prelude.Int64.{to_string}
  import anthill.prelude.{Int64, String, List, Bool, Error}

  sort Coll
    sort C = ?
    sort Elem = ?
    operation first(c: C) -> Elem
  end
  sort Foo
    entity foo
  end
  sort Num
    entity num(v: Int64)
    provides Coll[C = Foo, Elem = Self, first = Num.firstOf]
    operation firstOf(c: Foo) -> Num = num(v: 42)
    operation value(n: Num) -> Int64 =
      match n
        case num(v) -> v
  end

  sort Program
    requires anthill.cli.Main
    operation main(args: List[T = String]) -> Int64
      effects {ConsoleOutput, Error}
    =
      let _ = println(console(), to_string(Num.value(Coll.first(foo))))
      0
  end
end
