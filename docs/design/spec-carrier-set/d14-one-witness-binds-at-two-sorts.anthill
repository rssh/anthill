namespace carrier_set.d14
  import anthill.cli.Main
  import anthill.prelude.Console.{console, println, ConsoleOutput}
  import anthill.prelude.Int64.{to_string}
  import anthill.prelude.{Int64, String, List, Bool, Error}
  sort Tag
    sort T = ?
    operation tag(x: T) -> Int64
  end
  sort Foo
    entity foo
  end
  sort Bar
    entity bar
  end
  sort WT
    provides Tag[T = Foo, tag = WT.tagFoo]
    provides Tag[T = Bar, tag = WT.tagBar]
    operation tagFoo(x: Foo) -> Int64 = 1
    operation tagBar(x: Bar) -> Int64 = 20
  end
  sort Program
    requires anthill.cli.Main
    operation main(args: List[T = String]) -> Int64
      effects {ConsoleOutput, Error}
    =
      let _ = println(console(), to_string(Tag.tag(foo) + Tag.tag(bar)))
      0
  end
end
