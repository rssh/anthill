-- Does a provision with NO member of that name fail?
sort smoke.p6.Agent
  import anthill.prelude.{String, Error}
  sort C = ?
  operation run(self: C, input: String) -> String
    effects {Error}
end

sort smoke.p6.EmptyAgent
  import anthill.prelude.{String}
  import smoke.p6.{Agent}
  entity mk
  provides Agent[C = EmptyAgent]
end
