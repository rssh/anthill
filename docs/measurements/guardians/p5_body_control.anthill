-- CONTROL for p4: identical shape, callee is pure-ish. Must load clean.
sort smoke.p5.Agent
  import anthill.prelude.{String, Error}
  sort C = ?
  operation run(self: C, input: String) -> String
    effects {Error}
end

sort smoke.p5.PlainAgent
  import anthill.prelude.{String, Error}
  import smoke.p5.{Agent}
  entity mk

  operation helper(s: String) -> String
    effects {Error}

  operation run(self: PlainAgent, input: String) -> String
    effects {Error} = helper(input)

  provides Agent[C = PlainAgent]
end
