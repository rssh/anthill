-- THE OTHER TEST: a provider whose operation has the wrong SIGNATURE.
sort smoke.p3.Agent
  import anthill.prelude.{String, Error}
  sort C = ?
  operation run(self: C, input: String) -> String
    effects {Error}
end

sort smoke.p3.WrongSigAgent
  import anthill.prelude.{String, Int64, Error}
  import smoke.p3.{Agent}
  entity mk
  operation run(self: WrongSigAgent) -> Int64
    effects {Error} = 42
  provides Agent[C = WrongSigAgent]
end
