-- SMOKE D2c: labels introduced by OPERATION SIGNATURES (not constructor calls).
enum smoke.c.Level
  entity Untrusted
  entity Public
end

enum smoke.c.Text
  import anthill.prelude.{String}
  sort L = ?
  entity mk(raw: String)
end

namespace smoke.c
  import anthill.prelude.{Unit, String, todo}
  import smoke.c.Level.{Untrusted, Public}
  import smoke.c.Text
  import smoke.c.Text.{mk}

  -- The labels are types (a label is bound from `Text[L = …]`), so the lattice is
  -- written over types: `Public[]` is the type `Public` written as data, where a bare
  -- `Public` is the entity's value (kernel-language.md §4.4).
  fact flows_to(Public[], Public[])
  fact flows_to(Untrusted[], Untrusted[])
  -- ABSENT: flows_to(Untrusted[], Public[])

  -- Sources: the label comes from the TOOL SIGNATURE.
  operation fetch() -> Text[L = Untrusted] = todo()
  operation banner() -> Text[L = Public] = todo()

  -- The sink.
  operation send(body: Text[L = ?l]) -> Unit
    requires flows_to(?l, Public[]) = ()

  -- THE TEST: untrusted into a Public-only sink. Must NOT load if gated.
  operation leak() -> Unit =
    send(fetch())

  -- CONTROL: public into the same sink. Must load either way.
  operation ok() -> Unit =
    send(banner())
end
