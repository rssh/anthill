+//! TEMPORARY — WI-20261127-DAPCN S1 (proposal 060.1 §9), a MEASUREMENT PROBE. Not for commit:
+//! S1 builds nothing, and this module and its hooks are backed out once the rows are counted.
+//!
+//! `ANTHILL_DAPCN_S1` selects what the hooks do; unset, every hook is a cheap no-op and the
+//! build behaves as HEAD does.
+//!
+//! - `log`  — record each hit: `tag \t scope \t who \t detail` into `ANTHILL_DAPCN_S1_LOG`
+//!   (default `/tmp/dapcn_s1.log`), one line per distinct (tag, scope, who, detail).
+//! - `load` — log, and REFUSE AT LOAD every citation of a program file (not the standard
+//!   library's) that leaves a rule's type variable for a value to decide.
+//! - `run`  — log, and REFUSE AT RUN TIME every read of a type off a value in a rule that
+//!   decides the type, except where the standard library wrote both the clause and the goal.
+//! - `runall` — `run`, the standard library's own reads refused too.
+//!
+//! `who` is the test the hit came from (libtest names each test's thread after it), or
+//! `main:<pid>:<argv>` for a spawned binary.
+
+use std::cell::RefCell;
+use std::collections::HashSet;
+use std::io::Write;
+use std::sync::{Mutex, OnceLock};
+
+#[derive(Clone, Copy, PartialEq, Eq, Debug)]
+pub enum Mode {
+    Off,
+    Log,
+    Load,
+    Run,
+    RunAll,
+}
+
+pub fn mode() -> Mode {
+    static M: OnceLock<Mode> = OnceLock::new();
+    *M.get_or_init(|| match std::env::var("ANTHILL_DAPCN_S1").as_deref() {
+        Ok("log") => Mode::Log,
+        Ok("load") => Mode::Load,
+        Ok("run") => Mode::Run,
+        Ok("runall") => Mode::RunAll,
+        _ => Mode::Off,
+    })
+}
+
+#[inline]
+pub fn on() -> bool {
+    mode() != Mode::Off
+}
+
+#[inline]
+pub fn refuse_load() -> bool {
+    mode() == Mode::Load
+}
+
+/// Does the mode refuse a run-time read at a goal of `scope`?
+#[inline]
+pub fn refuse_run(scope: &str) -> bool {
+    match mode() {
+        Mode::Run => scope != "stdlib",
+        Mode::RunAll => true,
+        _ => false,
+    }
+}
+
+fn who() -> String {
+    let t = std::thread::current();
+    match t.name() {
+        Some(n) if n != "main" => n.to_string(),
+        _ => format!(
+            "main:{}:{}",
+            std::process::id(),
+            std::env::args().skip(1).collect::<Vec<_>>().join(" ")
+        ),
+    }
+}
+
+static SEEN: Mutex<Option<HashSet<String>>> = Mutex::new(None);
+
+/// Record one hit. `scope` is `stdlib`, `prog` or `?` (a run-time goal with no place).
+pub fn hit(tag: &str, scope: &str, detail: &str) {
+    if !on() {
+        return;
+    }
+    let mut line = format!("{tag}\t{scope}\t{}\t{detail}", who());
+    line.retain(|c| c != '\n');
+    {
+        let mut g = SEEN.lock().unwrap_or_else(|e| e.into_inner());
+        if !g.get_or_insert_with(HashSet::new).insert(line.clone()) {
+            return;
+        }
+    }
+    line.push('\n');
+    let path = std::env::var("ANTHILL_DAPCN_S1_LOG").unwrap_or_else(|_| "/tmp/dapcn_s1.log".into());
+    if let Ok(mut f) = std::fs::OpenOptions::new().create(true).append(true).open(path) {
+        let _ = f.write_all(line.as_bytes());
+    }
+}
+
+/// `stdlib` for a source the standard library was loaded from, else `prog`.
+pub fn scope_of_name(name: &str) -> &'static str {
+    if name.contains("stdlib/anthill/") || name.starts_with("anthill/") {
+        "stdlib"
+    } else {
+        "prog"
+    }
+}
+
+thread_local! {
+    static PENDING: RefCell<Vec<(crate::span::SourceSpan, String)>> = const { RefCell::new(Vec::new()) };
+}
+
+/// Queue a load refusal (mode `load`, program files only) for the typer run to report.
+pub fn push_refusal(at: crate::span::SourceSpan, message: String) {
+    PENDING.with(|p| {
+        let mut p = p.borrow_mut();
+        if !p.iter().any(|(s, _)| *s == at) {
+            p.push((at, message));
+        }
+    });
+}
+
+/// The refusals queued so far on this thread, taken.
+pub fn take_refusals() -> Vec<(crate::span::SourceSpan, String)> {
+    PENDING.with(|p| std::mem::take(&mut *p.borrow_mut()))
+}
+
+thread_local! {
+    static QUERY_ORIGIN: std::cell::Cell<&'static str> = const { std::cell::Cell::new("runtime") };
+}
+
+/// Where the query being typed comes from: `query` (written, typed where it is read),
+/// `constraint` (an integrity guard's goals, typed when checked) or `runtime` (a query built
+/// or drained at run time — a relation an operation body cites, `execute`). Set for the scope
+/// of the returned guard.
+pub fn query_origin(origin: &'static str) -> impl Drop {
+    struct Restore(&'static str);
+    impl Drop for Restore {
+        fn drop(&mut self) {
+            QUERY_ORIGIN.with(|c| c.set(self.0));
+        }
+    }
+    let before = QUERY_ORIGIN.with(|c| c.replace(origin));
+    Restore(before)
+}
+
+pub fn current_query_origin() -> &'static str {
+    QUERY_ORIGIN.with(|c| c.get())
+}
