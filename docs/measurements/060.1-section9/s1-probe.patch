+/// citation fixes). The relation's columns are read again, fresh, on a trial of the settled
+/// clause, so nothing of the clause's typing changes.
+fn dapcn_probe_rule_goals(
+    kb: &mut KnowledgeBase,
+    site: ClauseSite<'_>,
+    own: Option<Symbol>,
+    st: &ClauseConstraints,
+    goals: &[(Symbol, Rc<NodeOccurrence>)],
+) {
+    if goals.is_empty() {
+        return;
+    }
+    fn head_debruijn(kb: &KnowledgeBase, t: TermId, out: &mut Vec<u32>) {
+        match kb.get_term(t) {
+            Term::Var(Var::DeBruijn(d)) => out.push(*d),
+            Term::Fn { pos_args, named_args, .. } => {
+                let (p, n) = (pos_args.clone(), named_args.clone());
+                for a in p {
+                    head_debruijn(kb, a, out);
+                }
+                for (_, a) in n {
