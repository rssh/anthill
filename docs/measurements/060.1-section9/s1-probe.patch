+/// TEMPORARY — WI-20261127-DAPCN S1 probe (`crate::dapcn_s1`): a citation in functional code
+/// that leaves a variable of the cited clauses' column types unfixed — neither its arguments,
+/// its bracket nor its expected type fix it, and it is tied to no argument's type.
+#[allow(clippy::too_many_arguments)]
+fn dapcn_probe_citation(
+    kb: &mut KnowledgeBase,
+    env: &TypingEnv,
+    sym: Symbol,
+    occ: &Rc<NodeOccurrence>,
+    column_types: &[(Symbol, Value)],
+    bound: &[Symbol],
+    arg_types: &[Value],
+    subst: &Substitution,
+) {
+    if !crate::dapcn_s1::on() {
+        return;
+    }
+    let mut clause_vars: Vec<VarId> = Vec::new();
+    let mut seen = HashSet::new();
+    for (_, t) in column_types {
+        if resolved_var(kb, t).is_some() {
+            continue;
+        }
+        crate::kb::node_occurrence::collect_value_type(kb, t, &mut clause_vars, &mut seen);
+    }
+    if clause_vars.is_empty() {
+        return;
+    }
+    // L4 — a column the citation fixes at the operation's own type parameter (a rigid), where
+    // the operation requires no `SortDomain`: the typed column's check needs the domain at a
+    // type only the caller knows (060.1 §9 items 5–6, measurement 3).
+    {
+        let holds_sort_domain = env
+            .enclosing_frame_chain()
+            .entries
+            .iter()
+            .any(|e| is_sort_domain_spec(kb, e.required_sort));
+        let mut at_rigid: Vec<String> = Vec::new();
+        for (name, t) in column_types {
+            if resolved_var(kb, t).is_some() {
+                continue;
+            }
+            let w = walk_type_deep_value(kb, subst, t);
+            if kb.mentions_var(&w, &|v| matches!(v, Var::Rigid(_))) {
+                at_rigid.push(format!(
+                    "{}: {}",
+                    kb.local_name_of(*name),
+                    crate::persistence::print::TermPrinter::new(kb).print_value(&w)
+                ));
+            }
+        }
+        if !at_rigid.is_empty() && !holds_sort_domain {
+            let src = kb.source_name(occ.span.source).to_string();
+            let scope = crate::dapcn_s1::scope_of_name(&src);
+            let what = format!("`{}` at[{}]", kb.qualified_name_of(sym), at_rigid.join(", "));
+            crate::dapcn_s1::hit("L4-opbody-rigid-no-sortdomain", scope, &format!("{what} @ {src}:{}", occ.span.span.start));
+            if crate::dapcn_s1::refuse_load() && scope == "prog" {
+                crate::dapcn_s1::push_refusal(
+                    occ.span,
+                    format!("DAPCN-S1 L4: citation {what} fixes a typed column at the operation's type parameter, which requires no `SortDomain` there"),
+                );
+            }
+        }
+    }
+    let mut tied: Vec<VarId> = Vec::new();
+    let mut seen_tied = HashSet::new();
+    for a in arg_types {
+        let a = walk_type_deep_value(kb, subst, a);
+        crate::kb::node_occurrence::collect_value_type(kb, &a, &mut tied, &mut seen_tied);
+    }
+    let mut free_cols: Vec<String> = Vec::new();
+    let mut bound_cols: Vec<String> = Vec::new();
+    for (name, t) in column_types {
+        if resolved_var(kb, t).is_some() {
+            continue;
+        }
+        let w = walk_type_deep_value(kb, subst, t);
+        let mut vs: Vec<VarId> = Vec::new();
+        let mut seen_w = HashSet::new();
+        crate::kb::node_occurrence::collect_value_type(kb, &w, &mut vs, &mut seen_w);
+        let left = vs.iter().any(|v| {
+            clause_vars.iter().any(|c| c.raw() == v.raw()) && !tied.iter().any(|c| c.raw() == v.raw())
+        });
+        if !left {
+            continue;
+        }
+        let label = format!(
+            "{}: {}",
+            kb.local_name_of(*name),
+            crate::persistence::print::TermPrinter::new(kb).print_value(&w)
+        );
+        if bound.contains(name) {
+            bound_cols.push(label);
+        } else {
+            free_cols.push(label);
+        }
+    }
+    if free_cols.is_empty() && bound_cols.is_empty() {
+        return;
+    }
+    let src = kb.source_name(occ.span.source).to_string();
+    let scope = crate::dapcn_s1::scope_of_name(&src);
+    let tag = if bound_cols.is_empty() { "L1-opbody-free" } else { "L1-opbody-bound" };
+    let what = format!(
+        "`{}` free[{}] bound[{}]",
+        kb.qualified_name_of(sym),
+        free_cols.join(","),
+        bound_cols.join(",")
+    );
+    crate::dapcn_s1::hit(tag, scope, &format!("{what} @ {src}:{}", occ.span.span.start));
+    if crate::dapcn_s1::refuse_load() && scope == "prog" {
+        crate::dapcn_s1::push_refusal(
+            occ.span,
+            format!("DAPCN-S1 {tag}: citation {what} leaves a type variable of its clauses for a value to decide"),
+        );
+    }
+}
