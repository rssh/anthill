+    let (is_query, caller, head_dbs) = match site {
+        ClauseSite::Rule { head, .. } => {
+            let mut dbs = Vec::new();
+            head_debruijn(kb, head, &mut dbs);
+            (false, own.map(|o| kb.qualified_name_of(o).to_string()).unwrap_or_default(), dbs)
+        }
+        ClauseSite::Query { .. } => (true, "<query>".to_string(), Vec::new()),
+    };
+    for (functor, goal) in goals {
+        let Some(columns) = rule_goal_columns_at(kb, own, *functor) else {
+            continue;
+        };
+        let mut trial = st.trial();
+        if constrain_goal_at_columns(kb, &mut trial, *functor, goal, &columns).is_err() {
+            continue;
+        }
+        // What the clause's head reaches, read on the trial: a unification may have bound
+        // either side's variable to the other's.
+        let mut head_vars: Vec<VarId> = Vec::new();
+        let mut seen = HashSet::new();
+        for d in &head_dbs {
+            if let Some(ty) = trial.var_types.get(d).cloned() {
+                let ty = walk_type_deep_value(kb, &trial.subst, &ty);
+                crate::kb::node_occurrence::collect_value_type(kb, &ty, &mut head_vars, &mut seen);
+            }
+        }
+        let mut left: Vec<String> = Vec::new();
+        for (slot, col) in &columns {
+            let ColumnType::Of(ty) = col else { continue };
+            if resolved_var(kb, ty).is_some() {
+                continue;
+            }
+            let w = walk_type_deep_value(kb, &trial.subst, ty);
+            let mut vs: Vec<VarId> = Vec::new();
+            let mut s2 = HashSet::new();
+            crate::kb::node_occurrence::collect_value_type(kb, &w, &mut vs, &mut s2);
+            if vs.iter().any(|v| !head_vars.iter().any(|h| h.raw() == v.raw())) {
+                let printed = crate::persistence::print::TermPrinter::new(kb).print_value(&w);
+                left.push(format!(
+                    "{}: {printed}",
+                    match slot {
+                        SlotKey::Pos(i) => crate::intern::positional_label(*i),
+                        SlotKey::Named(k) => kb.local_name_of(*k).to_string(),
+                    }
+                ));
+            }
+        }
+        if left.is_empty() {
+            continue;
+        }
+        let bracketed = call_type_args_of(goal).is_some();
+        let rids: Vec<RuleId> = kb.rules_by_functor_iter(*functor).collect();
+        let facts_only = rids.iter().all(|&rid| kb.rule_body_nodes(rid).is_empty());
+        let typed = rids
+            .iter()
+            .any(|&rid| !kb.rule_type_bounds(rid).is_empty() || !kb.rule_type_params(rid).is_empty());
+        let kind = if facts_only {
+            "facts"
+        } else if typed {
+            "typed"
+        } else {
+            "inferred"
+        };
+        let origin = crate::dapcn_s1::current_query_origin();
+        let tag = format!(
+            "{}-{kind}{}",
+            if is_query { format!("L3-{origin}") } else { "L2-rulegoal".to_string() },
+            if bracketed { "-bracketed" } else { "" }
+        );
+        let src = kb.source_name(goal.span.source).to_string();
+        // A query's goal is the user's, whatever source its span names.
+        let scope = if is_query { "prog" } else { crate::dapcn_s1::scope_of_name(&src) };
+        let what = format!("{caller} -> `{}` cols[{}]", kb.qualified_name_of(*functor), left.join(","));
+        crate::dapcn_s1::hit(&tag, scope, &format!("{what} @ {src}:{}", goal.span.span.start));
+        if crate::dapcn_s1::refuse_load()
+            && scope == "prog"
+            && !bracketed
+            && !(is_query && origin == "runtime")
+        {
