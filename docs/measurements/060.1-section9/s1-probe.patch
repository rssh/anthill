+// ── TEMPORARY — WI-20261127-DAPCN S1 probe (`crate::dapcn_s1`) ──────────────────────────────
+
+thread_local! {
+    /// Where the builtin goal being run was written, for the probe's run-time hooks.
+    static DAPCN_SPAN: std::cell::Cell<Option<crate::span::SourceSpan>> =
+        const { std::cell::Cell::new(None) };
+}
+
+/// The scope and place of a run-time goal: where its occurrence was written, if it has one.
+fn dapcn_place(kb: &KnowledgeBase, goal: &Value) -> (&'static str, String) {
+    match goal {
+        Value::Node(occ) if occ.span.end() > occ.span.start() => {
+            let src = kb.source_name(occ.span.source);
+            (crate::dapcn_s1::scope_of_name(src), format!("{}:{}", src, occ.span.span.start))
+        }
+        _ => ("?", String::new()),
+    }
+}
+
+/// Record a run-time hit at the current builtin's place; `true` when mode `run` refuses it
+/// (mode `run` refuses a goal the standard library did not write; `runall` refuses every one).
+fn dapcn_run_hit(kb: &KnowledgeBase, tag: &str, extra: &str) -> bool {
+    let (scope, place) = match DAPCN_SPAN.with(|c| c.get()) {
+        Some(sp) => {
+            let src = kb.source_name(sp.source);
+            (crate::dapcn_s1::scope_of_name(src), format!("{}:{}", src, sp.span.start))
+        }
+        None => ("?", String::new()),
+    };
+    crate::dapcn_s1::hit(tag, scope, &format!("{place} {extra}"));
+    crate::dapcn_s1::refuse_run(scope)
+}
+
+/// The probe's decision point for a TYPED COLUMN: a clause opened with a typed column whose
+/// bound mentions a variable (its `apply_domain(?d, ?x, B)` reads `?x`'s type into `B`) and
+/// whose `SortDomain` read (`?d`) no citation bound — the activation will read the type off the
+/// value. A refusal message where the mode refuses it.
+fn dapcn_probe_open(
+    kb: &mut KnowledgeBase,
+    rid: RuleId,
+    original_goal: &Value,
+    fresh_nodes: &[Rc<NodeOccurrence>],
+    merged: &Substitution,
+    // Whether the citation bound any of the clause's requirement reads: a guard's dictionary
+    // names the instance its type parameter is at.
+    any_read_routed: bool,
+) -> Option<String> {
+    let mut unrouted = 0usize;
+    let mut routed = 0usize;
+    // A `domain(?x, B)` conformance goal whose bound mentions a variable — a column at a
+    // declared parameter (`?r: A` under `[A]`), or a bound with no domain: it pins the variable
+    // off the value. Classed by whether the citation routed anything at all.
+    let mut domain_goals = 0usize;
+    for n in fresh_nodes {
+        let Some(Expr::Apply { functor, pos_args, .. }) = n.as_expr() else { continue };
+        if kb.builtin_of(*functor) == Some(BuiltinTag::TypeDomain) && pos_args.len() == 2 {
+            let b = Value::Node(Rc::clone(&pos_args[1]));
+            let b = match pos_args[1].as_expr() {
+                Some(Expr::Spliced(v)) => kb.reify_value(v, merged),
+                _ => kb.reify_value(&b, merged),
+            };
+            if kb.mentions_var(&b, &|v| matches!(v, Var::Global(_))) {
+                domain_goals += 1;
+            }
+            continue;
+        }
+        if kb.builtin_of(*functor) != Some(BuiltinTag::ApplyDomain) || pos_args.len() != 3 {
+            continue;
+        }
+        let Some(Expr::Spliced(b)) = pos_args[2].as_expr() else { continue };
+        let b = kb.reify_value(b, merged);
+        if !kb.mentions_var(&b, &|v| matches!(v, Var::Global(_))) {
+            continue;
+        }
+        let d = Value::Node(Rc::clone(&pos_args[0]));
+        let d = kb.reify_value(&d, merged);
+        if kb.value_is_unbound_var(&d) {
+            unrouted += 1;
+        } else {
+            routed += 1;
+        }
+    }
+    if unrouted == 0 && routed == 0 && domain_goals == 0 {
+        return None;
+    }
+    let head_span = kb.rule_head_span(rid);
+    let (clause_scope, clause_place) = match head_span {
+        Some(sp) => {
+            let src = kb.source_name(sp.source);
+            (crate::dapcn_s1::scope_of_name(src), format!("{}:{}", src, sp.span.start))
+        }
+        None => ("?", String::new()),
+    };
+    let (cite_scope, cite_place) = dapcn_place(kb, original_goal);
+    let name = crate::kb::head_functor_and_arity(kb, kb.rule_head_value(rid))
+        .map(|(f, _)| kb.qualified_name_of(f).to_string())
+        .unwrap_or_default();
+    // Did the goal come in a citation's marker — typed at load as a citation, its routes
+    // computed there — or bare, a goal no load typed as a citation (a hand-built query term)?
+    let marked = if within_requirements_args(kb, original_goal).is_some() { "marked" } else { "bare" };
+    let detail = format!("`{name}` @ {clause_place} cited@ {cite_scope}:{cite_place} {marked}");
+    if routed > 0 {
+        crate::dapcn_s1::hit("R0-typed-column-routed", clause_scope, &detail);
+    }
+    let scope = if clause_scope == "stdlib" && cite_scope == "stdlib" { "stdlib" } else { "prog" };
+    if domain_goals > 0 {
+        let tag = if any_read_routed { "R0d-domain-goal-routed" } else { "R0d-domain-goal-unrouted" };
+        crate::dapcn_s1::hit(tag, clause_scope, &detail);
+        if !any_read_routed && unrouted == 0 && crate::dapcn_s1::refuse_run(scope) {
+            return Some(format!(
+                "DAPCN-S1 R0d: clause of `{name}` opened with {domain_goals} conformance goal(s) \
+                 whose type variable no citation fixed — the type would be read off the value"
+            ));
+        }
+    }
+    if unrouted == 0 {
+        return None;
+    }
+    crate::dapcn_s1::hit("R0-typed-column-unrouted", clause_scope, &detail);
+    crate::dapcn_s1::hit(&format!("R0-typed-column-unrouted-{marked}"), clause_scope, &detail);
+    crate::dapcn_s1::refuse_run(scope).then(|| {
+        format!(
+            "DAPCN-S1 R0: clause of `{name}` opened with {unrouted} typed column(s) whose type \
+             variable no citation fixed — the type would be read off the value"
+        )
+    })
+}
