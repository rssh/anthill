-- Rust binding for anthill.prelude.NamedTuple (proposal 004's extension): the host function
-- comparing two tuples' components through the sub-dictionaries of the tuple's dictionary.
namespace anthill.prelude
  provides NamedTuple language rust
    artifact "rustland/anthill-core/src/eval/builtins.rs"
    operation_map {
      namedTupleEq: "named_tuple_eq",
      hash: "named_tuple_hash"
    }
  end
end
