-- Rust binding for anthill.prelude.String. Proposal 038.
namespace anthill.prelude
  provides String language rust
    artifact "rustland/anthill-stl/src/prelude/string.rs"
    carrier { String: "String" }
    -- WI-876: `String`'s ordering is the host's lexicographic `Ord` — same total
    -- comparison functions `Int64` names, keyed to this carrier.
    operation_map {
      compare: "ordered_compare",
      gt: "ordered_gt",
      gte: "ordered_gte",
      lt: "ordered_lt",
      lte: "ordered_lte",
      max: "ordered_max",
      min: "ordered_min",
      -- WI-884: the SEARCH / EDIT surface, five operations that were declared on the
      -- sort and backed by nothing. The semantics each one commits to — the index
      -- unit for `indexOf`, and what the empty pattern means for all of them — are
      -- argued on the declarations in `stdlib/anthill/prelude/string.anthill`, which
      -- is where a reader of the spec will look.
      --
      -- `isEmpty` joined them: WI-884 shipped it defined by its own `[simp]` equation
      -- over `length`, and that is the one thing about it that is HOST-SPECIFIC and so
      -- belongs here. `length` counts UNICODE SCALARS, which is O(n) — `str::len` is
      -- O(1) but counts BYTES, and no host anthill is likely to target has an O(1)
      -- character count over UTF-8 (C++'s `std::string::size` is the same byte-length
      -- story). Emptiness is the one question that does not need the count.
      isEmpty: "string_is_empty",
      contains: "string_contains",
      indexOf: "string_index_of",
      replace: "string_replace",
      trim: "string_trim",
      split: "string_split",
      -- WI-1121 — `slug` classifies characters and `digestBase32` does integer bit
      -- arithmetic over bytes; `anthill.prelude.String` declares neither capability,
      -- so both are the host's. The SEMANTICS each commits to are argued on the
      -- declarations there, as for the search / edit surface above.
      slug: "string_slug",
      digestBase32: "string_digest_base32"
    }
    -- WI-644 / proposal 004: String is lawful — partial bases + total markers.
    provides PartialEq[T = String]
    provides Eq[T = String]
    provides PartialOrd[T = String]
    provides Ord[T = String]
  end
end
