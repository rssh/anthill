-- Rust binding for anthill.prelude.Float. Proposal 038.
namespace anthill.prelude
  import anthill.prelude.algebra.{Ring}

  provides Float language rust
    artifact "rustland/anthill-stl/src/prelude/float.rs"
    carrier { Float: "f64" }
    -- WI-876: `Float`'s comparisons are IEEE — a NaN operand is UNORDERED, so each
    -- answers false — and they are DIFFERENT host functions from the total ones
    -- `Int64`/`String`/`BigInt` name. No `compare`: `Float` provides no `Ord`.
    -- This is the fact that used to be a `float_pair` branch inside the shared
    -- spec-op builtin.
    --
    -- WI-881: and the ARITHMETIC below it. `Float` declared 32 operations and 8 ran;
    -- the rest were body-less with nothing behind them, so `sqrt(4.0)` died
    -- `OperationBodyMissing` on a program that loaded clean — a host carrier was exempt
    -- from the load-time backing check WHOLESALE (`check_provider_operations`), which
    -- WI-880 narrowed to a per-operation question now that backing is knowable per
    -- operation. `recip` is absent from this list ON PURPOSE: its equation in `stdlib/anthill/prelude/float.anthill` is
    -- an exact definition and carries `[simp]`, so it inlines instead of dispatching.
    -- Every other declared operation is here.
    operation_map {
      gt: "float_gt",
      gte: "float_gte",
      lt: "float_lt",
      lte: "float_lte",
      max: "float_max",
      min: "float_min",
      -- WI-880: the ARITHMETIC, IEEE — `add`/`sub`/`mul` SATURATE to an infinity
      -- where `Int64`'s raise. Same argument as the comparisons two lines up: the
      -- fact that Float's arithmetic is IEEE belongs in Float's binding, not in a
      -- branch inside a builtin registered on the spec op for every carrier.
      add: "float_add",
      sub: "float_sub",
      mul: "float_mul",
      abs: "float_abs",
      neg: "float_neg",
      floor: "float_floor",
      ceil: "float_ceil",
      round: "float_round",
      sqrt: "float_sqrt",
      hypot: "float_hypot",
      fmod: "float_fmod",
      pow: "float_pow",
      sin: "float_sin",
      cos: "float_cos",
      tan: "float_tan",
      asin: "float_asin",
      acos: "float_acos",
      atan: "float_atan",
      atan2: "float_atan2",
      exp: "float_exp",
      log: "float_log",
      log10: "float_log10",
      log2: "float_log2",
      pi: "float_pi",
      e: "float_e",
      tau: "float_tau",
      -- WI-880: the four WI-881 could not add because they were already registered by
      -- hardcoded qualified name in `eval/builtins.rs`. With those deleted, "every
      -- other declared operation is here" above is true of the whole sort rather than
      -- of the part WI-881 reached — `recip` stays the one deliberate absence.
      div: "float_div",
      isNaN: "float_is_nan",
      isInfinite: "float_is_infinite",
      isFinite: "float_is_finite"
    }
    -- WI-889: the three IEEE specials are `const`s, not operations, so they cannot ride
    -- `operation_map` (whose reader refuses a non-operation, WI-876). `const_map` is
    -- their channel — `host_fn` is the same `HOST_FNS` key the runtime resolves to the
    -- nullary value source. Before WI-889 these three were keyed by hardcoded qualified
    -- name in `eval/builtins.rs`; this clause is what deleted the RUNTIME's hardcoded
    -- list. (The rust source GENERATOR keeps its own `host_float_const_rust` table — it
    -- needs a Rust source spelling `f64::INFINITY`, not this registry key; see its note.)
    const_map {
      infinity: "float_infinity",
      negativeInfinity: "float_negative_infinity",
      nan: "float_nan"
    }
    -- WI-644 / proposal 004: IEEE Float provides only the PARTIAL specs — its `==`
    -- is not reflexive (nan) and not a congruence (-0.0/+0.0), so it is NOT a
    -- lawful Eq/Ord. `TotalFloat` (prelude) provides the total instances for
    -- when floats are needed as Map keys / sorted. (WI-835: a raw `Float` key IS a
    -- load error — `Map[K = Float]` / `Set[T = Float]` are refused wherever the
    -- type is written, off the `NonEq` fact below. The "WI-649" this comment named
    -- was a REPURPOSED number; the use-site check is WI-835.)
    -- WI-658: Float provides NonEq — a WITNESSED non-reflexivity (`nonEqRefl() =
    -- nan`, backed in the prelude sort). NonEq is mutually exclusive with the
    -- lawful Eq, so a user `provides Eq[Float]` is now a load error.
    provides PartialEq[T = Float]
    provides PartialOrd[T = Float]
    provides NonEq[T = Float]
    provides Numeric[T = Float]
    provides Ring[Float]
    -- WI-20260824-VT8CF — IEEE division, and the row a minted `/` over `Float` operands
    -- resolves against: `Field provides Divisible[T = T]`, so this one provision is what
    -- makes `10.0 / 4.0` reach `Float.div`. Before it, a bare `/` meant `Int64.div` and
    -- float division was a type error unless the file wrote
    -- `import anthill.prelude.Float.{div}` — which every float site in the corpus did.
    --
    -- APPROXIMATELY, and the library says so rather than pretending: rounding refutes
    -- the inverse law at the boundary exactly as it refutes `Ring`'s associativity just
    -- above. NOT `EuclideanDomain[Float]`, though every field is trivially one: its
    -- remainder is identically 0, and `Float.fmod` is the IEEE remainder instead — so
    -- `%` over floats stays unavailable, which is what it was before this ticket.
    provides Field[T = Float]
  end
end
