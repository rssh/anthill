-- Rust binding for anthill.prelude.Float. Proposal 038.
namespace anthill.prelude
  import anthill.prelude.algebra.{Ring}

  provides Float language rust
    artifact "rustland/anthill-stl/src/prelude/float.rs"
    carrier { Float: "f64" }
    -- WI-876: `Float`'s comparisons are IEEE — a NaN operand is UNORDERED, so each
    -- answers false — and they are DIFFERENT host functions from the total ones
    -- `Int64`/`String`/`BigInt` name. No `compare`: `Float` provides no `Ordered`.
    -- This is the fact that used to be a `float_pair` branch inside the shared
    -- spec-op builtin.
    operation_map {
      gt: "float_gt",
      gte: "float_gte",
      lt: "float_lt",
      lte: "float_lte"
    }
    -- WI-644 / proposal 004: IEEE Float provides only the PARTIAL specs — its `==`
    -- is not reflexive (nan) and not a congruence (-0.0/+0.0), so it is NOT a
    -- lawful Eq/Ordered. `TotalFloat` (prelude) provides the total instances for
    -- when floats are needed as Map keys / sorted. (WI-835: a raw `Float` key IS a
    -- load error — `Map[K = Float]` / `Set[T = Float]` are refused wherever the
    -- type is written, off the `NonEq` fact below. The "WI-649" this comment named
    -- was a REPURPOSED number; the use-site check is WI-835.)
    -- WI-658: Float provides NonEq — a WITNESSED non-reflexivity (`nonEqRefl() =
    -- nan`, backed in the prelude sort). NonEq is mutually exclusive with the
    -- lawful Eq, so a user `provides Eq[Float]` is now a load error.
    fact PartialEq[T = Float]
    fact PartialOrd[T = Float]
    fact NonEq[T = Float]
    fact Numeric[T = Float]
    fact Ring[Float]
  end
end
