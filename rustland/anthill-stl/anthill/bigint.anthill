-- Rust binding for anthill.prelude.BigInt. Proposal 038.
namespace anthill.prelude
  provides BigInt language rust
    artifact "rustland/anthill-stl/src/prelude/bigint.rs"
    carrier { BigInt: "num_bigint::BigInt" }
    -- WI-876: `BigInt`'s ordering — the same total comparison functions, keyed here.
    operation_map {
      compare: "ordered_compare",
      gt: "ordered_gt",
      gte: "ordered_gte",
      lt: "ordered_lt",
      lte: "ordered_lte",
      max: "ordered_max",
      min: "ordered_min",
      -- WI-20260824-VT8CF: division with remainder, the surface behind
      -- `provides EuclideanDomain[T = BigInt]` below.
      div: "bigint_div",
      mod: "bigint_mod",
      rem: "bigint_rem",
      -- WI-880: the ARITHMETIC, UNBOUNDED. No overflow arm — the column that makes
      -- the per-carrier keying an argument rather than a tidy-up.
      add: "bigint_add",
      sub: "bigint_sub",
      mul: "bigint_mul",
      neg: "bigint_neg",
      -- WI-880: the three CONVERSIONS, off the hardcoded list for the reason its
      -- siblings went.
      to_bigint: "bigint_to_bigint",
      to_int: "bigint_to_int",
      to_float: "bigint_to_float"
    }
    -- WI-644 / proposal 004: BigInt is lawful — partial bases + total markers.
    provides PartialEq[T = BigInt]
    provides Eq[T = BigInt]
    provides PartialOrd[T = BigInt]
    provides Ord[T = BigInt]
    provides Numeric[T = BigInt]
    -- WI-20260824-VT8CF: BigInt is the second Euclidean domain, and carries
    -- `Divisible[BigInt]` with it, so a minted `/` over BigInt operands resolves to the
    -- spec op and dispatches here. `Field[BigInt]` is absent for the reason `Int64`'s
    -- is: truncated division has no multiplicative inverse.
    provides EuclideanDomain[T = BigInt]
  end
end
