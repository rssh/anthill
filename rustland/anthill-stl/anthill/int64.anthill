-- Rust binding for anthill.prelude.Int64. Proposal 038 — host-specific
-- spec satisfaction lives separately from the language-agnostic spec
-- in stdlib/anthill/prelude/boundedint.anthill.
namespace anthill.prelude
  provides Int64 language rust
    artifact "rustland/anthill-stl/src/prelude/int.rs"
    carrier { Int64: "i64" }
    -- WI-876: which host function realizes each of `Int64`'s ordering operations.
    -- Before this clause existed there was nowhere to say it, so the implementation
    -- was registered on the SPEC op (`anthill.prelude.Ord.compare`) and served
    -- every carrier — including structural ones whose values it cannot compare.
    operation_map {
      compare: "ordered_compare",
      gt: "ordered_gt",
      gte: "ordered_gte",
      lt: "ordered_lt",
      lte: "ordered_lte",
      max: "ordered_max",
      min: "ordered_min",
      -- WI-884: the two BOUNDS, `i64::MIN` / `i64::MAX`. Nothing to settle — the
      -- carrier above says `i64`, and these are its ends.
      minValue: "int_min_value",
      maxValue: "int_max_value",
      -- WI-880: the ARITHMETIC. `Int64`'s three are the CHECKED ones — an overflow
      -- raises `Overflow` rather than wrapping — which is a different operation from
      -- `Float`'s saturating pair and from `BigInt`'s unbounded one. All three used to
      -- be one registration on `anthill.prelude.Additive.add` that told them apart by
      -- testing its operands; the carrier is the right place for that choice, and this
      -- is it. `neg` moves here from the hardcoded `register_if_present` list for the
      -- same reason its siblings did (WI-884's split, which this ticket closes).
      add: "int_add",
      sub: "int_sub",
      mul: "int_mul",
      neg: "int_neg",
      -- WI-880: and the rest of `Int64`'s host surface, which WI-884 left registered by
      -- hardcoded qualified name. `divExact` names the SAME function as `div` — it is a
      -- historical alias a stdlib rule rewrites — which this list says outright where
      -- two `register_if_present` lines said it by repetition.
      abs: "int_abs",
      mod: "int_mod",
      rem: "int_rem",
      div: "int_div",
      divExact: "int_div",
      sign: "int_sign",
      to_float: "int_to_float",
      to_string: "int_to_string"
    }
    -- WI-644 / proposal 004: Int64 is lawful — it provides the partial bases
    -- (PartialEq/PartialOrd) AND the total markers (Eq/Ord).
    provides PartialEq[T = Int64]
    provides Eq[T = Int64]
    provides PartialOrd[T = Int64]
    provides Ord[T = Int64]
    provides Numeric[T = Int64]
    -- WI-20260824-VT8CF — `Int64` is where division-with-remainder lives, so `/` and
    -- `%` written over `Int64` operands reach `Int64.div` / `Int64.mod` / `Int64.rem`
    -- by the short-name join on THIS provision. It carries `Divisible[Int64]` with it
    -- (`EuclideanDomain provides Divisible[T = T]`), which is the row `/` resolves
    -- against; writing both would be the inconsistency that `provides`-chaining exists
    -- to prevent. `Field[Int64]` is deliberately absent: truncated division has no
    -- multiplicative inverse (`div(7, 2) * 2 = 6`, not 7).
    provides EuclideanDomain[T = Int64]
  end
end
