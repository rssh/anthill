-- The anthill.stage0 domain: entity types for project management
--
-- This is the standard domain shipped with anthill. The `project`, `tool`,
-- `workitem`, and `feedback` sugar desugars to facts of these entity types.
--
-- This file is provided for reference. In practice, the domain is loaded
-- automatically when stage0 sugar is used.

namespace anthill.stage0
  import anthill.prelude.{List, Option}
  import anthill.reflect.{Term, Symbol}
  -- WI-909: the constructors left the implicit tier, so a bare `none` takes a
  -- member import. Importing the SORT does not bring its members into scope (§8.6),
  -- and a constructor in a HEAD ARGUMENT has no loud check — see the driven case at
  -- `stdlib/anthill/reflect/typing.anthill`.
  import anthill.prelude.Option.{none}

  -- =================================================================
  -- Project structure
  -- =================================================================

  entity Project(
    name       : String,
    language   : Option[T = String],
    build      : Option[T = String],
    modules    : Option[T = List[T = String]],
    sources    : Option[T = List[T = SourceRoot]],
    tools      : List[T = String],
    domains    : Option[T = List[T = String]]
  )

  entity Module(
    name       : String,
    root       : String,
    language   : String,
    build      : Option[T = String],
    sources    : Option[T = List[T = SourceRoot]]
  )

  entity SourceRoot(
    path       : String,
    language   : Option[T = String],
    scope      : SourceScope
  )

  enum SourceScope
    entity Main
    entity Test
    entity Generated
    entity Docs
  end

  -- =================================================================
  -- Tool definitions and packs
  -- =================================================================

  entity ToolDef(
    name       : String,
    command    : String,
    args       : Option[T = List[T = String]],
    working_dir: Option[T = String],
    timeout    : Option[T = Int64],
    success    : SuccessCriterion
  )

  enum SuccessCriterion
    entity ExitZero
    entity ExitCode(code: Int64)
    entity OutputMatches(pattern: String)
    entity Custom(term: Term)
  end

  entity ToolPack(
    name       : String,
    tools      : List[T = String]
  )

  -- =================================================================
  -- Work items
  -- =================================================================

  entity WorkItem(
    id          : String,
    -- WI-1121: WHEN THE ITEM WAS FILED, ISO-8601 UTC (`2026-08-17T10:22:03Z`) —
    -- the same spelling `status`'s `since`/`at` payloads carry. A REQUIRED field,
    -- and it earns that twice over:
    --
    --   * it is an input to the id (design §6.5): an id minted from content is
    --     partitioned by day, so an item with no creation time has no partition
    --     and cannot be minted at all;
    --   * it is what `list` ORDERS BY. Until this field existed the tracker's
    --     chronological order was an ACCIDENT of ids being dense and ascending —
    --     `WI-1114` after `WI-437` because the counter said so. A content-derived
    --     id keeps that order only because its first segment is this timestamp,
    --     and a re-minted or hand-written id would lose it; the field is the
    --     truth the rendering is derived from.
    --
    -- It is never rewritten. `update` edits the description, `claim` the status;
    -- nothing edits `created`, which is what lets the id minted from it stay
    -- stable while the description it was also minted from drifts.
    created     : String,
    -- WI-K63ZV: THE ITEM'S STATE IS THE LAST CHANGE TO IT.
    --
    -- `WorkStatus` used to be a SUM WITH PAYLOADS, and the payloads were
    -- irregular — `since` on Claimed/Stale against `at` on the other four,
    -- `agent` on only two, and `Verified` carrying no agent at all, so "who
    -- verified this" was unrecorded. That was a defect rather than a design:
    -- every status is a transition somebody made at some time. Once the
    -- companions are uniform the sum has nothing left to discriminate, so
    -- `WorkStatus` is a plain enum of labels and what carries the transition is
    -- a `StatusChange`.
    --
    -- IT IS WRITTEN FLAT IN THE DOCUMENT, as `status` / `status_agent` /
    -- `status_at` / `status_reason` — see `FlatRecord` in
    -- `anthill.stage0.document`. That is what keeps the attributes chapter one
    -- line per datum, and it is also what lets the rejection REASON become a
    -- chapter: per field, the longest value ever written on this tracker was a
    -- 1842-character `status`, because a reason is prose WI-1120 missed while it
    -- was buried inside a variant payload.
    last_status_change : StatusChange,
    -- WI-928: `String`, not `Term`. A `String` literal is NOT a `Term` — the
    -- value↔Term crossing is an explicit conversion (`as_term`, WI-406), not
    -- subsumption — and every description in workitems.anthill is prose: the
    -- first load that checked this field reported 921 mismatches over it (894
    -- more over `Feedback.content` below) and not one row held anything else.
    -- It went unchecked because a free-standing entity emitted no `SortInfo`, so
    -- no load-time pass ever compared the declaration to the data; the
    -- `sort WorkItem { entity WorkItem(…) }` spelling would have refused them all.
    description : Option[T = String],
    context     : Option[T = List[T = ContextRef]],
    acceptance  : List[T = AcceptanceCriterion],
    depends_on  : Option[T = List[T = String]],
    generates   : Option[T = List[T = Term]],
    requires_capability : Option[T = List[T = Capability]]
  )

  enum ContextRef
    entity FileRef(path: String, lines: Option[T = String])
    entity FactRef(domain: String, pattern: Term)
    entity WorkItemRef(id: String)
  end

  enum AcceptanceCriterion
    entity ToolPasses(tool: String, params: Option[T = Term])
    entity FactHolds(domain: String, pattern: Term)
    entity Compiles(source: SourceRoot)
    entity Constraint(term: Term)
  end

  -- One transition of one item: what it moved to, who moved it, when, and why.
  --
  -- WRITTEN FLAT in a document (`FlatRecord`, `anthill.stage0.document`), as
  -- `status` / `status_agent` / `status_at` / `status_reason`. The record is the
  -- concept and the flattening is a rendering: `status` is the most-read field
  -- in the whole format — the directory mirrors it, `fsck` checks the path
  -- against it, `list` groups by it — so it stays a top-level line rather than
  -- moving into a sub-section of its own.
  entity StatusChange(
    status : WorkStatus,
    agent  : Option[T = String],
    at     : Option[T = String],
    reason : Option[T = String])

  -- A PLAIN NULLARY ENUM (WI-K63ZV): a label, not a sum. Once every transition
  -- carries the same companions there is nothing left for a payload to
  -- discriminate — see `StatusChange` above.
  enum WorkStatus
    entity Draft         -- description still being authored; not ready for review
    entity PreOpened     -- captured idea / future direction; not yet committed to the active queue (cannot be claimed until promoted to Open)
    entity Open          -- in the active queue; available to claim
    entity Claimed
    entity Delivered
    entity Verified
    entity Rejected
    entity ProposalRejected
    entity Stale
  end

  -- =================================================================
  -- What the record has to state, and what it deliberately does not
  -- =================================================================
  --
  -- A `StatusChange` is UNIFORM: somebody made it, at some time, and may have
  -- said why. None of that is variant-specific, and reading a distribution off
  -- the old sum would freeze its defects into the schema — `agent` appeared on
  -- Claimed and Delivered only, `Verified` carried none at all, `since` on
  -- Claimed/Stale against `at` on the other four, and Draft / PreOpened / Open
  -- carried nothing though somebody performed each of those transitions too.
  --
  -- `agent` and `at` are `Option` because of HISTORY, not because the domain is
  -- unsure: 985 of 1127 items had already lost who claimed them by the time this
  -- was written, because `Delivered` overwrote `Claimed` in place, and no `Open`
  -- item ever recorded one. Migration synthesizes nothing, so those rows arrive
  -- with `none` and say so — inventing an agent for 985 items is the one outcome
  -- worse than a gap. Every command writes both from here on.
  --
  -- `reason` is `Option` for a different reason: most changes have nothing to
  -- explain. It is NOT variant-specific — unclaiming because you are blocked, or
  -- delivering with a caveat, are both worth recording. What IS real, and is the
  -- one thing the old type enforced that survives, is the other direction:
  --
  --   AN OFF-RAMP WITH NO STATED REASON IS USELESS.
  --
  -- Rejecting an item without saying why leaves nobody able to act on it, so
  -- that stays a LOAD ERROR rather than a convention the commands are trusted to
  -- keep. Everything else about a reason is a command-level rule (`update`
  -- refuses `--reason` where it would have nothing to attach to), not a fact
  -- about the domain.
  constraint rejected_names_its_reason :-
    WorkItem(last_status_change: StatusChange(status: Rejected, reason: none))
  constraint proposal_rejected_names_its_reason :-
    WorkItem(last_status_change: StatusChange(status: ProposalRejected, reason: none))
  constraint stale_names_its_reason :-
    WorkItem(last_status_change: StatusChange(status: Stale, reason: none))

  -- =================================================================
  -- Agent capabilities
  -- =================================================================

  enum Capability
    entity Code(languages: List[T = String])
    entity Test
    entity Refine
    entity Review
    entity Decompose
    entity Architect
    entity HumanJudgment
  end

  -- =================================================================
  -- Feedback
  -- =================================================================

  entity Feedback(
    workitem : String,
    author   : String,
    content  : String,       -- WI-928: prose, like WorkItem.description above
    at       : String
  )

  -- =================================================================
  -- Tags / named lists
  -- =================================================================
  --
  -- A Tag attaches a named list (e.g. "typing") to a work item. A work
  -- item may carry several tags (several Tag facts). Tags drive the
  -- ordered build-loop view: `list --tag <name>` shows a tag's items in
  -- dependency (topological) order with status.

  entity Tag(
    workitem : String,
    name     : String
  )

end

-- =================================================================
-- The item document format (WI-K63ZV)
-- =================================================================
--
-- Specification: `rustland/anthill-todo/docs/design/document-mapping.md`. An
-- item file is a sequence of markdown CHAPTERS: one holds the item's own fact
-- as DATA, the rest hold prose. This is the declaration that says which.
--
-- WHY, measured on this repo's own tracker: an item's head was ONE physical
-- line, 279 characters on average and 2062 at its longest, so two agents
-- editing two DIFFERENT fields of one item conflicted in git. Measured on real
-- 3-way merges, one field per line is not enough either — with nothing between
-- the two edited lines git still conflicts, and with one unchanged line between
-- them it merges. So the blank line is the prize, and `FieldGroup` is where the
-- format states which fields deliberately do NOT get one.
--
-- BUNDLED WITH THE DOMAIN, NOT IN `project.anthill`, on the `StoreFormat`
-- precedent: the encoding is a property of the SCHEMA, not of the project, so a
-- project has nothing new to write.
namespace anthill.stage0.document
  import anthill.prelude.{List, String, Int64}
  import anthill.reflect.{Term}
  import anthill.stage0.{WorkItem, Feedback, Tag, AcceptanceCriterion, ToolPasses}
  import anthill.stage0.{StatusChange}

  -- `level` is the first structural level; `attributes` names the chapter that
  -- holds a document's own fact as data.
  --
  -- `level: 2` IS DECIDED, NOT DEFAULTED. Raising the structure by one —
  -- `Description` becoming an `h1` — buys one more level of prose depth
  -- everywhere, which is worth most inside a feedback entry, where three
  -- authored heading levels already fit exactly with nothing to spare. It was
  -- weighed and declined: an `h1` renders too large for a page carrying three or
  -- four of them. Recorded because the parameter is cheap to change NOW and
  -- expensive later — every heading in every file shifts.
  entity DocumentFormat(
    level      : Int64,
    attributes : String)

  -- Fields written ADJACENT, with no blank line between them.
  --
  -- A group's fields describe one state that changes as a unit, so adjacency
  -- makes a concurrent edit to two of them a conflict — which is what it should
  -- be. Fields that are never rewritten belong in a group for the same reason:
  -- nothing can conflict over them.
  entity FieldGroup(
    functor : Term,
    fields  : List[String])

  -- A bare scalar `s` in a position of this sort denotes `constructor(slot: s)`.
  entity ScalarForm(
    sort        : Term,
    constructor : Term,
    slot        : String)

  -- A prose field of the item's fact: one chapter, fixed name.
  --
  -- A MAPPED FIELD IS ALWAYS A CHAPTER, however short its text. One spelling, so
  -- nothing has to decide per value and nothing has two homes: `description`
  -- gets a chapter when it is the single word `test`. The alternative — short
  -- values inline, long values in a chapter — is a threshold to pick, two shapes
  -- for one datum, and a writer that changes a file's structure when prose grows.
  entity Chapter(
    functor : Term,
    field   : String,
    named   : String)

  -- A repeated satellite WITH prose: one container, one entry per fact.
  --
  -- `kind` is the word that says which functor an entry belongs to. A container
  -- holding ONE kind still writes it: one spelling, and a second kind added
  -- later is then additive rather than a fourth rewrite of every file.
  --
  -- `key` is filled from the item's own `id` and is never written in the
  -- document — an entry in this file is about this item. It comes from the `id`
  -- ATTRIBUTE and never from the filename: taking it from the path would make a
  -- hand-renamed file silently re-attribute every entry in it, while the
  -- filename-versus-`id` check reported the rename as an unrelated fault.
  entity ChapterGroup(
    functor   : Term,
    container : String,        -- several groups may share one
    kind      : String,        -- the word discriminating this group's entries
    key       : String,        -- the field taking the item's id
    heading   : List[String],  -- fields carried by the entry heading, in order
    field     : String)        -- the field carried by the entry body

  -- A repeated satellite WITHOUT prose: one attributes field holding a list,
  -- one fact per element.
  --
  -- `fields` is a LIST because a satellite's written value is not always one
  -- datum. `Tag` writes one (`- tags: prover, typing`); `MirrorEntry` writes two
  -- — WHICH external system, and WHICH entry there — and neither half identifies
  -- the row alone (WI-1117). An element writes them in this order, joined by `=`
  -- when there is more than one, so the one-field case is exactly what it was.
  -- The last field takes the remainder on read, which is what lets an external id
  -- carry a `=` of its own.
  --
  -- NOT a `ChapterGroup`: that one's body field is PROSE, and an opaque external
  -- id written as a paragraph would claim to be something it is not.
  entity SatelliteList(
    functor : Term,
    named   : String,             -- the attributes field
    fields  : List[T = String],   -- the fields each element fills, in order
    key     : String)             -- the field taking the item's id

  -- A RECORD-VALUED field written as SIBLING attribute lines rather than as one
  -- nested value.
  --
  -- WHY AT ALL: the attributes chapter is one line per datum, and a nested
  -- record has no data spelling — written whole it would land as a single
  -- backticked term, which is exactly the one long line this format exists to
  -- break up. Flattening is what lets `StatusChange` be a record in the domain
  -- and four independently mergeable lines on the page.
  --
  -- THE NAMING RULE, and its one deliberate exception: the record's FIRST
  -- declared field takes `prefix` as its whole name, and every other field takes
  -- `<prefix>_<field>`. So `StatusChange` under prefix `status` writes `status`,
  -- `status_agent`, `status_at`, `status_reason`. The exception exists because
  -- the first field is the record's HEADLINE — the value the directory mirrors
  -- and §10 checks the path against — and `status_status` is not a name anyone
  -- would write. The expanded names are checked against the functor's own
  -- fields, so a collision is a refusal rather than a silent shadow.
  entity FlatRecord(
    functor : Term,
    field   : String,   -- the record-valued field of `functor`
    prefix  : String)   -- the attribute name its first field takes

  fact DocumentFormat(level: 2, attributes: "Attributes")

  fact FlatRecord(functor: WorkItem, field: "last_status_change", prefix: "status")

  -- `id` and `created` are never rewritten, so nothing can conflict over them.
  -- The status group is the one that MUST be adjacent: two concurrent status
  -- edits should collide rather than interleave into a half-transition.
  fact FieldGroup(functor: WorkItem, fields: ["id", "created"])
  fact FieldGroup(functor: WorkItem, fields: ["status", "status_agent", "status_at"])

  -- `acceptance` is 100% `ToolPasses` — 1157 occurrences, 8 distinct values —
  -- so the whole field reads `cargo-test, scaland-sbt-test` and the rare
  -- `FactHolds` takes the backticked term spelling.
  fact ScalarForm(
    sort: AcceptanceCriterion, constructor: ToolPasses, slot: "tool")

  fact Chapter(functor: WorkItem, field: "description",   named: "Description")
  fact Chapter(functor: WorkItem, field: "status_reason", named: "Reason")

  -- ENTRIES CARRY A KIND AND NOTHING IS SYNTHESIZED. `## Changes` holds only
  -- recorded feedback: real status history cannot be migrated, since 985 of 1127
  -- items had already lost who claimed them and when, and `untag` never left a
  -- record. A log that begins partly fictional is worse than one that begins
  -- short. The kind word is paid now so that status and tag entries are ADDITIVE
  -- when they begin to accumulate.
  fact ChapterGroup(
    functor: Feedback, container: "Changes", kind: "feedback",
    key: "workitem", heading: ["at", "author"], field: "content")

  -- `Tag` carries no prose, so it is one comma-separated element of one
  -- attributes field rather than a chapter of its own.
  fact SatelliteList(
    functor: Tag, named: "tags", fields: ["name"], key: "workitem")
end
