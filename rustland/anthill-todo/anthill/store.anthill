-- WorkItemStore: project-side spec + file-backed implementation.
--
-- Per proposal 036 (Domain Store Sorts) / WI-203. The spec lives over
-- Cell[V = State] so the Cell protocol (Modify[s], Cell.get, Cell.set)
-- applies uniformly. State is the data-shape; each impl picks its own
-- value-shape and bodies via a `fact WorkItemStore[State = …]`.
--
-- Spec returns typed `WorkItem` (WI-204 phase B1): retrieve results
-- materialize through reflect.term_as_entity (WI-260) so callers receive
-- pattern-matchable `WorkItem` entities instead of opaque `Term`s.

namespace anthill.todo.store
  import anthill.stage0.{WorkItem, WorkStatus, Feedback, Tag, StoreFormat}
  import anthill.persistence.{NonMonotonicStore}
  import anthill.persistence.{persist, retract, update, flush}
  import anthill.prelude.{Cell, Option, List, Int64, String, Unit, Bool}
  import anthill.prelude.Int64.{to_string}
  -- WI-1121: `slug` and `digestBase32` are the two halves of a minted id — the
  -- readable one and the identifying one. Both are host-backed (they classify
  -- characters / do bit arithmetic), and both are ordinary `String` operations,
  -- so nothing here knows how the digest is computed.
  import anthill.prelude.String.{concat, substring, startsWith, toLower,
                                 isEmpty, slug, digestBase32}
  import anthill.prelude.Eq.{eq}
  import anthill.prelude.Meta.{Meta}
  import anthill.prelude.Option.{none, some}
  import anthill.prelude.List.{nil, cons}
  import anthill.reflect.{Term, StoredRef, term_as_entity, term_field, term_as_string,
                          term_functor_name, as_term}
  import anthill.reflect.StoredRef.{stored_ref}
  import anthill.reflect.{fact_monotonicity, non_monotone}
  import anthill.reflect.KB.{kb, facts_of, stored_facts_of}

  -- ─── 0. Fact monotonicity (proposal 053) ───────────────────────
  -- This store owns WorkItem, Feedback and Tag and RETRACTS all three at
  -- runtime (forget / replace / untag_item), so all three are non_monotone.
  -- StoreFormat is only ever persisted → it keeps the `monotone` default
  -- (append-only). The retract guard consults these rules.
  --
  -- FEEDBACK WAS `monotone` UNTIL WI-1123, and flipping it is a decision, not
  -- an oversight being corrected. Append-only was meant as "an item's history
  -- is never rewritten", which is still the rule this tracker keeps. But the
  -- policy is per-FUNCTOR, so it ALSO said "a feedback row outlives the item
  -- it describes", and that half was never intended: `forget` retracted the
  -- WorkItem row and stranded every Feedback row naming it, leaving rows that
  -- describe an id nothing holds. Under the shared file that was invisible;
  -- under ItemPerFileStore it is a `LayoutFault::OrphanRow` at every startup
  -- (measured on this repo's own tracker during WI-1118's rehearsal — two of
  -- them, for months). Proposal 053's vocabulary has three values and none
  -- spells "retractable only together with its item", so the closest TRUE
  -- policy is non_monotone; what keeps the audit trail is the COMMAND SURFACE,
  -- which offers no way to retract a Feedback row on its own.
  rule fact_monotonicity(WorkItem) = non_monotone() [simp]
  rule fact_monotonicity(Feedback) = non_monotone() [simp]
  rule fact_monotonicity(Tag) = non_monotone() [simp]

  -- ─── 1. Spec ────────────────────────────────────────────────────
  -- Operations declared once, parameterized by State. Each impl
  -- supplies its own State value-shape and bodies via a fact.
  sort WorkItemStore
    sort State = ?

    -- MINT THE ID OF AN ITEM ABOUT TO BE FILED (WI-1121, design §6.5).
    --
    -- It is not `next_id(s)` any more, and the shape change IS the design: there
    -- is no "next", because there is no counter and no sequence. An id is
    -- DERIVED from the item — `WI-<YYYYMMDD>-<5 Crockford base32>-<slug>` over
    -- the author who is filing it, the moment they filed it, and what they wrote
    -- — so the three inputs have to arrive as arguments. Two people filing
    -- offline on the same afternoon mint different ids without exchanging a
    -- byte, which is the whole point.
    --
    -- READ-ONLY, and that is the second half of the same change: `next_id` bumped
    -- a counter, so it carried `Modify[s]`; this reads the tracker to see whether
    -- its candidate is taken and writes nothing. The item is written by `commit`,
    -- as it always was.
    --
    -- IDEMPOTENT. Deriving rather than drawing means a retried `add` re-derives
    -- the SAME id and finds its own half-written item there, so it heals instead
    -- of filing a second one. An implementation must preserve that while
    -- resolving genuine collisions — see the impl for the one comparison that
    -- tells the two apart.
    operation mint_id(s: Cell[V = State], author: String, created: String,
                      description: String) -> String
      effects Error

    -- Mutating ops: Modify[s] covers everything reachable from s
    -- (per proposal 037 transitivity).
    operation commit(s: Cell[V = State], w: WorkItem) -> Unit
      effects {Modify[s], Error}
    -- Remove the work item `id` AND every satellite row that describes it —
    -- the Feedback and Tag rows keyed `workitem: id` (WI-1123). A satellite
    -- names its item by primary key and means nothing without it, so the two
    -- are one act: retracted in ONE flush, which is also what lets the
    -- per-file layout drop the item's file rather than leave it holding
    -- stranded rows. It deliberately does NOT touch other work items that
    -- name `id` in their `depends_on` — that is a cascade over the ITEM
    -- graph, a different and far more destructive operation; the caller
    -- reports those edges instead (cmd_delete).
    operation forget(s: Cell[V = State], id: String) -> Unit
      effects {Modify[s], Error}
    -- Atomic update: retract the existing block for `id` and persist `w`
    -- in ONE flush, so an update can't half-apply the way `forget` then
    -- `commit` (two separate flushes) can. The retract+persist buffer and
    -- a single flush writes them; a mid-step failure surfaces through the
    -- Error effect before the flush, so nothing is written (the unflushed
    -- buffer is discarded at process exit — each command is one process).
    operation replace(s: Cell[V = State], id: String, w: WorkItem) -> Unit
      effects {Modify[s], Error}
    -- Feedback persistence routes through the same backend as
    -- commit so cmd_X bodies have a single point of mutation
    -- (no separate FileStore handle threaded through dispatch).
    operation commit_feedback(s: Cell[V = State], fb: Feedback) -> Unit
      effects {Modify[s], Error}
    -- Tag persistence (the WI-388 named-list primitives in the bundle):
    -- tag_item persists a `fact Tag(workitem, name)` through the same
    -- backend; untag_item retracts the matching Tag fact. Existence
    -- checks live in the cmd layer via has_tag.
    operation tag_item(s: Cell[V = State], id: String, name: String) -> Unit
      effects {Modify[s], Error}
    operation untag_item(s: Cell[V = State], id: String, name: String) -> Unit
      effects {Modify[s], Error}
    -- Stamp the store's data-format version (WI-434): persist a
    -- `fact StoreFormat(version)` through the same backend. `migrate` calls
    -- this to bring a pre-versioning project up to the current format; the
    -- stamp lives in the store's own file, so this stays a bundle concern
    -- rather than host text-writing.
    operation stamp_format(s: Cell[V = State], version: Int64) -> Unit
      effects {Modify[s], Error}

    -- Read-only ops: typed WorkItem returns (WI-204 phase B1). They may raise
    -- `Error` (the backing store can fail on read) — declared here so a concrete
    -- impl's `effects Error` refines rather than widens the spec (WI-347).
    operation lookup(s: Cell[V = State], id: String) -> Option[T = WorkItem]
      effects Error
    operation by_status_of(s: Cell[V = State], st: WorkStatus)
      -> List[T = WorkItem]
      effects Error
    operation all(s: Cell[V = State]) -> List[T = WorkItem]
      effects Error
    operation has_tag(s: Cell[V = State], id: String, name: String) -> Bool
      effects Error
    -- Work-item ids carrying tag `name` (unordered, may repeat if the
    -- store holds duplicate Tag facts; callers sort/dedup).
    operation items_with_tag(s: Cell[V = State], name: String) -> List[T = String]
      effects Error
    -- Tag names carried by work item `id` (unordered; callers sort/dedup).
    operation tags_of(s: Cell[V = State], id: String) -> List[T = String]
      effects Error
    -- The stored fact TERM for `id` — for consumers that must render the
    -- original sub-terms verbatim (show's Context/Acceptance sections).
    operation raw_term_of(s: Cell[V = State], id: String) -> Option[T = Term]
      effects Error
  end

  -- ─── 2. File-backed impl ────────────────────────────────────────
  -- The WIS state holds a filesystem backend plus a fresh-id counter. No
  -- in-memory by_id / by_status caches: every read goes through
  -- `facts_of(kb(), …)`, which answers from the rows the loader put in the
  -- KB — so this impl needs `persist` / `retract` / `update` / `flush` from
  -- its backend and nothing else.
  --
  -- WI-1114: `backend` is typed by the SPEC, not by one backend. It used to
  -- read `backend: IndexedFileStore`, which pinned this whole impl to a single
  -- storage layout — the second one (`ItemPerFileStore`, one file per item)
  -- could be declared in a project's binding and built by the host, and then
  -- would not type here. `NonMonotonicStore` is the algebra this body actually
  -- consumes: it retracts (forget / replace / untag_item), so the mutation
  -- capability is a REQUIREMENT of the impl and saying so is what makes the
  -- backend swappable. It is deliberately not `QueryableStore` — nothing here
  -- calls `retrieve`, and demanding it would refuse a perfectly good backend
  -- for an operation this impl never performs.
  sort FileBasedWorkitemStore
    -- WI-1121: `id_counter` is GONE. It was the last piece of allocation state,
    -- seeded by the host from the highest `WI-NNN` on disk — which is exactly
    -- the id-collision bug design §1.2 names, since two checkouts scanning their
    -- own trees seed the same number and hand it out twice. `mint_id` derives an
    -- id from the item instead, so there is no counter to seed, nothing for the
    -- host to scan, and nothing to carry between commands.
    enum WIS
      entity wis(backend: NonMonotonicStore)
    end

    provides WorkItemStore[State = WIS]

    -- THE STATE FACTORY (WI-1114). The host used to build this value itself,
    -- interning `…FileBasedWorkitemStore.wis` and its two field names — the last
    -- place a host knew one impl's INTERNALS, as opposed to the one native step
    -- it legitimately owns (mapping a declared store term to a compiled-in
    -- backend). It calls this instead, and the shape of the state is now the
    -- impl's business alone. That is what has to be true before a second
    -- `WorkItemStore` impl with a different state can be selected at all
    -- (design §8.2, "what remains coupled").
    --
    -- IT LIVES ON THE IMPL, NOT ON THE SPEC, and deliberately: a state factory's
    -- PARAMETERS are the impl's own. Under coordination the counter disappears
    -- entirely (§8.3 — `alloc_id` reads the forge registry instead of counting),
    -- so a spec-level `open(backend, next)` would fix one impl's parameter list
    -- across every future one, which is the coupling this removes wearing a
    -- different hat.
    --
    -- WHAT IT IS NOT: §8.2's `open_store` existential. That one SELECTS between
    -- impls, and WI-402's `-> C ensures Spec[C, …]` does not fit a spec whose
    -- carrier is its dictionary and whose value is its `State` — §8.2.2 carries
    -- the measurement. Selection is already done, by `sort Main`'s
    -- `requires WorkItemStore[State]` and the host's requirement dictionary.
    operation open(backend: NonMonotonicStore) -> WIS =
      wis(backend)

    -- ─── Minting (WI-1121, design §6.5) ──────────────────────────
    --
    -- `WI-` <YYYYMMDD> `-` <5 Crockford base32> [ `-` <slug> ], each part doing a
    -- different job: the DAY orders (a lexicographic sort is chronological, so
    -- `ls`, a sorted `depends_on` and a plain `sort` all read in order with no
    -- comparator that knows anything); the DIGEST identifies, and is the only
    -- part that does; the SLUG describes, and may be absent.
    --
    -- THE SLUG IS NOT COMPARED, and that is the sharp consequence of the split.
    -- Two items whose digests collide have different descriptions, hence
    -- different slugs, hence different FILENAMES — so a duplicate check that
    -- compared whole id strings would miss every collision. Everything below
    -- keyed on occupancy compares the `WI-<day>-<digest>` IDENTITY PREFIX.
    operation mint_id(s: Cell[V = WIS], author: String, created: String,
                      description: String) -> String
      effects Error
    =
      mint_attempt(s, author, created, description, 0)

    -- An ATTEMPT COUNTER makes a single writer collision-proof, because the CLI
    -- holds the whole tracker and can look before it writes: re-hash until the
    -- identity prefix is free. Measured on this repo — 78 active days, mean 9.9
    -- items a day, busiest day 35 — a re-hash essentially never happens.
    --
    -- THE ONE INTERACTION TO GET RIGHT is that this must not break idempotent
    -- retry. When the prefix is occupied, compare the occupant: same `created`
    -- and same description means it IS this item, written by a half-finished
    -- earlier run, so succeed with the id already on disk. Only a genuinely
    -- different item advances the attempt.
    --
    -- `author` is deliberately NOT part of that comparison, and the reason is
    -- that it cannot matter: it IS part of the digest input, so two items
    -- differing only in author already have different digests and never reach
    -- here. A work item does not record its author, so comparing what the row
    -- holds is both possible and sufficient.
    operation mint_attempt(s: Cell[V = WIS], author: String, created: String,
                           description: String, attempt: Int64) -> String
      effects Error
    =
      let prefix = identity_prefix(created,
        digestBase32(digest_input(author, created, description, attempt), 5))
      match occupant_of(facts_of(kb(), WorkItem), prefix)
        case none() -> compose_id(prefix, slug(description, 30))
        case some(t) ->
          if is_same_item(t, created, description) then
            string_field_of(t, "id")
          else mint_attempt(s, author, created, description, attempt + 1)

    -- The digest's input. Joined with a separator no field of a work item is
    -- expected to carry ALONE on a line — the join only has to be injective
    -- enough that two different items rarely produce one string, which is the
    -- same job the digest itself is doing one layer down.
    operation digest_input(author: String, created: String, description: String,
                           attempt: Int64) -> String =
      concat(author, concat("\n", concat(created, concat("\n",
        concat(description, concat("\n", to_string(attempt)))))))

    -- `WI-` + the day + `-` + the digest: the part of an id that IS the identity.
    operation identity_prefix(created: String, digest: String) -> String =
      concat("WI-", concat(day_of(created), concat("-", digest)))

    -- `2026-08-17T10:22:03Z` -> `20260817`. THE PARTITION, and the scaling lever:
    -- two items can only collide inside one, so a project filing one item a
    -- second wants an hour here rather than a day. The fix for scale is a finer
    -- time, never a longer digest (§6.5) — at that rate the DIRECTORY fails first.
    --
    -- A `created` that is not a timestamp yields a short partition rather than
    -- trapping; the shape is checked once, loudly, at startup (Main's
    -- `items_missing_created`), so this stays total.
    --
    -- The three fields are CUT rather than the separators stripped, deliberately:
    -- `replace(…, "-", "")` would also swallow a `-` from a garbled stamp and
    -- turn it into a shorter partition that still looks like one, and this sort
    -- may not import `replace` in any case — it declares its own (proposal 059
    -- R4 refuses a member that captures a name already in scope).
    operation day_of(created: String) -> String =
      concat(substring(created, 0, 4),
        concat(substring(created, 5, 7), substring(created, 8, 10)))

    operation compose_id(prefix: String, slug_text: String) -> String =
      if isEmpty(slug_text) then prefix
      else concat(prefix, concat("-", slug_text))

    -- The stored WorkItem term whose id carries `prefix` as its identity, if any.
    -- MATCHED AS A SEGMENT, not as a raw prefix: the id either IS the prefix (an
    -- empty slug) or continues with `-`, so `WI-20260817-K7M2Q` cannot be read as
    -- occupying `WI-20260817-K7M2` — different digests, different items.
    operation occupant_of(ts: List[T = Term], prefix: String) -> Option[T = Term] =
      match ts
        case nil() -> none()
        case cons(t, rest) ->
          if occupies(string_field_of(t, "id"), prefix) then some(t)
          else occupant_of(rest, prefix)

    -- Case-INSENSITIVELY, which is the rule that keeps a case-folding filesystem
    -- (APFS by default, and every FAT variant) from deciding identity: an id is
    -- minted in one canonical case and compared in none (§6.5).
    operation occupies(id: String, prefix: String) -> Bool =
      let a = toLower(id)
      let b = toLower(prefix)
      if eq(a, b) then true else startsWith(a, concat(b, "-"))

    -- Whether a stored row is THIS item — the idempotent-retry test above.
    operation is_same_item(t: Term, created: String, description: String) -> Bool =
      if eq(string_field_of(t, "created"), created) then
        eq(prose_field_of(t, "description"), description)
      else false

    -- A field that may be written either bare or wrapped, `"x"` or
    -- `some(value: "x")`. BOTH SPELLINGS REACH THE STORE and neither is a
    -- deviation: the field is declared `Option[T = String]`, the loader accepts a
    -- bare literal for it, and the printer emits the wrapped form — so a tracker
    -- holds both (measured: 344 bare against 766 wrapped before WI-1120's
    -- conversion). Comparing the wrapped form against a bare argument is how the
    -- idempotence check silently failed its first time out: every retry minted a
    -- fresh id because the occupant's description never matched.
    operation prose_field_of(t: Term, field: String) -> String =
      match term_field(t, field)
        case none() -> ""
        case some(v) ->
          match term_as_string(v)
            case some(str) -> str
            case none() -> unwrapped_string(v)

    operation unwrapped_string(v: Term) -> String =
      match term_field(v, "value")
        case none() -> ""
        case some(inner) ->
          match term_as_string(inner)
            case none() -> ""
            case some(str) -> str

    -- A term's string-valued field, or "" when the field is absent or holds
    -- something else. Total by design: every caller here is comparing, and a
    -- comparison against "" is a mismatch, which is the right answer for a row
    -- that does not carry the field.
    operation string_field_of(t: Term, field: String) -> String =
      match term_field(t, field)
        case none() -> ""
        case some(v) ->
          match term_as_string(v)
            case none() -> ""
            case some(str) -> str

    -- Materialize each in-KB WorkItem Term into a typed entity.
    -- Pre-filter on a string `id`: a malformed row without one is
    -- skipped. (WI-515: the synthetic entity-declaration fact this
    -- filter also used to exclude is no longer asserted.)
    --
    -- Read-only impl bodies route through `facts_of(kb(), WorkItem)`
    -- rather than `retrieve(backend, …)`: the eager drains
    -- (FiniteCollection.collect / Stream.head) are not yet wired to the
    -- LogicalStream Rust builtin (only splitFirst is), so a retrieve-based
    -- impl can't materialize the result. WI-189 follow-up swaps in a
    -- retrieve path once that drain is wired through the host stream.
    operation terms_to_workitems(ts: List[T = Term]) -> List[T = WorkItem] =
      match ts
        case nil() -> nil()
        case cons(t, rest) ->
          if has_string_id(t) then
            match term_as_entity(t)
              case some(w) -> cons(w, terms_to_workitems(rest))
              case none() -> terms_to_workitems(rest)
          else terms_to_workitems(rest)

    -- True when `t` carries a string-literal `id` field — the shape of
    -- a real WorkItem row. (WI-515: the loader's synthetic
    -- entity-declaration fact this used to reject is gone.)
    operation has_string_id(t: Term) -> Bool =
      match term_field(t, "id")
        case none() -> false
        case some(id_term) ->
          match term_as_string(id_term)
            case none() -> false
            case some(_) -> true

    -- Identify a WorkItem term by its `id` field. Returns the term whose
    -- id matches `target`, or none(). Used by lookup before materializing.
    operation find_term_by_id(ts: List[T = Term], target: String) -> Option[T = Term] =
      match ts
        case nil() -> none()
        case cons(t, rest) ->
          match term_field(t, "id")
            case none() -> find_term_by_id(rest, target)
            case some(id_term) ->
              match term_as_string(id_term)
                case none() -> find_term_by_id(rest, target)
                case some(id_str) ->
                  if eq(id_str, target) then some(t)
                  else find_term_by_id(rest, target)

    -- The reference-carrying counterpart for mutation. Identity comes from
    -- `stored_facts_of`, never a second content-to-handle lookup.
    operation find_stored_by_id(rows: List[T = StoredRef[T = Term]], target: String)
      -> Option[T = StoredRef[T = Term]] =
      match rows
        case nil() -> none()
        case cons(row, rest) ->
          match row
            case stored_ref(t, _) ->
              match term_field(t, "id")
                case none() -> find_stored_by_id(rest, target)
                case some(id_term) ->
                  match term_as_string(id_term)
                    case none() -> find_stored_by_id(rest, target)
                    case some(id_str) ->
                      if eq(id_str, target) then some(row)
                      else find_stored_by_id(rest, target)

    -- Identify the status functor short name of a WorkItem term; "" when
    -- the term lacks a recognizable status field.
    -- NOTE arm order: the `none` arm comes FIRST because a trailing `case`
    -- after a nested match attaches to the INNER match (dangling-case
    -- attachment) — written last, the outer match silently loses its `none`
    -- arm (caught by the WI-374 exhaustiveness coverage).
    operation status_short(t: Term) -> String =
      match term_field(t, "status")
        case none() -> ""
        case some(st_term) ->
          match term_functor_name(st_term)
            case some(n) -> n
            case none() -> ""

    operation filter_by_status(ts: List[T = Term], target: String) -> List[T = Term] =
      match ts
        case nil() -> nil()
        case cons(t, rest) ->
          if eq(status_short(t), target) then
            cons(t, filter_by_status(rest, target))
          else
            filter_by_status(rest, target)

    operation lookup(s: Cell[V = WIS], id: String) -> Option[T = WorkItem]
      effects Error
    =
      match Cell.get(s)
        case wis(_) ->
          match find_term_by_id(facts_of(kb(), WorkItem), id)
            case none() -> none()
            case some(t) -> term_as_entity(t)

    operation by_status_of(s: Cell[V = WIS], st: WorkStatus)
      -> List[T = WorkItem]
      effects Error
    =
      match Cell.get(s)
        case wis(_) ->
          match term_functor_name(st)
            case some(name) ->
              terms_to_workitems(
                filter_by_status(facts_of(kb(), WorkItem), name))
            case none() -> nil()

    operation all(s: Cell[V = WIS]) -> List[T = WorkItem]
      effects Error
    =
      match Cell.get(s)
        case wis(_) ->
          terms_to_workitems(facts_of(kb(), WorkItem))

    -- Buffering primitives. persist/retract stage into the backend's
    -- pending buffer; flush_backend writes them (per-file atomic
    -- temp+rename). The public ops compose these: commit / forget flush
    -- immediately, while `replace` buffers a retract+persist pair and
    -- flushes ONCE so an update lands as a single write.
    operation persist_buffer(s: Cell[V = WIS], fact: Term) -> Unit
      effects {Modify[s], Error}
    =
      match Cell.get(s)
        case wis(b) ->
          let _ = persist(b, fact, Meta(entries: as_term(nil())))
          ()

    -- Buffer a retract of one already-selected row through its owner-minted
    -- reference. The single point where this impl asks the backend to drop a
    -- row; every retract path (forget_buffer / forget_satellites_buffer /
    -- untag_item) goes through it, so none of them re-spells the destructuring.
    -- Does NOT flush.
    operation retract_row(s: Cell[V = WIS], row: StoredRef[T = Term]) -> Unit
      effects {Modify[s], Error}
    =
      match Cell.get(s)
        case wis(b) ->
          match row
            case stored_ref(_, reference) ->
              let _ = retract(b, reference)
              ()

    operation retract_rows(s: Cell[V = WIS], rows: List[T = StoredRef[T = Term]]) -> Unit
      effects {Modify[s], Error}
    =
      match rows
        case nil() -> ()
        case cons(row, rest) ->
          let _ = retract_row(s, row)
          retract_rows(s, rest)

    -- Buffer a retract of the WorkItem fact whose `id` field matches
    -- `target` through its owner-minted StoredRef. No-op if no
    -- such fact. Does NOT flush.
    operation forget_buffer(s: Cell[V = WIS], target: String) -> Unit
      effects {Modify[s], Error}
    =
      match find_stored_by_id(stored_facts_of(kb(), WorkItem), target)
        case none() -> ()
        case some(row) -> retract_row(s, row)

    -- Buffer a retract of every SATELLITE row describing `target` — the
    -- Feedback and Tag rows keyed `workitem: target` (WI-1123). Does NOT
    -- flush: forget buffers these together with the item's own row so one
    -- flush drops them all, which is what lets ItemPerFileStore remove the
    -- item's file instead of leaving it holding rows that name nothing.
    --
    -- The two functors are named one by one rather than swept generically:
    -- `stored_facts_of` is keyed by functor, and a satellite kind that is
    -- added later must be added HERE deliberately, not inherited silently by
    -- a scan that happens to see a `workitem` field.
    operation forget_satellites_buffer(s: Cell[V = WIS], target: String) -> Unit
      effects {Modify[s], Error}
    =
      let _ = retract_rows(s, stored_rows_naming(stored_facts_of(kb(), Feedback), target))
      let _ = retract_rows(s, stored_rows_naming(stored_facts_of(kb(), Tag), target))
      ()

    -- The stored rows whose `workitem` field is the string `target`.
    operation stored_rows_naming(rows: List[T = StoredRef[T = Term]], target: String)
      -> List[T = StoredRef[T = Term]]
    =
      match rows
        case nil() -> nil()
        case cons(row, rest) ->
          match row
            case stored_ref(t, _) ->
              if names_item(t, target) then cons(row, stored_rows_naming(rest, target))
              else stored_rows_naming(rest, target)

    -- True when `t` carries a string-literal `workitem` field equal to `id` —
    -- the shape of a satellite row keyed to that work item. A non-string slot
    -- yields none from term_as_string and fails the test.
    operation names_item(t: Term, id: String) -> Bool =
      match term_field(t, "workitem")
        case none() -> false
        case some(wt) ->
          match term_as_string(wt)
            case none() -> false
            case some(w) -> eq(w, id)

    operation flush_backend(s: Cell[V = WIS]) -> Unit
      effects {Modify[s], Error}
    =
      match Cell.get(s)
        case wis(b) ->
          let _ = flush(b, nil())
          ()

    -- Persist `fact` and flush. The typed-surface entry points (commit /
    -- commit_feedback) split only to preserve the WorkItem-vs-Feedback
    -- type distinction at the spec; the impl body is one shape. There is no id
    -- state for this to maintain (WI-1121): `mint_id` derives an id and writes
    -- nothing, and the update path reuses the existing id via `replace`.
    operation persist_through(s: Cell[V = WIS], fact: Term) -> Unit
      effects {Modify[s], Error}
    =
      let _ = persist_buffer(s, fact)
      let _ = flush_backend(s)
      ()

    operation commit(s: Cell[V = WIS], w: WorkItem) -> Unit
      effects {Modify[s], Error}
    =
      persist_through(s, as_term(w))

    operation commit_feedback(s: Cell[V = WIS], fb: Feedback) -> Unit
      effects {Modify[s], Error}
    =
      persist_through(s, as_term(fb))

    -- Retract the WorkItem fact whose `id` matches `target` TOGETHER WITH its
    -- satellite rows, then flush once — the backend drops every on-disk block
    -- atomically with the in-memory rules.
    --
    -- ONE FLUSH, and it is load-bearing under ItemPerFileStore: the item's file
    -- holds its satellites too, so retracting the item alone would leave that
    -- file standing with rows naming an item that no longer exists (an
    -- OrphanRow at every later startup). Buffered together, the file runs out
    -- of rows and is removed. Under IndexedFileStore the same buffering just
    -- drops the blocks; the difference does not reach this body.
    operation forget(s: Cell[V = WIS], target: String) -> Unit
      effects {Modify[s], Error}
    =
      let _ = forget_satellites_buffer(s, target)
      let _ = forget_buffer(s, target)
      let _ = flush_backend(s)
      ()

    -- Select the owner-minted reference, then use the single update boundary.
    -- The backend stages/replaces the old block atomically; this body never
    -- spells a retract-plus-persist sequence.
    operation replace(s: Cell[V = WIS], target: String, new_wi: WorkItem) -> Unit
      effects {Modify[s], Error}
    =
      match Cell.get(s)
        case wis(b) ->
          match find_stored_by_id(stored_facts_of(kb(), WorkItem), target)
            case none() -> ()
            case some(row) ->
              match row
                case stored_ref(_, reference) ->
                  let _ = update(b, reference, as_term(new_wi))
                  let _ = flush(b, nil())
                  ()

    -- True when `t` is a Tag fact term carrying workitem == id AND
    -- name == name (both string-literal fields); non-string slots
    -- yield none from term_as_string and fail the match.
    operation tag_term_matches(t: Term, id: String, name: String) -> Bool =
      if names_item(t, id) then
        match term_field(t, "name")
          case none() -> false
          case some(nt) ->
            match term_as_string(nt)
              case none() -> false
              case some(n) -> eq(n, name)
      else false

    operation find_tag_term(ts: List[T = Term], id: String, name: String)
      -> Option[T = Term]
    =
      match ts
        case nil() -> none()
        case cons(t, rest) ->
          if tag_term_matches(t, id, name) then some(t)
          else find_tag_term(rest, id, name)

    operation find_stored_tag(rows: List[T = StoredRef[T = Term]], id: String, name: String)
      -> Option[T = StoredRef[T = Term]]
    =
      match rows
        case nil() -> none()
        case cons(row, rest) ->
          match row
            case stored_ref(t, _) ->
              if tag_term_matches(t, id, name) then some(row)
              else find_stored_tag(rest, id, name)

    operation has_tag(s: Cell[V = WIS], id: String, name: String) -> Bool
      effects Error
    =
      match Cell.get(s)
        case wis(_) ->
          match find_tag_term(facts_of(kb(), Tag), id, name)
            case none() -> false
            case some(_) -> true

    -- The workitem id of a Tag fact whose name matches; none() for a
    -- non-matching or malformed term (non-string field slots).
    operation tagged_id_of(t: Term, name: String) -> Option[T = String] =
      match term_field(t, "name")
        case none() -> none()
        case some(nt) ->
          match term_as_string(nt)
            case none() -> none()
            case some(n) ->
              if eq(n, name) then
                match term_field(t, "workitem")
                  case none() -> none()
                  case some(wt) -> term_as_string(wt)
              else none()

    operation collect_tagged(ts: List[T = Term], name: String) -> List[T = String] =
      match ts
        case nil() -> nil()
        case cons(t, rest) ->
          match tagged_id_of(t, name)
            case some(id) -> cons(id, collect_tagged(rest, name))
            case none() -> collect_tagged(rest, name)

    operation items_with_tag(s: Cell[V = WIS], name: String) -> List[T = String]
      effects Error
    =
      match Cell.get(s)
        case wis(_) -> collect_tagged(facts_of(kb(), Tag), name)

    -- The mirror of tagged_id_of: the tag NAME when the fact's workitem
    -- matches `id`.
    operation tag_name_of(t: Term, id: String) -> Option[T = String] =
      match term_field(t, "workitem")
        case none() -> none()
        case some(wt) ->
          match term_as_string(wt)
            case none() -> none()
            case some(w) ->
              if eq(w, id) then
                match term_field(t, "name")
                  case none() -> none()
                  case some(nt) -> term_as_string(nt)
              else none()

    operation collect_item_tags(ts: List[T = Term], id: String) -> List[T = String] =
      match ts
        case nil() -> nil()
        case cons(t, rest) ->
          match tag_name_of(t, id)
            case some(n) -> cons(n, collect_item_tags(rest, id))
            case none() -> collect_item_tags(rest, id)

    operation tags_of(s: Cell[V = WIS], id: String) -> List[T = String]
      effects Error
    =
      match Cell.get(s)
        case wis(_) -> collect_item_tags(facts_of(kb(), Tag), id)

    operation raw_term_of(s: Cell[V = WIS], id: String) -> Option[T = Term]
      effects Error
    =
      match Cell.get(s)
        case wis(_) -> find_term_by_id(facts_of(kb(), WorkItem), id)

    operation tag_item(s: Cell[V = WIS], id: String, name: String) -> Unit
      effects {Modify[s], Error}
    =
      persist_through(s, as_term(Tag(workitem: id, name: name)))

    operation stamp_format(s: Cell[V = WIS], version: Int64) -> Unit
      effects {Modify[s], Error}
    =
      persist_through(s, as_term(StoreFormat(version: version)))

    -- Retract the Tag fact matching (id, name), then flush. The cmd
    -- layer guards existence via has_tag, so a missing fact is a silent
    -- no-op here (the same contract as forget_buffer).
    operation untag_item(s: Cell[V = WIS], id: String, name: String) -> Unit
      effects {Modify[s], Error}
    =
      match find_stored_tag(stored_facts_of(kb(), Tag), id, name)
        case none() -> ()
        case some(row) ->
          let _ = retract_row(s, row)
          let _ = flush_backend(s)
          ()
  end
end
