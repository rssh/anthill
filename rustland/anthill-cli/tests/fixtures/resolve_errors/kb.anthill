namespace cli.mix
  import anthill.prelude.{Int64, String, Bool, PartialOrd}
  import anthill.kernel.{unify}

  -- A clause reading `tag` beside `gt(?x, 1)` is refused at load: the typer reads
  -- `tag`'s column as `String`. A goal the query builds is not typed at load, so
  -- `gt(?x, 1)` reaches the resolver there as a String/Int64 pair.
  fact tag("a")

  fact num(7)
  rule ok(?r) :- num(?x), PartialOrd.gt(?x, 1), unify(?r, 5)
end
