-- WI-744 fixture (see run_cmd_test.rs `advisory_warnings_print_but_do_not_block`):
-- the OTHER half of "every LoadError blocks" — a genuine advisory still prints
-- and still runs. `Shadower.ping` shadows the `Pingable.ping` it requires, which
-- is the WI-346 `LoadWarning::RequiresShadow` advisory: legal but suspicious.
--
-- This fixture triggers its OWN advisory rather than leaning on the stdlib's
-- (FiniteCollection.map/filter used to shadow Iterable's on every load) — and
-- that was the right call: WI-1048 removed those, the stdlib now loads
-- warning-free, and a test anchored on them would have gone with them.
--
-- The shadow here is the genuine article WI-346 exists for: `requires Pingable`
-- binds nothing, so `Pingable.ping`'s `x: T` / `-> T` stay UNBOUND parameters.
-- An unbound parameter is an unknown type, not a different one, so nothing
-- distinguishes it from `Shadower.ping(x: Int64) -> Int64` at a call site — do
-- not "fix" this fixture by binding T or by changing ping's signature, which
-- would make the two distinguishable and silence the advisory this test needs.
namespace my.advisory
  import anthill.cli.Main
  import anthill.prelude.Console.{console, println, ConsoleOutput}
  import anthill.prelude.{Int64, String, List}

  sort Pingable
    sort T = ?
    operation ping(x: T) -> T
  end

  sort Shadower
    requires Pingable
    operation ping(x: Int64) -> Int64 = x
  end

  sort Hello
    requires anthill.cli.Main
    operation main(args: List[T = String]) -> Int64
      effects ConsoleOutput
    =
      let _ = println(console(), "advisory-fixture-ran")
      0
  end
end
